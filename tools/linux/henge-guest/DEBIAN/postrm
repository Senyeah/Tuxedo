#!/bin/sh
set -e

UNITS="henge-firstboot.service henge-grow.service home-henge-Henge.automount"

if [ "$1" = remove ]; then
    for u in $UNITS; do deb-systemd-helper mask "$u" >/dev/null || true; done
fi
if [ "$1" = purge ]; then
    for u in $UNITS; do
        deb-systemd-helper purge "$u" >/dev/null || true
        deb-systemd-helper unmask "$u" >/dev/null || true
    done
fi
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
