#!/bin/sh
set -e

UNITS="henge-firstboot.service henge-grow.service home-henge-Henge.automount henge-status.service henge-secrets-firewall.service"

if [ "$1" = remove ]; then
    for u in $UNITS; do deb-systemd-helper mask "$u" >/dev/null || true; done
fi
if [ "$1" = purge ]; then
    rm -f /var/lib/henge/secrets-removed /etc/apt/sources.list.d/henge.sources
    for u in $UNITS; do
        deb-systemd-helper purge "$u" >/dev/null || true
        deb-systemd-helper unmask "$u" >/dev/null || true
    done
fi
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = abort-upgrade ]; then
    for n in org.freedesktop.secrets org.kde.kwalletd6 org.kde.kwalletd5; do
        dpkg-divert --package henge-guest --rename --divert "/usr/share/dbus-1/services/$n.service.henge" \
            --remove "/usr/share/dbus-1/services/$n.service" >/dev/null || true
    done
fi
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
