#!/bin/sh
set -e

if [ "$1" = remove ]; then
    systemctl --global disable henge-secrets.service >/dev/null 2>&1 || true
fi
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop henge-status.service home-henge-Henge.automount home-henge-Henge.mount henge-grow.service henge-firstboot.service >/dev/null || true
fi
