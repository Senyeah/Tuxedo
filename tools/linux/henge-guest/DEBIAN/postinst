#!/bin/sh
set -e

UNITS="henge-firstboot.service henge-grow.service home-henge-Henge.automount henge-status.service henge-secrets-firewall.service henge-files.service"

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
        for u in $UNITS; do
            deb-systemd-helper unmask "$u" >/dev/null || true
            # A new install enables the unit; an upgrade keeps what the admin chose
            if deb-systemd-helper --quiet was-enabled "$u"; then
                deb-systemd-helper enable "$u" >/dev/null || true
            else
                deb-systemd-helper update-state "$u" >/dev/null || true
            fi
        done
        # The wallet starts with each user's session. Enabled on a first install, on an upgrade from before it,
        # and after a remove (prerm leaves a mark); an admin's disable stays over an upgrade.
        if [ "$1" = configure ] && { [ -z "$2" ] || dpkg --compare-versions "$2" lt 1.6.0 || [ -e /var/lib/henge/secrets-removed ]; }; then
            systemctl --global enable henge-secrets.service >/dev/null 2>&1 || true
        fi
        rm -f /var/lib/henge/secrets-removed
        # The Places entry for /media/henge, on a first install or an upgrade from before the folders
        if [ "$1" = configure ] && { [ -z "$2" ] || dpkg --compare-versions "$2" lt 1.7.0; }; then
            systemctl --global enable henge-files-places.service >/dev/null 2>&1 || true
        fi
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/henge-files.conf >/dev/null 2>&1 || true
        # Not a conffile: the admin owns it after this, so a later default never replaces an edit or asks about it.
        # A version before 1.9.0 had no source; 1.9.0 shipped it as a conffile, which dpkg leaves in place.
        SRC=/etc/apt/sources.list.d/henge.sources
        if [ "$1" = configure ] && { [ -z "$2" ] || dpkg --compare-versions "$2" lt 1.9.0; } &&
            [ ! -e "$SRC" ] && [ ! -L "$SRC" ]; then
            install -m 0644 /usr/share/henge/henge.sources "$SRC"
        fi
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
            # No gap: a stop keeps the rule, and the start replaces it in one transaction
            deb-systemd-invoke restart henge-secrets-firewall.service >/dev/null || true
            # The mounts stay over a restart: the new helper takes them over
            deb-systemd-invoke restart henge-files.service >/dev/null || true
        fi
        ;;
esac
