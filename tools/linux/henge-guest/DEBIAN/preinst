#!/bin/sh
set -e

# henge-secrets answers for these names: gnome-keyring's and kwallet6's own files move aside.
if [ "$1" = install ] || [ "$1" = upgrade ]; then
    for n in org.freedesktop.secrets org.kde.kwalletd6 org.kde.kwalletd5; do
        dpkg-divert --package henge-guest --rename --divert "/usr/share/dbus-1/services/$n.service.henge" \
            --add "/usr/share/dbus-1/services/$n.service" >/dev/null
    done
fi
