#!/usr/bin/python3
"""Keeps the guest clipboard in step with the device (host/share.c, /.henge/clipboard).
GET waits up to 25 s for news, PUT sends the guest's."""
import base64
import http.client
import os
import subprocess
import sys
import threading
import time

HOST = "10.0.2.4"
SECRET = "x-kde-passwordManagerHint"  # set by password managers
MAX = 16 * 1024 * 1024 - 1  # the server's limit for a clipboard

lock = threading.Lock()
last = None  # what was last set here or sent: not news in either direction
mode = None


def log(*a):
    print(*a, file=sys.stderr, flush=True)


def request(method, path, body=None):
    c = http.client.HTTPConnection(HOST, 80, timeout=40)
    try:
        c.request(method, path, body)
        r = c.getresponse()
        return r.status, r.read(), int(r.getheader("X-Henge-Seq") or 0)
    finally:
        c.close()


def run(cmd, data=None):
    # Not capture_output: wl-copy and xclip leave a child holding the pipes to serve the selection
    return subprocess.run(cmd, input=data, stdout=subprocess.PIPE if data is None else subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, timeout=10)


def set_local(text):
    global last
    with lock:
        last = text  # before the tool runs, so the change it causes is not sent back
        data = text.encode()
        if mode == "wayland":
            run(["wl-copy", "--type", "text/plain;charset=utf-8"], data)
        else:
            run(["xclip", "-selection", "clipboard", "-in"], data)


def is_secret():
    if mode != "wayland":
        return False
    return SECRET in run(["wl-paste", "--list-types"]).stdout.decode(errors="replace").split()


def send(data):
    global last
    if not data or len(data) > MAX:
        return
    try:
        text = data.decode()
    except UnicodeDecodeError:
        return
    with lock:
        if text == last:
            return
        last = text
    if is_secret():
        return
    try:
        request("PUT", "/.henge/clipboard", data)
    except (OSError, http.client.HTTPException) as e:
        log("send:", e)


def follow_device():
    seq, first = 0, True
    while True:
        t = time.monotonic()
        try:
            status, body, now = request("GET", f"/.henge/clipboard?since={seq}")
        except (OSError, http.client.HTTPException):
            time.sleep(5)
            continue
        seq = now
        # What the device held before this started comes back at once: it is not news
        stale = first and time.monotonic() - t < 1
        first = False
        if status == 200 and body and not stale:
            try:
                set_local(body.decode())
            except (OSError, subprocess.SubprocessError) as e:
                log("set:", e)


def follow_wayland():
    # One base64 line per change, so the text survives newlines and the pipe framing
    cmd = ["wl-paste", "--type", "text", "--watch", "sh", "-c", "base64 -w0; echo"]
    while True:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        for line in p.stdout:
            try:
                send(base64.b64decode(line.strip()))
            except ValueError:
                pass
        p.wait()
        time.sleep(2)


def follow_x11():
    global last
    # X has no change event without more tools, so look once a second, as the macOS helper does
    first = True
    while True:
        try:
            out = run(["xclip", "-selection", "clipboard", "-out"]).stdout
        except (OSError, subprocess.SubprocessError):
            out = b""
        if first:
            first = False
            try:
                last = out.decode()
            except UnicodeDecodeError:
                pass
        else:
            send(out)
        time.sleep(1)


def main():
    global mode
    mode = os.environ.get("HENGE_CLIPBOARD") or ("wayland" if os.environ.get("WAYLAND_DISPLAY") else "x11" if os.environ.get("DISPLAY") else "")
    tool = {"wayland": "wl-copy", "x11": "xclip"}.get(mode)
    if not tool or not any(os.access(os.path.join(d, tool), os.X_OK) for d in os.environ.get("PATH", "").split(":")):
        log(f"henge-clipboard: no display or no {tool or 'tool'}; nothing to do")
        return 0  # exit 0: systemd does not restart it
    threading.Thread(target=follow_wayland if mode == "wayland" else follow_x11, daemon=True).start()
    follow_device()


if __name__ == "__main__":
    sys.exit(main())
