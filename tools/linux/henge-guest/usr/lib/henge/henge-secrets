#!/usr/bin/python3
"""The wallet of a Henge Linux machine: it keeps every secret in the device's Keychain, through the share server
(host/secrets.c, /.henge/secrets). It owns two D-Bus names on the session bus:

- org.freedesktop.secrets, the freedesktop Secret Service: libsecret (secret-tool, GNOME and GTK programs,
  Chromium and Electron with the libsecret store), QtKeychain programs, and kwalletd from KDE Frameworks 6.14.
- org.kde.kwalletd6 and org.kde.kwalletd5, the KWallet API (KDE programs, plasma-nm, Chromium on KDE). It keeps
  KWallet entries as Secret Service items, as kwalletd from KDE Frameworks 6.14 does (attributes server, user, type;
  maps as JSON), so the same items show through both.

The device decides "locked": until the person passes Face ID for the session, and while the app is in the
background. While locked, labels and attributes show, and secrets do not. This program keeps no secret on disk
and logs no secret, label or attribute.

Without the host's wallet (an older app, or no share server) it does not take the names: with --activated it runs
kwalletd6 in its place, if installed."""
import base64
import hashlib
import hmac
import http.client
import json
import os
import re
import secrets as rng
import struct
import sys
import threading
import time
from collections import deque

from jeepney import DBusAddress, HeaderFields, MatchRule, MessageFlag, MessageType, new_error, new_method_return, new_signal
from jeepney.bus_messages import message_bus
from jeepney.io.blocking import open_dbus_connection

try:
    from cryptography.hazmat.primitives import padding as _padding
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
except ImportError:  # only the plain session then; libsecret falls back to it
    Cipher = None

HOST = os.environ.get("HENGE_SECRETS_HOST", "10.0.2.4")
PORT = int(os.environ.get("HENGE_SECRETS_PORT", "80"))
BASE = "/org/freedesktop/secrets"
SS = "org.freedesktop.Secret"
KW = "org.kde.KWallet"
KW_PATHS = ("/modules/kwalletd6", "/modules/kwalletd5")
DH = "dh-ietf1024-sha256-aes128-cbc-pkcs7"
PRIME = int(
    "FFFFFFFFFFFFFFFFC90FDAA22168C234C4C6628B80DC1CD129024E088A67CC74020BBEA63B139B22514A08798E3404DD"
    "EF9519B3CD3A431B302B0A6DF25F14374FE1356D6D51C245E485B576625E7EC6F44C42E9A637ED6B0BFF5CB6F406B7ED"
    "EE386BFB5A899FA5AE9F24117C4B1FE649286651ECE65381FFFFFFFFFFFFFFFF", 16)
DEFAULT = "login"
# Served on any path: a second kwalletd6 calls the first through KDBusService.
ANY_PATH = {"org.freedesktop.Application", "org.kde.KDBusService", "org.freedesktop.DBus.Introspectable", "org.freedesktop.DBus.Peer"}
WAIT = 120  # seconds a prompt or an async open waits for the device to unlock


def log(*a):
    print(*a, file=sys.stderr, flush=True)


class Locked(Exception):
    pass


class Missing(Exception):
    pass


class HostError(Exception):
    pass


# ---- the host ----

class Host:
    def request(self, method, path, body=None, timeout=10):
        c = http.client.HTTPConnection(HOST, PORT, timeout=timeout)
        try:
            c.request(method, "/.henge/secrets" + path, body=body)
            r = c.getresponse()
            return r.status, r, r.read()
        except OSError as e:
            raise HostError(str(e)) from None
        finally:
            c.close()

    def check(self, status):
        if status == 423:
            raise Locked()
        if status == 404:
            raise Missing()
        if status >= 300:
            raise HostError(f"status {status}")

    def state(self, since=None, timeout=10):
        """(locked, seq); raises Missing when the host has no wallet for this machine."""
        status, r, body = self.request("GET", "/state" + (f"?since={since}" if since else ""), timeout=timeout)
        self.check(status)
        return body.strip() != b"unlocked", int(r.getheader("X-Henge-Seq") or 0)

    def items(self):
        status, _, body = self.request("GET", "/items")
        self.check(status)
        out = {}
        for line in body.decode().splitlines():
            iid, _, meta = line.partition(" ")
            try:
                out[iid] = json.loads(base64.b64decode(meta) or b"{}")
            except ValueError:
                log("an item with unreadable metadata is skipped")
        return out

    def read(self, iid):
        status, _, body = self.request("GET", "/items/" + iid)
        self.check(status)
        return body

    def write(self, iid, meta, secret):
        status, _, _ = self.request("PUT", "/items/" + iid, base64.b64encode(json.dumps(meta).encode()) + b"\n" + secret)
        if status == 413:
            raise HostError("too large")
        if status == 507:
            raise HostError("too many items")
        self.check(status)

    def delete(self, iid):
        status, _, _ = self.request("DELETE", "/items/" + iid)
        if status != 404:
            self.check(status)


# ---- the model ----

def now():
    return int(time.time())


def path_part(text):
    """A D-Bus path element from a label."""
    s = re.sub(r"[^a-z0-9_]", "_", text.lower())[:20].strip("_")
    return s or "wallet"


class Item:
    def __init__(self, coll, hid, meta):
        self.coll, self.hid = coll, hid
        self.label = str(meta.get("label", ""))
        self.attributes = {str(k): str(v) for k, v in dict(meta.get("attributes", {})).items()}
        self.content_type = str(meta.get("content_type", "text/plain"))
        self.created = int(meta.get("created", now()))
        self.modified = int(meta.get("modified", self.created))
        self.secret = None  # the session collection only

    @property
    def iid(self):
        return f"i.{self.coll.name}.{self.hid}"

    @property
    def path(self):
        return f"{self.coll.path}/{self.hid}"

    def meta(self):
        return {"label": self.label, "attributes": self.attributes, "content_type": self.content_type,
                "created": self.created, "modified": self.modified}


class Collection:
    def __init__(self, name, label, persistent=True, aliases=(), created=None):
        self.name, self.label, self.persistent = name, label, persistent
        self.aliases = set(aliases)
        self.created = created or now()
        self.modified = self.created
        self.items = {}

    @property
    def path(self):
        return f"{BASE}/collection/{self.name}"

    def meta(self):
        return {"label": self.label, "aliases": sorted(self.aliases), "created": self.created, "modified": self.modified}


class Wallet:
    """The items, from the host's metadata. Secrets stay on the host (the session collection's in memory)."""

    def __init__(self, host):
        self.host = host
        self.locked = True
        self.collections = {}
        self.reset()

    def reset(self):
        self.collections = {DEFAULT: Collection(DEFAULT, "Login", aliases={"default"}),
                            "session": Collection("session", "Session", persistent=False, aliases={"session"})}

    def load(self):
        listing = self.host.items()
        old_session = self.collections.get("session")
        self.reset()
        if old_session:
            self.collections["session"] = old_session
        for iid, meta in sorted(listing.items()):
            kind, _, rest = iid.partition(".")
            if kind == "c" and re.fullmatch(r"[a-z0-9_]{1,20}", rest):
                c = self.collections.get(rest) or Collection(rest, rest)
                c.label = str(meta.get("label", c.label))
                c.aliases = set(meta.get("aliases", c.aliases))
                c.created = int(meta.get("created", c.created))
                c.modified = int(meta.get("modified", c.created))
                self.collections[rest] = c
        for iid, meta in listing.items():
            m = re.fullmatch(r"i\.([a-z0-9_]{1,20})\.([0-9a-f]{32})", iid)
            if not m:
                continue
            c = self.collections.get(m[1])
            if c is None:
                c = self.collections[m[1]] = Collection(m[1], m[1])
            c.items[m[2]] = Item(c, m[2], meta)
        for c in self.collections.values():  # one owner for each alias
            for a in list(c.aliases):
                if any(a in o.aliases for o in self.collections.values() if o is not c and o.name < c.name):
                    c.aliases.discard(a)
        log(f"loaded {sum(len(c.items) for c in self.collections.values())} items")

    def alias(self, name):
        for c in self.collections.values():
            if name in c.aliases:
                return c
        return None

    def collection_for(self, path):
        if path.startswith(BASE + "/aliases/"):
            return self.alias(path[len(BASE) + 9:].split("/")[0])
        if path.startswith(BASE + "/collection/"):
            return self.collections.get(path[len(BASE) + 12:].split("/")[0])
        return None

    def item_for(self, path):
        c = self.collection_for(path)
        rest = path.split("/")
        if c is None or len(rest) != 7:
            return None
        return c.items.get(rest[6])

    def save_collection(self, c):
        c.modified = now()
        if c.persistent:
            self.host.write("c." + c.name, c.meta(), b"")

    def create_collection(self, label, alias=""):
        name = base = path_part(label)
        n = 1
        while name in self.collections:
            n += 1
            name = f"{base[:17]}_{n}"
        c = Collection(name, label)
        if alias:
            self.take_alias(alias, c)
        self.save_collection(c)
        self.collections[name] = c
        return c

    def take_alias(self, alias, c):
        for o in self.collections.values():
            if o is not c and alias in o.aliases:
                o.aliases.discard(alias)
                self.save_collection(o)
        if c is not None:
            c.aliases.add(alias)

    def delete_collection(self, c):
        for it in list(c.items.values()):
            self.delete_item(it)
        if c.persistent:
            self.host.delete("c." + c.name)
        del self.collections[c.name]

    def search(self, attrs, colls=None):
        for c in colls or list(self.collections.values()):
            for it in c.items.values():
                if all(it.attributes.get(k) == v for k, v in attrs.items()):
                    yield it

    def secret(self, it):
        if self.locked:
            raise Locked()
        if not it.coll.persistent:
            return it.secret or b""
        return self.host.read(it.iid)

    def store(self, it, secret):
        """Writes the item with its secret; new or changed."""
        if self.locked:
            raise Locked()
        it.modified = now()
        if it.coll.persistent:
            self.host.write(it.iid, it.meta(), secret)
        else:
            it.secret = secret
        it.coll.items[it.hid] = it

    def new_item(self, c, label, attrs, content_type, secret):
        it = Item(c, rng.token_hex(16), {"label": label, "attributes": attrs, "content_type": content_type})
        self.store(it, secret)
        return it

    def delete_item(self, it):
        if self.locked:
            raise Locked()
        if it.coll.persistent:
            self.host.delete(it.iid)
        it.coll.items.pop(it.hid, None)


# ---- sessions: plain, or Diffie-Hellman with AES (the spec's dh-ietf1024-sha256-aes128-cbc-pkcs7) ----

def hkdf_sha256(key_material, length):
    prk = hmac.new(b"\0" * 32, key_material, hashlib.sha256).digest()
    return hmac.new(prk, b"\x01", hashlib.sha256).digest()[:length]


class Session:
    def __init__(self, path, sender, key=None):
        self.path, self.sender, self.key = path, sender, key

    def encode(self, value, content_type):
        if self.key is None:
            return (self.path, b"", value, content_type)
        iv = os.urandom(16)
        p = _padding.PKCS7(128).padder()
        enc = Cipher(algorithms.AES(self.key), modes.CBC(iv)).encryptor()
        return (self.path, iv, enc.update(p.update(value) + p.finalize()) + enc.finalize(), content_type)

    def decode(self, params, value):
        if self.key is None:
            return bytes(value)
        dec = Cipher(algorithms.AES(self.key), modes.CBC(bytes(params))).decryptor()
        u = _padding.PKCS7(128).unpadder()
        return u.update(dec.update(bytes(value)) + dec.finalize()) + u.finalize()


def dh_session(peer):
    priv = int.from_bytes(os.urandom(128), "big") % (PRIME - 2) + 1
    pub = pow(2, priv, PRIME).to_bytes(128, "big")
    y = int.from_bytes(bytes(peer), "big")
    if not 1 < y < PRIME - 1:
        raise ValueError("bad public key")
    shared = pow(y, priv, PRIME).to_bytes(128, "big")
    return pub, hkdf_sha256(shared, 16)


# ---- KWallet's map entries: a QDataStream QMap<QString, QString> ----

def qmap_decode(data):
    data = bytes(data)
    (n,), at, out = struct.unpack_from(">I", data, 0), 4, {}

    def qstring():
        nonlocal at
        (size,) = struct.unpack_from(">I", data, at)
        at += 4
        if size == 0xFFFFFFFF:
            return ""
        s = data[at:at + size].decode("utf-16-be")
        at += size
        return s

    for _ in range(n):
        k = qstring()
        out[k] = qstring()
    return out


def qmap_encode(m):
    out = [struct.pack(">I", len(m))]
    for k in sorted(m):
        for s in (k, m[k]):
            b = str(s).encode("utf-16-be")
            out.append(struct.pack(">I", len(b)) + b)
    return b"".join(out)


# ---- D-Bus ----

class Reply(Exception):
    """A D-Bus error reply."""

    def __init__(self, name, text=""):
        super().__init__(text)
        self.name, self.text = name, text


NO_SESSION = Reply(SS + ".Error.NoSession", "No such session")
NO_OBJECT = Reply(SS + ".Error.NoSuchObject", "No such object")
IS_LOCKED = Reply(SS + ".Error.IsLocked", "The wallet is locked: unlock the machine on the device")


def failed(e):
    return Reply("org.freedesktop.DBus.Error.Failed", f"the device's wallet: {e}")


class Server:
    def __init__(self, conn, host):
        self.conn = conn
        self.wallet = Wallet(host)
        self.lock = threading.RLock()
        self.sessions = {}
        self.prompts = {}
        self.serial = 0
        self.handles = {}  # KWallet: (handle, appid) -> collection name
        self.folders = {}  # KWallet: collection name -> folders made with createFolder
        self.kw_tid = 0
        self.methods = self.table()

    def send(self, msg):
        with self.lock:
            self.conn.send(msg)

    def signal(self, path, iface, name, sig="", body=()):
        self.send(new_signal(DBusAddress(path, interface=iface), name, sig, body))

    def next_path(self, kind):
        self.serial += 1
        return f"{BASE}/{kind}/s{self.serial}"

    # -- the lock --

    def set_locked(self, locked):
        with self.lock:
            if locked == self.wallet.locked:
                return
            self.wallet.locked = locked
            if not locked:
                try:
                    self.wallet.load()
                except (HostError, Locked, Missing) as e:
                    log(f"reload failed: {e}")
            log("locked" if locked else "unlocked")
            for c in list(self.wallet.collections.values()):
                self.signal(c.path, "org.freedesktop.DBus.Properties", "PropertiesChanged", "sa{sv}as",
                            (SS + ".Collection", {"Locked": ("b", locked)}, []))
                self.signal(BASE, SS + ".Service", "CollectionChanged", "o", (c.path,))

    def wait_unlocked(self, seconds):
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            if not self.wallet.locked:
                return True
            time.sleep(0.2)
        return not self.wallet.locked

    # -- Secret Service: helpers --

    def session(self, path):
        s = self.sessions.get(path)
        if s is None:
            raise NO_SESSION
        return s

    def collection(self, path):
        c = self.wallet.collection_for(path)
        if c is None:
            raise NO_OBJECT
        return c

    def item(self, path):
        it = self.wallet.item_for(path)
        if it is None:
            raise NO_OBJECT
        return it

    def guard(self, fn, *a):
        try:
            return fn(*a)
        except Locked:
            raise IS_LOCKED from None
        except Missing:
            raise NO_OBJECT from None
        except HostError as e:
            raise failed(e) from None

    def prompt(self, then):
        """A prompt that completes when the device unlocks (then() gives its result), or is dismissed."""
        path = self.next_path("prompt")
        self.prompts[path] = then
        return path

    def run_prompt(self, path, dismiss=False):
        then = self.prompts.pop(path, None)
        if then is None:
            raise NO_OBJECT

        def work():
            ok = not dismiss and self.wait_unlocked(WAIT)
            with self.lock:
                result = then() if ok else ("ao", [])
                self.signal(path, SS + ".Prompt", "Completed", "bv", (not ok, result))

        threading.Thread(target=work, daemon=True).start()

    # -- Secret Service: the service --

    def open_session(self, msg, algorithm, inp):
        path = self.next_path("session")
        sender = msg.header.fields.get(HeaderFields.sender, "")
        if algorithm == "plain":
            self.sessions[path] = Session(path, sender)
            out = ("s", "")
        elif algorithm == DH and Cipher is not None:
            try:
                pub, key = dh_session(inp[1])
            except (ValueError, TypeError, IndexError):
                raise Reply("org.freedesktop.DBus.Error.InvalidArgs", "bad public key") from None
            self.sessions[path] = Session(path, sender, key)
            out = ("ay", pub)
        else:
            raise Reply("org.freedesktop.DBus.Error.NotSupported", "Algorithm not supported")
        while len(self.sessions) > 256:
            self.sessions.pop(next(iter(self.sessions)))
        return (out, path)

    def create_collection(self, props, alias):
        if alias and (c := self.wallet.alias(alias)):
            return (c.path, "/")
        label = props.get(SS + ".Collection.Label", ("s", alias or "Wallet"))[1]
        c = self.guard(self.wallet.create_collection, str(label), alias)
        self.signal(BASE, SS + ".Service", "CollectionCreated", "o", (c.path,))
        return (c.path, "/")

    def search_all(self, attrs):
        found = [it.path for it in self.wallet.search(attrs)]
        return ([], found) if self.wallet.locked else (found, [])

    def unlock(self, objects):
        if not self.wallet.locked:
            return (list(objects), "/")
        return ([], self.prompt(lambda: ("ao", list(objects))))

    def get_secrets(self, items, session):
        s = self.session(session)
        out = {}
        for p in items:
            it = self.wallet.item_for(p)
            if it is None or self.wallet.locked:
                continue
            out[p] = s.encode(self.guard(self.wallet.secret, it), it.content_type)
        return (out,)

    def read_alias(self, name):
        c = self.wallet.alias(name)
        return (c.path if c else "/",)

    def set_alias(self, name, path):
        c = None if path == "/" else self.collection(path)
        self.guard(self.wallet.take_alias, name, c)
        if c is not None:
            self.guard(self.wallet.save_collection, c)
        return ()

    # -- Secret Service: collections and items --

    def collection_delete(self, path):
        c = self.collection(path)
        self.guard(self.wallet.delete_collection, c)
        self.signal(BASE, SS + ".Service", "CollectionDeleted", "o", (c.path,))
        return ("/",)

    def collection_search(self, path, attrs):
        return ([it.path for it in self.wallet.search(attrs, [self.collection(path)])],)

    def create_item(self, path, props, secret, replace):
        c = self.collection(path)
        if self.wallet.locked:
            raise IS_LOCKED
        session, params, value, content_type = secret
        value = self.session(session).decode(params, value)
        label = str(props.get(SS + ".Item.Label", ("s", ""))[1])
        attrs = {str(k): str(v) for k, v in props.get(SS + ".Item.Attributes", ("a{ss}", {}))[1].items()}
        old = next((i for i in c.items.values() if i.attributes == attrs), None) if replace else None
        if old is not None:
            old.label, old.content_type = label, content_type
            self.guard(self.wallet.store, old, value)
            self.signal(c.path, SS + ".Collection", "ItemChanged", "o", (old.path,))
            return (old.path, "/")
        it = self.guard(self.wallet.new_item, c, label, attrs, content_type, value)
        self.signal(c.path, SS + ".Collection", "ItemCreated", "o", (it.path,))
        return (it.path, "/")

    def item_delete(self, path):
        it = self.item(path)
        self.guard(self.wallet.delete_item, it)
        self.signal(it.coll.path, SS + ".Collection", "ItemDeleted", "o", (path,))
        return ("/",)

    def item_get_secret(self, path, session):
        it = self.item(path)
        return (self.session(session).encode(self.guard(self.wallet.secret, it), it.content_type),)

    def item_set_secret(self, path, secret):
        it = self.item(path)
        session, params, value, content_type = secret
        value = self.session(session).decode(params, value)
        it.content_type = content_type
        self.guard(self.wallet.store, it, value)
        self.signal(it.coll.path, SS + ".Collection", "ItemChanged", "o", (path,))
        return ()

    def item_update(self, it, label=None, attrs=None):
        """A label or attribute change: the host gets the item again, secret included."""
        value = self.guard(self.wallet.secret, it)
        if label is not None:
            it.label = label
        if attrs is not None:
            it.attributes = attrs
        self.guard(self.wallet.store, it, value)
        self.signal(it.coll.path, SS + ".Collection", "ItemChanged", "o", (it.path,))

    # -- properties --

    def props(self, path, iface):
        w = self.wallet
        if path == BASE and iface == SS + ".Service":
            return {"Collections": ("ao", [c.path for c in w.collections.values()])}
        if iface == SS + ".Collection" and (c := w.collection_for(path)) and len(path.split("/")) == 6:
            return {"Items": ("ao", [it.path for it in c.items.values()]), "Label": ("s", c.label),
                    "Locked": ("b", w.locked), "Created": ("t", c.created), "Modified": ("t", c.modified)}
        if iface == SS + ".Item" and (it := w.item_for(path)):
            return {"Locked": ("b", w.locked), "Attributes": ("a{ss}", it.attributes), "Label": ("s", it.label),
                    "Type": ("s", it.attributes.get("xdg:schema", "")), "Created": ("t", it.created), "Modified": ("t", it.modified)}
        raise Reply("org.freedesktop.DBus.Error.UnknownInterface", iface)

    def prop_get(self, path, iface, name):
        p = self.props(path, iface)
        if name not in p:
            raise Reply("org.freedesktop.DBus.Error.UnknownProperty", name)
        return (p[name],)

    def prop_set(self, path, iface, name, value):
        if iface == SS + ".Collection" and name == "Label":
            c = self.collection(path)
            c.label = str(value[1])
            self.guard(self.wallet.save_collection, c)
            self.signal(BASE, SS + ".Service", "CollectionChanged", "o", (c.path,))
        elif iface == SS + ".Item" and name in ("Label", "Attributes"):
            it = self.item(path)
            if name == "Label":
                self.item_update(it, label=str(value[1]))
            else:
                self.item_update(it, attrs={str(k): str(v) for k, v in value[1].items()})
        else:
            raise Reply("org.freedesktop.DBus.Error.PropertyReadOnly", name)
        return ()

    # -- KWallet: wallets are collections, entries are items (attributes server, user, type) --

    def kw_wallet(self, handle, appid):
        name = self.handles.get((handle, appid))
        c = self.wallet.collections.get(name) if name else None
        if c is None:
            raise Reply(KW + ".Error.NoWallet", "The wallet is not open")
        return c

    def kw_collection(self, wallet, create=False):
        if wallet in ("kdewallet", ""):
            return self.wallet.alias("default") or self.wallet.collections[DEFAULT]
        for c in self.wallet.collections.values():
            if c.label == wallet and c.persistent:
                return c
        return self.guard(self.wallet.create_collection, wallet) if create else None

    def kw_open(self, wallet, appid):
        if self.wallet.locked:
            return -1
        c = self.kw_collection(wallet, create=True)
        handle = rng.randbelow(2 ** 31 - 2) + 1
        self.handles[(handle, appid)] = c.name
        for p in KW_PATHS:
            self.signal(p, KW, "walletOpened", "s", (wallet,))
        return handle

    def kw_open_async(self, wallet, appid):
        self.kw_tid += 1
        tid = self.kw_tid

        def work():
            ok = self.wait_unlocked(WAIT)
            with self.lock:
                handle = self.kw_open(wallet, appid) if ok else -1
                for p in KW_PATHS:
                    self.signal(p, KW, "walletAsyncOpened", "ii", (tid, handle))

        threading.Thread(target=work, daemon=True).start()
        return tid

    def kw_entries(self, c, folder):
        return {it.attributes.get("user", ""): it for it in self.wallet.search({"server": folder}, [c])}

    def kw_folders(self, c):
        made = {"Passwords", "Form Data"} | self.folders.get(c.name, set())  # kwalletd makes the first two on open
        return sorted({it.attributes.get("server", "") for it in c.items.values() if "server" in it.attributes} | made)

    def kw_read(self, it):
        value = self.guard(self.wallet.secret, it)
        kind = it.attributes.get("type", "plaintext")
        if kind == "base64":
            return 2, base64.b64decode(value)
        if kind == "binary":
            return 2, value
        if kind == "map":
            try:
                m = json.loads(value or b"{}")
            except ValueError:
                m = {}
            return 3, qmap_encode({str(k): str(v) for k, v in m.items()})
        return 1, value

    def kw_write(self, c, folder, key, value, kind):
        if kind == 1:
            stored, type_ = bytes(value), "plaintext"
        elif kind == 2:
            stored, type_ = base64.b64encode(bytes(value)), "base64"
        elif kind == 3:
            try:
                stored, type_ = json.dumps(qmap_decode(value), separators=(",", ":")).encode(), "map"
            except (struct.error, UnicodeDecodeError):
                return -1
        else:
            return -1
        attrs = {"server": folder, "user": key, "type": type_}
        old = self.kw_entries(c, folder).get(key)
        new_folder = folder not in self.kw_folders(c)
        if old is not None:
            old.attributes = attrs
            old.content_type = "text/plain"
            self.guard(self.wallet.store, old, stored)
            self.signal(c.path, SS + ".Collection", "ItemChanged", "o", (old.path,))
        else:
            it = self.guard(self.wallet.new_item, c, f"{folder}/{key}", attrs, "text/plain", stored)
            self.signal(c.path, SS + ".Collection", "ItemCreated", "o", (it.path,))
        for p in KW_PATHS:
            if new_folder:
                self.signal(p, KW, "folderListUpdated", "s", (c.label,))
            self.signal(p, KW, "folderUpdated", "ss", (c.label, folder))
        return 0

    def kw_lists(self, handle, folder, appid, want=None, key=None):
        c = self.kw_wallet(handle, appid)
        out = {}
        for k, it in self.kw_entries(c, folder).items():
            if key is not None and k != key:
                continue
            kind, value = self.kw_read(it)
            if want == 3 and kind == 3:
                out[k] = ("a{sv}", {a: ("s", b) for a, b in qmap_decode(value).items()}) if key is not None else ("ay", value)
            elif want == 1 and kind == 1:
                out[k] = ("s", value.decode(errors="replace"))
            elif want is None:
                out[k] = ("ay", value if kind != 1 else value)
        return (out,)

    def kw_remove_entry(self, handle, folder, key, appid):
        c = self.kw_wallet(handle, appid)
        it = self.kw_entries(c, folder).get(key)
        if it is None:
            return (-1,)
        self.guard(self.wallet.delete_item, it)
        self.signal(c.path, SS + ".Collection", "ItemDeleted", "o", (it.path,))
        for p in KW_PATHS:
            self.signal(p, KW, "folderUpdated", "ss", (c.label, folder))
        return (0,)

    def kw_remove_folder(self, handle, folder, appid):
        c = self.kw_wallet(handle, appid)
        for it in self.kw_entries(c, folder).values():
            self.guard(self.wallet.delete_item, it)
        self.folders.get(c.name, set()).discard(folder)
        for p in KW_PATHS:
            self.signal(p, KW, "folderListUpdated", "s", (c.label,))
        return (True,)

    def kw_rename(self, handle, folder, old, new, appid):
        c = self.kw_wallet(handle, appid)
        it = self.kw_entries(c, folder).get(old)
        if it is None or new in self.kw_entries(c, folder):
            return (-1,)
        attrs = dict(it.attributes, user=new)
        it.label = f"{folder}/{new}"
        self.item_update(it, attrs=attrs)
        return (0,)

    def kw_close(self, handle, appid):
        name = self.handles.pop((handle, appid), None)
        if name is None:
            return (1,)
        for p in KW_PATHS:
            self.signal(p, KW, "walletClosedId", "i", (handle,))
        if not self.handles:
            for p in KW_PATHS:
                self.signal(p, KW, "allWalletsClosed")
        return (0,)

    def kw_close_wallet(self, wallet):
        c = self.kw_collection(wallet)
        for k in [k for k, v in self.handles.items() if c and v == c.name]:
            del self.handles[k]
        for p in KW_PATHS:
            self.signal(p, KW, "walletClosed", "s", (wallet,))
        return (0,)

    def kw_wallets(self):
        names = ["kdewallet"]
        names += [c.label for c in self.wallet.collections.values()
                  if c.persistent and c is not self.kw_collection("kdewallet") and c.label != "kdewallet"]
        return (names,)

    # -- the dispatch table: (kind, interface) -> member -> [(in signature, out signature, handler)] --

    def table(self):
        P, W = self, None
        H = lambda f: (lambda path, msg, *a: f(*a))  # noqa: E731
        Hp = lambda f: (lambda path, msg, *a: f(path, *a))  # noqa: E731
        kw = {
            "isEnabled": [("", "b", H(lambda: (True,)))],
            "open": [("sxs", "i", H(lambda w, wid, app: (P.kw_open(w, app),)))],
            "openPath": [("sxs", "i", H(lambda w, wid, app: (-1,)))],
            "openAsync": [("sxsb", "i", H(lambda w, wid, app, hs: (P.kw_open_async(w, app),)))],
            "openPathAsync": [("sxsb", "i", H(lambda w, wid, app, hs: (-1,)))],
            "close": [("sb", "i", H(lambda w, force: P.kw_close_wallet(w))),
                      ("ibs", "i", H(lambda h, force, app: P.kw_close(h, app)))],
            "sync": [("is", "", H(lambda h, app: ()))],
            "deleteWallet": [("s", "i", H(lambda w: (-1,)))],
            "isOpen": [("s", "b", H(lambda w: (any(v == getattr(P.kw_collection(w), "name", None) for v in P.handles.values()),))),
                       ("i", "b", H(lambda h: (any(k[0] == h for k in P.handles),)))],
            "users": [("s", "as", H(lambda w: (sorted({k[1] for k in P.handles}),)))],
            "changePassword": [("sxs", "", H(lambda w, wid, app: ()))],
            "wallets": [("", "as", H(P.kw_wallets))],
            "folderList": [("is", "as", H(lambda h, app: (P.kw_folders(P.kw_wallet(h, app)),)))],
            "hasFolder": [("iss", "b", H(lambda h, f, app: (f in P.kw_folders(P.kw_wallet(h, app)),)))],
            "createFolder": [("iss", "b", H(lambda h, f, app: (P.folders.setdefault(P.kw_wallet(h, app).name, set()).add(f) or True,)))],
            "removeFolder": [("iss", "b", H(P.kw_remove_folder))],
            "entryList": [("iss", "as", H(lambda h, f, app: (sorted(P.kw_entries(P.kw_wallet(h, app), f)),)))],
            "readEntry": [("isss", "ay", H(lambda h, f, k, app: P.kw_value(h, f, k, app, None)))],
            "readMap": [("isss", "ay", H(lambda h, f, k, app: P.kw_value(h, f, k, app, 3)))],
            "readPassword": [("isss", "s", H(lambda h, f, k, app: P.kw_value(h, f, k, app, 1)))],
            "readEntryList": [("isss", "a{sv}", H(lambda h, f, k, app: P.kw_lists(h, f, app, None, k)))],
            "entriesList": [("iss", "a{sv}", H(lambda h, f, app: P.kw_lists(h, f, app, None)))],
            "readMapList": [("isss", "a{sv}", H(lambda h, f, k, app: P.kw_lists(h, f, app, 3, k)))],
            "mapList": [("iss", "a{sv}", H(lambda h, f, app: P.kw_lists(h, f, app, 3)))],
            "readPasswordList": [("isss", "a{sv}", H(lambda h, f, k, app: P.kw_lists(h, f, app, 1, k)))],
            "passwordList": [("iss", "a{sv}", H(lambda h, f, app: P.kw_lists(h, f, app, 1)))],
            "renameEntry": [("issss", "i", H(P.kw_rename))],
            "writeEntry": [("issayis", "i", H(lambda h, f, k, v, t, app: (P.kw_write(P.kw_wallet(h, app), f, k, v, t),))),
                           ("issays", "i", H(lambda h, f, k, v, app: (P.kw_write(P.kw_wallet(h, app), f, k, v, 2),)))],
            "writeMap": [("issays", "i", H(lambda h, f, k, v, app: (P.kw_write(P.kw_wallet(h, app), f, k, v, 3),)))],
            "writePassword": [("issss", "i", H(lambda h, f, k, v, app: (P.kw_write(P.kw_wallet(h, app), f, k, v.encode(), 1),)))],
            "hasEntry": [("isss", "b", H(lambda h, f, k, app: (k in P.kw_entries(P.kw_wallet(h, app), f),)))],
            "entryType": [("isss", "i", H(lambda h, f, k, app: (P.kw_type(h, f, k, app),)))],
            "removeEntry": [("isss", "i", H(P.kw_remove_entry))],
            "disconnectApplication": [("ss", "b", H(lambda w, app: (P.kw_disconnect(w, app),)))],
            "reconfigure": [("", "", H(lambda: ()))],
            "folderDoesNotExist": [("ss", "b", H(lambda w, f: (f not in P.kw_folders(P.kw_collection(w) or P.wallet.collections[DEFAULT]),)))],
            "keyDoesNotExist": [("sss", "b", H(lambda w, f, k: (k not in P.kw_entries(P.kw_collection(w) or P.wallet.collections[DEFAULT], f),)))],
            "closeAllWallets": [("", "", H(lambda: P.handles.clear() or ()))],
            "networkWallet": [("", "s", H(lambda: ("kdewallet",)))],
            "localWallet": [("", "s", H(lambda: ("kdewallet",)))],
            "pamOpen": [("sayi", "", H(lambda w, h, t: ()))],
        }
        return {
            ("service", SS + ".Service"): {
                "OpenSession": [("sv", "vo", lambda path, msg, alg, inp: P.open_session(msg, alg, inp))],
                "CreateCollection": [("a{sv}s", "oo", H(P.create_collection))],
                "SearchItems": [("a{ss}", "aoao", H(P.search_all))],
                "Unlock": [("ao", "aoo", H(P.unlock))],
                "Lock": [("ao", "aoo", H(lambda objs: ([], "/")))],
                "GetSecrets": [("aoo", "a{o(oayays)}", H(P.get_secrets))],
                "ReadAlias": [("s", "o", H(P.read_alias))],
                "SetAlias": [("so", "", H(P.set_alias))],
            },
            ("collection", SS + ".Collection"): {
                "Delete": [("", "o", Hp(P.collection_delete))],
                "SearchItems": [("a{ss}", "ao", Hp(P.collection_search))],
                "CreateItem": [("a{sv}(oayays)b", "oo", Hp(P.create_item))],
            },
            ("item", SS + ".Item"): {
                "Delete": [("", "o", Hp(P.item_delete))],
                "GetSecret": [("o", "(oayays)", Hp(P.item_get_secret))],
                "SetSecret": [("(oayays)", "", Hp(P.item_set_secret))],
            },
            ("session", SS + ".Session"): {
                "Close": [("", "", Hp(lambda path: P.sessions.pop(path, None) and ()))],
            },
            ("prompt", SS + ".Prompt"): {
                "Prompt": [("s", "", Hp(lambda path, wid: P.run_prompt(path) or ()))],
                "Dismiss": [("", "", Hp(lambda path: P.run_prompt(path, dismiss=True) or ()))],
            },
            ("kwallet", KW): kw,
            # A second kwalletd6 (pam_kwallet_init, D-Bus activation) finds the name taken and calls these, then exits.
            ("any", "org.freedesktop.Application"): {
                "Activate": [("a{sv}", "", H(lambda d: ()))],
                "Open": [("asa{sv}", "", H(lambda u, d: ()))],
                "ActivateAction": [("sava{sv}", "", H(lambda a, p, d: ()))],
            },
            ("any", "org.kde.KDBusService"): {
                "CommandLine": [("assa{sv}", "i", H(lambda args, wd, d: (0,)))],
            },
            ("any", "org.freedesktop.DBus.Properties"): {
                "Get": [("ss", "v", Hp(P.prop_get))],
                "GetAll": [("s", "a{sv}", Hp(lambda path, iface: (P.props(path, iface),)))],
                "Set": [("ssv", "", Hp(P.prop_set))],
            },
            ("any", "org.freedesktop.DBus.Introspectable"): {
                "Introspect": [("", "s", Hp(lambda path: (P.introspect(path),)))],
            },
            ("any", "org.freedesktop.DBus.Peer"): {
                "Ping": [("", "", H(lambda: ()))],
            },
        }

    def kw_value(self, h, f, k, app, want):
        it = self.kw_entries(self.kw_wallet(h, app), f).get(k)
        if it is None:
            return ("" if want == 1 else b"",)
        kind, value = self.kw_read(it)
        if want == 1:
            return (value.decode(errors="replace") if kind == 1 else "",)
        if want == 3:
            return (value if kind == 3 else b"",)
        return (value,)

    def kw_type(self, h, f, k, app):
        it = self.kw_entries(self.kw_wallet(h, app), f).get(k)
        if it is None:
            return 0
        return {"map": 3, "base64": 2, "binary": 2}.get(it.attributes.get("type"), 1)

    def kw_disconnect(self, wallet, app):
        c = self.kw_collection(wallet)
        gone = [k for k, v in self.handles.items() if k[1] == app and c and v == c.name]
        for k in gone:
            del self.handles[k]
        if gone:
            for p in KW_PATHS:
                self.signal(p, KW, "applicationDisconnected", "ss", (wallet, app))
        return bool(gone)

    def kind(self, path):
        w = self.wallet
        if path == BASE:
            return "service"
        if path in KW_PATHS:
            return "kwallet"
        if path in self.sessions:
            return "session"
        if path in self.prompts:
            return "prompt"
        if w.item_for(path):
            return "item"
        if len(path.split("/")) == 6 and w.collection_for(path):
            return "collection"
        return None

    def introspect(self, path):
        kind = self.kind(path)
        parts = ['<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" '
                 '"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">\n<node>']
        for (k, iface), members in self.methods.items():
            if k != kind and not (k == "any" and kind and iface.startswith("org.freedesktop.DBus.")):
                continue
            parts.append(f' <interface name="{iface}">')
            for name, overloads in members.items():
                for sig_in, sig_out, _ in overloads:
                    args = "".join(f'<arg type="{t}" direction="in"/>' for t in split_sig(sig_in))
                    args += "".join(f'<arg type="{t}" direction="out"/>' for t in split_sig(sig_out))
                    parts.append(f'  <method name="{name}">{args}</method>')
            parts.append(" </interface>")
        children = []
        if path == "/":
            children = ["org", "modules"]
        elif path == "/modules":
            children = ["kwalletd6", "kwalletd5"]
        elif "/org/freedesktop/secrets".startswith(path + "/"):
            children = ["/org/freedesktop/secrets"[len(path) + 1:].split("/")[0]]
        elif path == BASE:
            children = ["collection", "aliases"]
        elif path == BASE + "/collection":
            children = list(self.wallet.collections)
        elif kind == "collection":
            children = list(self.collection(path).items)
        parts += [f' <node name="{c}"/>' for c in children]
        parts.append("</node>")
        return "\n".join(parts)

    # -- one message --

    def handle(self, msg):
        h = msg.header
        if h.message_type != MessageType.method_call:
            return
        f = h.fields
        path, iface, member = f.get(HeaderFields.path, ""), f.get(HeaderFields.interface), f.get(HeaderFields.member, "")
        sig = f.get(HeaderFields.signature, "")
        kind = self.kind(path)
        reply = None
        with self.lock:
            try:
                handler = out = None
                for (k, i), members in self.methods.items():
                    if (k == kind or (k == "any" and (kind is not None or i in ANY_PATH))) \
                            and (iface is None or iface == i) and member in members:
                        for sig_in, sig_out, fn in members[member]:
                            if sig_in == sig:
                                handler, out = fn, sig_out
                                break
                        if handler is None:
                            raise Reply("org.freedesktop.DBus.Error.InvalidArgs", f"{member} takes ({members[member][0][0]})")
                        break
                if handler is None:
                    raise Reply("org.freedesktop.DBus.Error.UnknownMethod" if kind else "org.freedesktop.DBus.Error.UnknownObject",
                                f"{iface}.{member} on {path}")
                body = handler(path, msg, *msg.body)
                reply = new_method_return(msg, out, tuple(body or ()))
            except Reply as e:
                reply = new_error(msg, e.name, "s", (e.text,))
            except Exception as e:  # a bad request must not stop the wallet
                log(f"{member}: {type(e).__name__}")
                reply = new_error(msg, "org.freedesktop.DBus.Error.Failed", "s", (type(e).__name__,))
            if not h.flags & MessageFlag.no_reply_expected:
                self.send(reply)


def split_sig(sig):
    out, i = [], 0
    while i < len(sig):
        j, depth = i, 0
        while True:
            c = sig[j]
            if c in "({":
                depth += 1
            elif c in ")}":
                depth -= 1
            j += 1
            if depth == 0 and c != "a":
                break
        out.append(sig[i:j])
        i = j
    return out


def follow(server, host):
    """The device's lock, by long poll. Without an answer the wallet counts as locked."""
    seq = None
    while True:
        try:
            locked, seq = host.state(since=seq, timeout=40)
            server.set_locked(locked)
        except Missing:
            server.set_locked(True)
            seq = None
            time.sleep(30)
        except (HostError, Locked, ValueError):
            server.set_locked(True)
            seq = None
            time.sleep(5)


def fallback(activated):
    kwalletd = "/usr/bin/kwalletd6"
    if activated and os.access(kwalletd, os.X_OK):
        log("no wallet on the device: kwalletd6 runs instead")
        os.execv(kwalletd, [kwalletd])
    sys.exit(0)


def main():
    activated = "--activated" in sys.argv
    host = Host()
    end = time.monotonic() + 20  # the network can come up after the login
    while True:
        try:
            locked, _ = host.state(timeout=5)
            break
        except HostError:
            if time.monotonic() > end:
                log("the device does not answer")
                fallback(activated)
            time.sleep(1)
        except (Missing, Locked, ValueError) as e:
            log(f"the device has no wallet for this machine ({type(e).__name__})")
            fallback(activated)
    conn = open_dbus_connection(bus="SESSION")
    server = Server(conn, host)
    server.wallet.locked = locked
    try:
        server.wallet.load()
    except (HostError, Missing, Locked) as e:
        log(f"no items yet: {type(e).__name__}")
    backlog = deque()
    owned = []
    with conn.filter(MatchRule(type="method_call"), queue=backlog, bufsize=10000):
        for name in ("org.freedesktop.secrets", "org.kde.kwalletd6", "org.kde.kwalletd5"):
            reply = conn.send_and_get_reply(message_bus.RequestName(name, 4))  # DBUS_NAME_FLAG_DO_NOT_QUEUE
            if reply.body and reply.body[0] in (1, 4):
                owned.append(name)
    if not owned:
        log("another wallet has the names")
        sys.exit(0)
    log("serving " + " ".join(owned))
    threading.Thread(target=follow, args=(server, host), daemon=True).start()
    while backlog:
        server.handle(backlog.popleft())
    while True:
        server.handle(conn.receive())


if __name__ == "__main__":
    main()
