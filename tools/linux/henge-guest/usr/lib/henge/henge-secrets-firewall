#!/bin/sh
# Only root and the session user (henge) reach the wallet's port, 10.0.2.4:81 (host/share.h).
# start: load the rule, then follow nftables and load it again whenever it goes (nftables.service's start, reload
#   and stop, and nft flush ruleset, flush every table). Each load replaces the table in one transaction.
# remove: take the rule away (the package's removal). Stopping the unit keeps it.
# An owner match works on this machine's own connections; one routed for a container or VM is dropped.
set -eu
PORT=81
TABLE="inet henge_secrets"

apply() {
    nft -f - <<EOF
table $TABLE
delete table $TABLE
table $TABLE {
	chain output {
		type filter hook output priority 0; policy accept;
		ip daddr 10.0.2.4 tcp dport $PORT meta skuid { 0, $uid } accept
		ip daddr 10.0.2.4 tcp dport $PORT reject with tcp reset
	}
	chain forward {
		type filter hook forward priority 0; policy accept;
		ip daddr 10.0.2.4 tcp dport $PORT drop
	}
}
EOF
    nft list table $TABLE
}

case "${1:-start}" in
    remove)
        nft delete table $TABLE 2>/dev/null || true
        exit 0 ;;
    start) ;;
    *) echo "usage: henge-secrets-firewall start|remove" >&2; exit 2 ;;
esac
uid=$(id -u "${HENGE_WALLET_USER:-henge}")
want=$(apply)
systemd-notify --ready 2>/dev/null || true
nft monitor | while read -r _; do
    [ "$(nft list table $TABLE 2>/dev/null)" = "$want" ] || want=$(apply)
done
exit 1 # nft monitor ended: systemd starts it again
