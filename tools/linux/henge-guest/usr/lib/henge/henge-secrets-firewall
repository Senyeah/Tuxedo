#!/bin/sh
# Only root and the session user (henge) reach the wallet's port, 10.0.2.4:81 (host/share.h): "start" or "stop".
# An owner match works on this machine's own connections; one routed for a container or VM is dropped.
set -eu
PORT=81
case "${1:-start}" in
    stop)
        nft delete table inet henge_secrets 2>/dev/null || true
        exit 0 ;;
    start) ;;
    *) echo "usage: henge-secrets-firewall start|stop" >&2; exit 2 ;;
esac
uid=$(id -u "${HENGE_WALLET_USER:-henge}")
nft -f - <<EOF
table inet henge_secrets
delete table inet henge_secrets
table inet henge_secrets {
	chain output {
		type filter hook output priority 0; policy accept;
		ip daddr 10.0.2.4 tcp dport $PORT meta skuid { 0, $uid } accept
		ip daddr 10.0.2.4 tcp dport $PORT counter reject with tcp reset
	}
	chain forward {
		type filter hook forward priority 0; policy accept;
		ip daddr 10.0.2.4 tcp dport $PORT counter drop
	}
}
EOF
