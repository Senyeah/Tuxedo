[Unit]
Description=Henge: only the session user reaches the wallet's port
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target systemd-user-sessions.service shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/henge/henge-secrets-firewall start
ExecStop=/usr/lib/henge/henge-secrets-firewall stop

[Install]
WantedBy=sysinit.target
