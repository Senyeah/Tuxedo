[Unit]
Description=Henge: only the session user reaches the wallet's port
DefaultDependencies=no
After=local-fs.target nftables.service
Before=network-pre.target systemd-user-sessions.service shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
# Ready once the rule is in; then it follows nftables and puts the rule back after any flush
Type=notify
NotifyAccess=all
ExecStart=/usr/lib/henge/henge-secrets-firewall start
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
