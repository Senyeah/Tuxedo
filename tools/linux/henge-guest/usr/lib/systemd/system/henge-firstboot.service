[Unit]
Description=Henge first-boot setup
DefaultDependencies=no
ConditionPathExists=!/var/lib/henge/firstboot-done
After=local-fs.target
Before=multi-user.target systemd-networkd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/henge/henge-firstboot

[Install]
WantedBy=multi-user.target
