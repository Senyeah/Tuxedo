[Unit]
Description=Henge folders from the Files app at /media/henge
ConditionDirectoryNotEmpty=/sys/fs/virtiofs
Requires=run-henge-files.mount
After=run-henge-files.mount network.target

[Service]
ExecStart=/usr/lib/henge/henge-files run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
