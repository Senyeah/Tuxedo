# The Henge apt repository: henge-ffmpeg, and later henge-guest updates.
# Off until the repository is on the server. To turn it on, change "Enabled: no" to "Enabled: yes",
# then run: sudo apt update && sudo apt install henge-ffmpeg
Types: deb
URIs: https://walkies.site/henge-linux-catalogue/apt
Suites: trixie
Components: main
Architectures: arm64
Signed-By: /usr/share/keyrings/henge-archive.gpg
Enabled: no
