# Boot speed (P2). Merged over qemu_arm64_defconfig by build-uboot.sh.
# No countdown: it cost 2.0 s of a 9 s boot. Needs a stock build (--stock) to stop at the prompt.
CONFIG_BOOTDELAY=0
# The EFI boot manager has nothing to load (decision 4); trying it costs 0.1 s.
# CONFIG_BOOTMETH_EFI_BOOTMGR is not set
