[Unit]
Description=Tuxedo shared folder
After=network-online.target
Wants=network-online.target

[Mount]
What=http://10.0.2.4/
Where=/home/tux/Tux
Type=davfs
Options=noauto,uid=tux,gid=tux,conf=/etc/tux/davfs2.conf
# A boot or a host without the share must not leave a process stuck in the folder
TimeoutSec=20
