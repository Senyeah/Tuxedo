#!/bin/sh
set -e

# Only the links that still point into /usr/lib/tux: an admin's change stays. An upgrade keeps them.
if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
    for n in ffmpeg ffprobe; do
        l=/usr/local/bin/$n
        if [ -L "$l" ]; then
            case "$(readlink "$l")" in
                /usr/lib/tux/*) rm -f "$l" ;;
            esac
        fi
    done
fi
