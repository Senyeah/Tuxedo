#!/bin/sh
set -e

# /usr/local belongs to the admin (Debian policy 9.1.2): links only, and never over a file that we did not make.
LINKS="ffmpeg ffprobe"
DIR=/usr/lib/tux/ffmpeg/bin

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
        mkdir -p /usr/local/bin
        for n in $LINKS; do
            l=/usr/local/bin/$n
            if [ -L "$l" ]; then
                case "$(readlink "$l")" in
                    /usr/lib/tux/*) ln -sfn "$DIR/$n" "$l" ;;
                    *) echo "tux-ffmpeg: $l is not ours; it stays, and $n is not the Tuxedo build" >&2 ;;
                esac
            elif [ -e "$l" ]; then
                echo "tux-ffmpeg: $l is not ours; it stays, and $n is not the Tuxedo build" >&2
            else
                ln -s "$DIR/$n" "$l"
            fi
        done
        ;;
esac
