+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <string.h>
+
+#include <hvcodec.h>
+
+#include "buffer.h"
+#include "common.h"
+#include "hwcontext.h"
+#include "hwcontext_henge.h"
+#include "hwcontext_internal.h"
+#include "mem.h"
+#include "pixdesc.h"
+#include "pixfmt.h"
+
+typedef struct HengeDevicePriv {
+    AVHengeDeviceContext p;
+    HvQuery query;
+    int warned_tcp;
+} HengeDevicePriv;
+
+static const struct {
+    enum AVPixelFormat pix_fmt;
+    uint32_t fmt;
+} formats[] = {
+    { AV_PIX_FMT_NV12,   HV_VC_FMT_NV12 },
+    { AV_PIX_FMT_P010LE, HV_VC_FMT_P010 },
+    { AV_PIX_FMT_NV16,   HV_VC_FMT_NV16 },
+    { AV_PIX_FMT_P210LE, HV_VC_FMT_P210 },
+    { AV_PIX_FMT_NV24,   HV_VC_FMT_NV24 },
+    { AV_PIX_FMT_P410LE, HV_VC_FMT_P410 },
+    { AV_PIX_FMT_BGRA,   HV_VC_FMT_BGRA },
+};
+
+static const enum AVPixelFormat supported_formats[] = {
+    AV_PIX_FMT_NV12, AV_PIX_FMT_P010LE, AV_PIX_FMT_NV16, AV_PIX_FMT_P210LE,
+    AV_PIX_FMT_NV24, AV_PIX_FMT_P410LE, AV_PIX_FMT_BGRA, AV_PIX_FMT_NONE,
+};
+
+uint32_t av_henge_format_from_pix_fmt(enum AVPixelFormat pix_fmt)
+{
+    for (int i = 0; i < FF_ARRAY_ELEMS(formats); i++)
+        if (formats[i].pix_fmt == pix_fmt)
+            return formats[i].fmt;
+    return 0;
+}
+
+enum AVPixelFormat av_henge_format_to_pix_fmt(uint32_t fmt)
+{
+    for (int i = 0; i < FF_ARRAY_ELEMS(formats); i++)
+        if (formats[i].fmt == fmt)
+            return formats[i].pix_fmt;
+    return AV_PIX_FMT_NONE;
+}
+
+static HvClient *client_of(AVBufferRef *device_ref)
+{
+    AVHWDeviceContext *dev = (AVHWDeviceContext *)device_ref->data;
+    return ((AVHengeDeviceContext *)dev->hwctx)->client;
+}
+
+static void henge_frame_release(void *opaque, uint8_t *data)
+{
+    AVHengeFrame *f = (AVHengeFrame *)data;
+    if (f->handle && f->device_ref)
+        hv_frame_free(client_of(f->device_ref), f->handle);
+    av_buffer_unref(&f->device_ref);
+    av_buffer_unref(&f->hw_frames_ref);
+    av_free(f);
+}
+
+AVBufferRef *av_henge_frame_ref_alloc(AVBufferRef *device_ref)
+{
+    AVHengeFrame *f = av_mallocz(sizeof(*f));
+    AVBufferRef *buf;
+    if (!f)
+        return NULL;
+    f->device_ref = av_buffer_ref(device_ref);
+    buf = av_buffer_create((uint8_t *)f, sizeof(*f), henge_frame_release, NULL, 0);
+    if (!f->device_ref || !buf) {
+        av_buffer_unref(&f->device_ref);
+        if (buf)
+            av_buffer_unref(&buf);
+        else
+            av_free(f);
+        return NULL;
+    }
+    return buf;
+}
+
+static int fill_frame(AVBufferRef *device_ref, uint32_t handle, uint32_t w, uint32_t h, AVFrame *frame)
+{
+    AVBufferRef *buf = av_henge_frame_ref_alloc(device_ref);
+    AVHengeFrame *f;
+    if (!buf) {
+        hv_frame_free(client_of(device_ref), handle);
+        return AVERROR(ENOMEM);
+    }
+    f = (AVHengeFrame *)buf->data;
+    f->handle = handle;
+    f->width  = w;
+    f->height = h;
+    frame->buf[0]  = buf;
+    frame->data[3] = (uint8_t *)(uintptr_t)handle;
+    frame->format  = AV_PIX_FMT_HENGE;
+    frame->width   = w;
+    frame->height  = h;
+    return 0;
+}
+
+int av_henge_frame_wrap(AVBufferRef *hw_frames_ref, uint32_t handle,
+                        uint32_t width, uint32_t height, AVFrame *frame)
+{
+    AVHWFramesContext *ctx = (AVHWFramesContext *)hw_frames_ref->data;
+    int ret;
+    av_frame_unref(frame);
+    ret = fill_frame(ctx->device_ref, handle, width, height, frame);
+    if (ret < 0)
+        return ret;
+    frame->hw_frames_ctx = av_buffer_ref(hw_frames_ref);
+    if (!frame->hw_frames_ctx) {
+        av_frame_unref(frame);
+        return AVERROR(ENOMEM);
+    }
+    return 0;
+}
+
+static int henge_device_create(AVHWDeviceContext *ctx, const char *device,
+                               AVDictionary *opts, int flags)
+{
+    HengeDevicePriv *priv = ctx->hwctx;
+    char err[256];
+    int st;
+
+    priv->p.client = hv_client_open(device, err, sizeof(err));
+    if (!priv->p.client) {
+        av_log(ctx, AV_LOG_ERROR, "%s\n", err);
+        return AVERROR(EIO);
+    }
+    st = hv_query(priv->p.client, &priv->query, err, sizeof(err));
+    if (st) {
+        av_log(ctx, AV_LOG_ERROR, "%s\n", err);
+        hv_client_close(priv->p.client);
+        priv->p.client = NULL;
+        return AVERROR(EIO);
+    }
+    priv->p.query = &priv->query;
+    av_log(ctx, AV_LOG_VERBOSE, "Henge codec service at %s: %u encoders, %u decoders%s%s\n",
+           hv_client_addr(priv->p.client), priv->query.head.n_encoders, priv->query.head.n_decoders,
+           *hv_client_note(priv->p.client) ? "; " : "", hv_client_note(priv->p.client));
+    return 0;
+}
+
+static void henge_device_uninit(AVHWDeviceContext *ctx)
+{
+    HengeDevicePriv *priv = ctx->hwctx;
+    hv_query_free(&priv->query);
+    priv->p.query = NULL;
+    if (priv->p.client)
+        hv_client_close(priv->p.client);
+    priv->p.client = NULL;
+}
+
+static int henge_frames_get_constraints(AVHWDeviceContext *ctx, const void *hwconfig,
+                                        AVHWFramesConstraints *constraints)
+{
+    constraints->valid_sw_formats = av_malloc_array(FF_ARRAY_ELEMS(supported_formats),
+                                                    sizeof(*constraints->valid_sw_formats));
+    constraints->valid_hw_formats = av_malloc_array(2, sizeof(*constraints->valid_hw_formats));
+    if (!constraints->valid_sw_formats || !constraints->valid_hw_formats)
+        return AVERROR(ENOMEM);
+    memcpy(constraints->valid_sw_formats, supported_formats, sizeof(supported_formats));
+    constraints->valid_hw_formats[0] = AV_PIX_FMT_HENGE;
+    constraints->valid_hw_formats[1] = AV_PIX_FMT_NONE;
+    constraints->min_width  = HV_VC_MIN_DIM;
+    constraints->min_height = HV_VC_MIN_DIM;
+    constraints->max_width  = HV_VC_MAX_DIM;
+    constraints->max_height = HV_VC_MAX_DIM;
+    return 0;
+}
+
+static int henge_frames_init(AVHWFramesContext *ctx)
+{
+    FFHWFramesContext *ctxi = ffhwframesctx(ctx);
+    uint32_t fmt = av_henge_format_from_pix_fmt(ctx->sw_format);
+
+    if (!fmt) {
+        av_log(ctx, AV_LOG_ERROR, "The Henge device has no %s frames.\n",
+               av_get_pix_fmt_name(ctx->sw_format));
+        return AVERROR(ENOSYS);
+    }
+    if (!hv_vc_frame_bytes(fmt, ctx->width, ctx->height)) {
+        av_log(ctx, AV_LOG_ERROR, "The Henge device has no %dx%d frames.\n", ctx->width, ctx->height);
+        return AVERROR(EINVAL);
+    }
+    /* av_hwframe_get_buffer needs a pool, but get_buffer below makes a new host frame each
+       time: a pooled one could be filled again while an encoder still reads it. */
+    if (!ctx->pool) {
+        ctxi->pool_internal = av_buffer_pool_init(1, NULL);
+        if (!ctxi->pool_internal)
+            return AVERROR(ENOMEM);
+    }
+    return 0;
+}
+
+static int henge_frames_get_buffer(AVHWFramesContext *ctx, AVFrame *frame)
+{
+    AVHengeFramesContext *hwctx = ctx->hwctx;
+    HvClient *client = client_of(ctx->device_ref);
+    HvVcFrameAlloc a = {
+        .width  = ctx->width,
+        .height = ctx->height,
+        .format = av_henge_format_from_pix_fmt(ctx->sw_format),
+        .range  = hwctx->color_range == AVCOL_RANGE_JPEG ? HV_VC_RANGE_FULL : HV_VC_RANGE_VIDEO,
+    };
+    HvVcFrameReply fr;
+    HvReply r = { 0 };
+    int st = hv_call(client, HV_VC_FRAME_ALLOC, &a, sizeof(a), NULL, 0, &r);
+
+    if (st || r.len < sizeof(fr)) {
+        /* a host limit is ENOBUFS, not EAGAIN: a caller can wait for frames to be freed and try again */
+        av_log(ctx, st == HV_VC_E_LIMIT ? AV_LOG_VERBOSE : AV_LOG_ERROR, "FRAME_ALLOC: %s\n", st ? r.err : "short reply");
+        hv_reply_free(&r);
+        return st == HV_VC_E_LIMIT ? AVERROR(ENOBUFS) : AVERROR(EIO);
+    }
+    memcpy(&fr, r.data, sizeof(fr));
+    hv_reply_free(&r);
+    return fill_frame(ctx->device_ref, fr.handle, fr.width, fr.height, frame);
+}
+
+static int henge_transfer_get_formats(AVHWFramesContext *ctx,
+                                      enum AVHWFrameTransferDirection dir,
+                                      enum AVPixelFormat **formats)
+{
+    enum AVPixelFormat *fmts = av_malloc_array(2, sizeof(*fmts));
+    if (!fmts)
+        return AVERROR(ENOMEM);
+    fmts[0] = ctx->sw_format;
+    fmts[1] = AV_PIX_FMT_NONE;
+    *formats = fmts;
+    return 0;
+}
+
+static const AVHengeFrame *henge_frame_of(const AVFrame *f)
+{
+    return f->buf[0] && f->buf[0]->size == sizeof(AVHengeFrame) ? (const AVHengeFrame *)f->buf[0]->data : NULL;
+}
+
+static int plane_rows(const AVFrame *f, int plane)
+{
+    const AVPixFmtDescriptor *d = av_pix_fmt_desc_get(f->format);
+    return plane && d ? AV_CEIL_RSHIFT(f->height, d->log2_chroma_h) : f->height;
+}
+
+/* Raw frames on TCP are packed into messages: say so once, as a 4K chain is then far slower. */
+static void warn_tcp(AVHWFramesContext *ctx)
+{
+    HengeDevicePriv *priv = ctx->device_ctx->hwctx;
+    const char *why = hv_client_note(priv->p.client);
+
+    if (hv_client_dma(priv->p.client) || priv->warned_tcp)
+        return;
+    priv->warned_tcp = 1;
+    av_log(ctx, AV_LOG_WARNING, "Raw frames cross to the Henge device over TCP (%s), which is slow at 4K. "
+           "For /dev/hvcodec: install henge-codec-dkms and run the machine with the codec device.\n",
+           *why ? why : hv_client_addr(priv->p.client));
+}
+
+/* The frame's planes reach every row and column of the host frame, so the host can copy them in place. */
+static int covers(const AVFrame *f, int n, const uint32_t row[2], const uint32_t rows[2])
+{
+    for (int i = 0; i < n; i++)
+        if (!f->data[i] || f->linesize[i] < 0 || (uint32_t)f->linesize[i] < row[i] || (uint32_t)plane_rows(f, i) < rows[i])
+            return 0;
+    return 1;
+}
+
+static int henge_transfer_data_to(AVHWFramesContext *ctx, AVFrame *dst, const AVFrame *src)
+{
+    HvClient *client = client_of(ctx->device_ref);
+    const AVHengeFrame *hf = henge_frame_of(dst);
+    uint32_t fmt = av_henge_format_from_pix_fmt(ctx->sw_format), row[2], rows[2];
+    uint8_t *data[2] = { NULL, NULL }, *packed = NULL;
+    int linesize[2] = { 0, 0 };
+    int n, st;
+    HvReply r = { 0 };
+
+    if (!hf || !hf->handle || src->format != ctx->sw_format)
+        return AVERROR(EINVAL);
+    n = hv_vc_planes(fmt, hf->width, hf->height, row, rows);
+    if (!n)
+        return AVERROR(EINVAL);
+    warn_tcp(ctx);
+    if (covers(src, n, row, rows)) {
+        for (int i = 0; i < n; i++)
+            data[i] = src->data[i], linesize[i] = src->linesize[i];
+    } else {
+        /* the source is smaller than the host frame: pad with zeros */
+        uint8_t *p = packed = av_malloc(hv_vc_frame_bytes(fmt, hf->width, hf->height));
+        if (!packed)
+            return AVERROR(ENOMEM);
+        for (int i = 0; i < n; i++) {
+            int src_rows = plane_rows(src, i);
+            size_t copy = FFMIN((size_t)row[i], (size_t)FFABS(src->linesize[i]));
+            data[i] = p, linesize[i] = row[i];
+            for (uint32_t y = 0; y < rows[i]; y++, p += row[i]) {
+                if ((int)y < src_rows && src->data[i]) {
+                    memcpy(p, src->data[i] + (ptrdiff_t)y * src->linesize[i], copy);
+                    if (copy < row[i])
+                        memset(p + copy, 0, row[i] - copy);
+                } else {
+                    memset(p, 0, row[i]);
+                }
+            }
+        }
+    }
+    st = hv_frame_upload(client, hf->handle, fmt, hf->width, hf->height, data, linesize, &r);
+    av_free(packed);
+    if (st)
+        av_log(ctx, st == HV_VC_E_LIMIT ? AV_LOG_VERBOSE : AV_LOG_ERROR, "FRAME_UPLOAD: %s\n", r.err);
+    hv_reply_free(&r);
+    return !st ? 0 : st == HV_VC_E_LIMIT ? AVERROR(ENOBUFS) : AVERROR(EIO);
+}
+
+static int henge_transfer_data_from(AVHWFramesContext *ctx, AVFrame *dst, const AVFrame *src)
+{
+    HvClient *client = client_of(ctx->device_ref);
+    const AVHengeFrame *hf = henge_frame_of(src);
+    uint32_t fmt = av_henge_format_from_pix_fmt(ctx->sw_format), row[2], rows[2];
+    uint8_t *data[2] = { NULL, NULL }, *packed = NULL;
+    int linesize[2] = { 0, 0 };
+    int n, st, direct;
+    HvReply r = { 0 };
+
+    if (!hf || !hf->handle || dst->format != ctx->sw_format)
+        return AVERROR(EINVAL);
+    n = hv_vc_planes(fmt, hf->width, hf->height, row, rows);
+    if (!n)
+        return AVERROR(EINVAL);
+    warn_tcp(ctx);
+    direct = covers(dst, n, row, rows);
+    if (direct) {
+        for (int i = 0; i < n; i++)
+            data[i] = dst->data[i], linesize[i] = dst->linesize[i];
+    } else {
+        uint8_t *p = packed = av_malloc(hv_vc_frame_bytes(fmt, hf->width, hf->height));
+        if (!packed)
+            return AVERROR(ENOMEM);
+        for (int i = 0; i < n; i++)
+            data[i] = p, linesize[i] = row[i], p += (size_t)row[i] * rows[i];
+    }
+    st = hv_frame_download(client, hf->handle, fmt, hf->width, hf->height, data, linesize, &r);
+    if (st) {
+        av_log(ctx, AV_LOG_ERROR, "FRAME_DOWNLOAD: %s\n", r.err);
+    } else if (!direct) {
+        /* the destination is smaller than the host frame: clip */
+        for (int i = 0; i < n; i++) {
+            int dst_rows = plane_rows(dst, i);
+            size_t copy = FFMIN((size_t)row[i], (size_t)FFABS(dst->linesize[i]));
+            for (uint32_t y = 0; y < rows[i]; y++)
+                if ((int)y < dst_rows && dst->data[i])
+                    memcpy(dst->data[i] + (ptrdiff_t)y * dst->linesize[i], data[i] + (size_t)y * row[i], copy);
+        }
+    }
+    av_free(packed);
+    hv_reply_free(&r);
+    return st ? AVERROR(EIO) : 0;
+}
+
+const HWContextType ff_hwcontext_type_henge = {
+    .type                   = AV_HWDEVICE_TYPE_HENGE,
+    .name                   = "Tux",
+
+    .device_hwctx_size      = sizeof(HengeDevicePriv),
+    .frames_hwctx_size      = sizeof(AVHengeFramesContext),
+
+    .device_create          = henge_device_create,
+    .device_uninit          = henge_device_uninit,
+    .frames_get_constraints = henge_frames_get_constraints,
+    .frames_init            = henge_frames_init,
+    .frames_get_buffer      = henge_frames_get_buffer,
+    .transfer_get_formats   = henge_transfer_get_formats,
+    .transfer_data_to       = henge_transfer_data_to,
+    .transfer_data_from     = henge_transfer_data_from,
+
+    .pix_fmts = (const enum AVPixelFormat[]){ AV_PIX_FMT_HENGE, AV_PIX_FMT_NONE },
+};
