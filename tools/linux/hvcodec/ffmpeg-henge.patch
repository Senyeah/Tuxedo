diff --git a/libavfilter/vf_scale_henge.c b/libavfilter/vf_scale_henge.c
new file mode 100644
index 00000000..daadba35
--- /dev/null
+++ b/libavfilter/vf_scale_henge.c
@@ -0,0 +1,244 @@
+/*
+ * scale_henge: scale and convert henge frames on the device (VTPixelTransferSession there)
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <hvcodec.h>
+
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_henge.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+
+#include "filters.h"
+#include "scale_eval.h"
+#include "video.h"
+
+typedef struct ScaleHengeContext {
+    AVClass *class;
+    char *w_expr, *h_expr;
+    int output_width, output_height;
+    enum AVPixelFormat format;
+    int letterbox;
+    char *primaries_string, *transfer_string, *matrix_string;
+    enum AVColorPrimaries primaries;
+    enum AVColorTransferCharacteristic transfer;
+    enum AVColorSpace matrix;
+    enum AVColorRange range;
+    HvReply reply;
+} ScaleHengeContext;
+
+static av_cold int scale_henge_init(AVFilterContext *avctx)
+{
+    ScaleHengeContext *s = avctx->priv;
+
+#define STRING_OPTION(var, func)                                        \
+    do {                                                                \
+        s->var = 0;                                                     \
+        if (s->var##_string) {                                          \
+            int v = av_##func##_from_name(s->var##_string);             \
+            if (v < 0) {                                                \
+                av_log(avctx, AV_LOG_ERROR, "Invalid %s.\n", #var);     \
+                return AVERROR(EINVAL);                                 \
+            }                                                           \
+            s->var = v;                                                 \
+        }                                                               \
+    } while (0)
+    STRING_OPTION(primaries, color_primaries);
+    STRING_OPTION(transfer,  color_transfer);
+    STRING_OPTION(matrix,    color_space);
+    if (s->format != AV_PIX_FMT_NONE && !av_henge_format_from_pix_fmt(s->format)) {
+        av_log(avctx, AV_LOG_ERROR, "The device has no %s frames.\n", av_get_pix_fmt_name(s->format));
+        return AVERROR(EINVAL);
+    }
+    return 0;
+}
+
+static av_cold void scale_henge_uninit(AVFilterContext *avctx)
+{
+    ScaleHengeContext *s = avctx->priv;
+    hv_reply_free(&s->reply);
+}
+
+static uint32_t code_point(int v)
+{
+    return v > 0 && v <= 255 && v != 2 ? (uint32_t)v : 0;
+}
+
+static int scale_henge_filter_frame(AVFilterLink *link, AVFrame *in)
+{
+    AVFilterContext *ctx = link->dst;
+    ScaleHengeContext *s = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    FilterLink *outl = ff_filter_link(outlink);
+    AVHWFramesContext *out_frames = (AVHWFramesContext *)outl->hw_frames_ctx->data;
+    AVHengeDeviceContext *dev = out_frames->device_ctx->hwctx;
+    HvVcXfer x;
+    HvVcFrameReply fr;
+    AVFrame *out = NULL;
+    int ret, st;
+
+    memset(&x, 0, sizeof(x));
+    x.src       = av_henge_frame_handle(in);
+    x.width     = outlink->w;
+    x.height    = outlink->h;
+    x.format    = av_henge_format_from_pix_fmt(out_frames->sw_format);
+    x.range     = s->range == AVCOL_RANGE_JPEG ? HV_VC_RANGE_FULL : HV_VC_RANGE_VIDEO;
+    x.primaries = code_point(s->primaries);
+    x.transfer  = code_point(s->transfer);
+    x.matrix    = code_point(s->matrix);
+    x.flags     = s->letterbox ? 1 : 0;
+    st = hv_call(dev->client, HV_VC_XFER, &x, sizeof(x), NULL, 0, &s->reply);
+    if (st || s->reply.len < sizeof(fr)) {
+        av_log(ctx, AV_LOG_ERROR, "XFER: %s\n", st ? s->reply.err : "short reply");
+        ret = st == HV_VC_E_LIMIT ? AVERROR(ENOBUFS) : AVERROR(EIO);
+        goto fail;
+    }
+    memcpy(&fr, s->reply.data, sizeof(fr));
+    out = av_frame_alloc();
+    if (!out) {
+        hv_frame_free(dev->client, fr.handle);
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    if ((ret = av_henge_frame_wrap(outl->hw_frames_ctx, fr.handle, fr.width, fr.height, out)) < 0)
+        goto fail;
+    if ((ret = av_frame_copy_props(out, in)) < 0)
+        goto fail;
+    out->crop_left = out->crop_top = out->crop_right = out->crop_bottom = 0;
+    if (out->width != in->width || out->height != in->height)
+        av_frame_side_data_remove_by_props(&out->side_data, &out->nb_side_data, AV_SIDE_DATA_PROP_SIZE_DEPENDENT);
+    av_reduce(&out->sample_aspect_ratio.num, &out->sample_aspect_ratio.den,
+              (int64_t)in->sample_aspect_ratio.num * outlink->h * link->w,
+              (int64_t)in->sample_aspect_ratio.den * outlink->w * link->h, INT_MAX);
+    if (s->primaries)
+        out->color_primaries = s->primaries;
+    if (s->transfer)
+        out->color_trc = s->transfer;
+    if (s->matrix)
+        out->colorspace = s->matrix;
+    out->color_range = s->range == AVCOL_RANGE_JPEG ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+    av_frame_free(&in);
+    return ff_filter_frame(outlink, out);
+
+fail:
+    av_frame_free(&in);
+    av_frame_free(&out);
+    return ret;
+}
+
+static int scale_henge_config_output(AVFilterLink *outlink)
+{
+    AVFilterContext *avctx = outlink->src;
+    ScaleHengeContext *s = avctx->priv;
+    AVFilterLink *inlink = avctx->inputs[0];
+    FilterLink *inl = ff_filter_link(inlink);
+    FilterLink *outl = ff_filter_link(outlink);
+    AVHWFramesContext *in_frames, *out_frames;
+    int err;
+
+    if (!inl->hw_frames_ctx) {
+        av_log(avctx, AV_LOG_ERROR, "scale_henge needs henge frames: use -hwaccel henge -hwaccel_output_format henge, or hwupload.\n");
+        return AVERROR(EINVAL);
+    }
+    in_frames = (AVHWFramesContext *)inl->hw_frames_ctx->data;
+    if (in_frames->device_ctx->type != AV_HWDEVICE_TYPE_HENGE)
+        return AVERROR(EINVAL);
+
+    err = ff_scale_eval_dimensions(s, s->w_expr, s->h_expr, inlink, outlink, &s->output_width, &s->output_height);
+    if (err < 0)
+        return err;
+    err = ff_scale_adjust_dimensions(inlink, &s->output_width, &s->output_height, SCALE_FORCE_OAR_DISABLE, 2, 1.f);
+    if (err < 0)
+        return err;
+    outlink->w = s->output_width;
+    outlink->h = s->output_height;
+    if (inlink->sample_aspect_ratio.num) {
+        AVRational r = { outlink->h * inlink->w, outlink->w * inlink->h };
+        outlink->sample_aspect_ratio = av_mul_q(r, inlink->sample_aspect_ratio);
+    } else {
+        outlink->sample_aspect_ratio = inlink->sample_aspect_ratio;
+    }
+    s->range = inlink->color_range == AVCOL_RANGE_JPEG ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+
+    av_buffer_unref(&outl->hw_frames_ctx);
+    outl->hw_frames_ctx = av_hwframe_ctx_alloc(in_frames->device_ref);
+    if (!outl->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+    out_frames = (AVHWFramesContext *)outl->hw_frames_ctx->data;
+    out_frames->format    = AV_PIX_FMT_HENGE;
+    out_frames->sw_format = s->format != AV_PIX_FMT_NONE ? s->format : in_frames->sw_format;
+    out_frames->width     = outlink->w;
+    out_frames->height    = outlink->h;
+    ((AVHengeFramesContext *)out_frames->hwctx)->color_range = s->range;
+    err = ff_filter_init_hw_frames(avctx, outlink, 1);
+    if (err < 0)
+        return err;
+    err = av_hwframe_ctx_init(outl->hw_frames_ctx);
+    if (err < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Cannot make the henge frames context: %s\n", av_err2str(err));
+        return err;
+    }
+    return 0;
+}
+
+#define OFFSET(x) offsetof(ScaleHengeContext, x)
+#define FLAGS (AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_VIDEO_PARAM)
+static const AVOption scale_henge_options[] = {
+    { "w", "Output video width", OFFSET(w_expr), AV_OPT_TYPE_STRING, { .str = "iw" }, .flags = FLAGS },
+    { "h", "Output video height", OFFSET(h_expr), AV_OPT_TYPE_STRING, { .str = "ih" }, .flags = FLAGS },
+    { "format", "Output pixel format (nv12, p010le, nv16, p210le, nv24, p410le, bgra)", OFFSET(format),
+      AV_OPT_TYPE_PIXEL_FMT, { .i64 = AV_PIX_FMT_NONE }, -1, INT_MAX, .flags = FLAGS },
+    { "letterbox", "Keep the aspect ratio inside the output size", OFFSET(letterbox), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, FLAGS },
+    { "color_matrix", "Output colour matrix", OFFSET(matrix_string), AV_OPT_TYPE_STRING, { .str = NULL }, .flags = FLAGS },
+    { "color_primaries", "Output colour primaries", OFFSET(primaries_string), AV_OPT_TYPE_STRING, { .str = NULL }, .flags = FLAGS },
+    { "color_transfer", "Output transfer characteristics", OFFSET(transfer_string), AV_OPT_TYPE_STRING, { .str = NULL }, .flags = FLAGS },
+    { NULL },
+};
+
+AVFILTER_DEFINE_CLASS(scale_henge);
+
+static const AVFilterPad scale_henge_inputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .filter_frame = &scale_henge_filter_frame,
+    },
+};
+
+static const AVFilterPad scale_henge_outputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .config_props = &scale_henge_config_output,
+    },
+};
+
+const FFFilter ff_vf_scale_henge = {
+    .p.name         = "scale_henge",
+    .p.description  = NULL_IF_CONFIG_SMALL("Scale and convert henge frames on the device"),
+    .p.priv_class   = &scale_henge_class,
+    .p.flags        = AVFILTER_FLAG_HWDEVICE,
+    .priv_size      = sizeof(ScaleHengeContext),
+    .init           = scale_henge_init,
+    .uninit         = scale_henge_uninit,
+    FILTER_INPUTS(scale_henge_inputs),
+    FILTER_OUTPUTS(scale_henge_outputs),
+    FILTER_SINGLE_PIXFMT(AV_PIX_FMT_HENGE),
+    .flags_internal = FF_FILTER_FLAG_HWFRAME_AWARE,
+};
