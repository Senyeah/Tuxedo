diff --git a/libavcodec/henge.c b/libavcodec/henge.c
new file mode 100644
index 00000000..df6f5231
--- /dev/null
+++ b/libavcodec/henge.c
@@ -0,0 +1,508 @@
+/*
+ * Henge hardware decoding: -hwaccel henge for H.264, HEVC, AV1 and VP9
+ *
+ * FFmpeg parses the stream and keeps the frame order; the device under the
+ * Henge virtual machine decodes each frame, and the picture stays there as a
+ * host frame. The parameter set code follows videotoolbox.c.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config_components.h"
+
+#include <hvcodec.h>
+
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_henge.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "libavutil/pixdesc.h"
+
+#include "avcodec.h"
+#include "decode.h"
+#include "hwaccel_internal.h"
+#include "internal.h"
+#if CONFIG_H264_HENGE_HWACCEL
+#include "h264dec.h"
+#endif
+#if CONFIG_HEVC_HENGE_HWACCEL
+#include "hevc/hevcdec.h"
+#endif
+#include "henge.h"
+
+int ff_henge_bitstream_append(HengeDecContext *ctx, const uint8_t *buf, uint32_t size, int length_prefix)
+{
+    uint64_t need = (uint64_t)ctx->bitstream_size + size + (length_prefix ? 4 : 0);
+    uint8_t *tmp;
+    if (need > HV_VC_MAX_BITSTREAM)
+        return AVERROR(ENOMEM);
+    tmp = av_fast_realloc(ctx->bitstream, &ctx->allocated_size, need);
+    if (!tmp)
+        return AVERROR(ENOMEM);
+    ctx->bitstream = tmp;
+    if (length_prefix) {
+        AV_WB32(ctx->bitstream + ctx->bitstream_size, size);
+        ctx->bitstream_size += 4;
+    }
+    memcpy(ctx->bitstream + ctx->bitstream_size, buf, size);
+    ctx->bitstream_size += size;
+    return 0;
+}
+
+static enum AVPixelFormat henge_sw_format(AVCodecContext *avctx)
+{
+    const AVPixFmtDescriptor *d = av_pix_fmt_desc_get(avctx->sw_pix_fmt);
+    int depth;
+    if (!d)
+        return AV_PIX_FMT_NV12;
+    depth = d->comp[0].depth;
+    if (d->log2_chroma_w == 0)
+        return depth > 8 ? AV_PIX_FMT_P410LE : AV_PIX_FMT_NV24;
+    if (d->log2_chroma_h == 0)
+        return depth > 8 ? AV_PIX_FMT_P210LE : AV_PIX_FMT_NV16;
+    return depth > 8 ? AV_PIX_FMT_P010LE : AV_PIX_FMT_NV12;
+}
+
+int ff_henge_frame_params(AVCodecContext *avctx, AVBufferRef *hw_frames_ctx)
+{
+    AVHWFramesContext *frames = (AVHWFramesContext *)hw_frames_ctx->data;
+    /* the host gives display-size frames: the decoder crops them */
+    frames->format    = AV_PIX_FMT_HENGE;
+    frames->width     = avctx->width;
+    frames->height    = avctx->height;
+    frames->sw_format = henge_sw_format(avctx);
+    ((AVHengeFramesContext *)frames->hwctx)->color_range = avctx->color_range;
+    return 0;
+}
+
+static int henge_postproc(void *logctx, AVFrame *frame)
+{
+    AVHengeFrame *hf = (AVHengeFrame *)frame->buf[0]->data;
+    if (!hf->handle) {
+        av_log(logctx, AV_LOG_ERROR, "The device gave no picture for this frame.\n");
+        av_frame_unref(frame);
+        return AVERROR_EXTERNAL;
+    }
+    frame->crop_left = frame->crop_right = frame->crop_top = frame->crop_bottom = 0;
+    frame->data[3] = (uint8_t *)(uintptr_t)hf->handle;
+    if (hf->hw_frames_ref) {
+        av_buffer_unref(&frame->hw_frames_ctx);
+        frame->hw_frames_ctx = av_buffer_ref(hf->hw_frames_ref);
+        if (!frame->hw_frames_ctx)
+            return AVERROR(ENOMEM);
+    }
+    return 0;
+}
+
+int ff_henge_alloc_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    HengeDecContext *ctx = avctx->internal->hwaccel_priv_data;
+    AVHWFramesContext *frames = (AVHWFramesContext *)ctx->frames_ref->data;
+    FrameDecodeData *fdd;
+    AVHengeFrame *hf;
+    int ret = ff_attach_decode_data(avctx, frame);
+    if (ret < 0)
+        return ret;
+    frame->buf[0] = av_henge_frame_ref_alloc(frames->device_ref);
+    if (!frame->buf[0])
+        return AVERROR(ENOMEM);
+    hf = (AVHengeFrame *)frame->buf[0]->data;
+    hf->hw_frames_ref = av_buffer_ref(ctx->frames_ref);
+    if (!hf->hw_frames_ref)
+        return AVERROR(ENOMEM);
+    fdd = frame->private_ref;
+    fdd->hwaccel_priv_post_process = henge_postproc;
+    frame->width  = avctx->width;
+    frame->height = avctx->height;
+    frame->format = avctx->pix_fmt;
+    return 0;
+}
+
+/* ---- parameter sets, as videotoolbox.c ---- */
+
+static int escape_ps(uint8_t *dst, const uint8_t *src, int src_size)
+{
+    int size = src_size;
+    uint8_t *p = dst;
+    for (int i = 0; i < src_size; i++) {
+        if (i + 2 < src_size && src[i] == 0x00 && src[i + 1] == 0x00 && src[i + 2] <= 0x03) {
+            if (dst) {
+                *p++ = src[i++];
+                *p++ = src[i];
+                *p++ = 0x03;
+            } else {
+                i++;
+            }
+            size++;
+        } else if (dst) {
+            *p++ = src[i];
+        }
+    }
+    return size;
+}
+
+#if CONFIG_H264_HENGE_HWACCEL
+static uint8_t *avcc_create(AVCodecContext *avctx, int *size)
+{
+    H264Context *h = avctx->priv_data;
+    int sps_size, pps_size;
+    uint8_t *buf, *p;
+    if (!h->ps.sps || !h->ps.pps)
+        return NULL;
+    sps_size = escape_ps(NULL, h->ps.sps->data, h->ps.sps->data_size);
+    pps_size = escape_ps(NULL, h->ps.pps->data, h->ps.pps->data_size);
+    *size = 6 + 2 + sps_size + 3 + pps_size;
+    buf = av_malloc(*size);
+    if (!buf)
+        return NULL;
+    p = buf;
+    p[0] = 1;
+    p[1] = h->ps.sps->data[1];
+    p[2] = h->ps.sps->data[2];
+    p[3] = h->ps.sps->data[3];
+    p[4] = 0xff; /* 4-byte lengths */
+    p[5] = 0xe1;
+    AV_WB16(p + 6, sps_size);
+    p += 8;
+    p += escape_ps(p, h->ps.sps->data, h->ps.sps->data_size);
+    p[0] = 1;
+    AV_WB16(p + 1, pps_size);
+    p += 3;
+    escape_ps(p, h->ps.pps->data, h->ps.pps->data_size);
+    return buf;
+}
+#endif
+
+#if CONFIG_HEVC_HENGE_HWACCEL
+static uint8_t *hvcc_create(AVCodecContext *avctx, int *out_size)
+{
+    HEVCContext *h = avctx->priv_data;
+    int num_vps = 0, num_sps = 0, num_pps = 0;
+    const HEVCPPS *pps = h->pps;
+    const HEVCSPS *sps;
+    const HEVCVPS *vps;
+    PTLCommon ptlc;
+    VUI vui;
+    uint8_t parallelismType;
+    uint8_t *buf, *p;
+    int size = 23 + 3 + 3 + 3;
+
+    if (!pps)
+        return NULL;
+    sps = pps->sps;
+    vps = sps->vps;
+    ptlc = vps->ptl.general_ptl;
+    vui = sps->vui;
+
+#define COUNT_SIZE_PS(T, t) \
+    for (int i = 0; i < HEVC_MAX_##T##PS_COUNT; i++) { \
+        if (h->ps.t##ps_list[i]) { \
+            const HEVC##T##PS *lps = h->ps.t##ps_list[i]; \
+            size += 2 + escape_ps(NULL, lps->data, lps->data_size); \
+            num_##t##ps++; \
+        } \
+    }
+    COUNT_SIZE_PS(V, v)
+    COUNT_SIZE_PS(S, s)
+    COUNT_SIZE_PS(P, p)
+
+    buf = av_malloc(size);
+    if (!buf)
+        return NULL;
+    p = buf;
+    p[0] = 1;
+    p[1] = ptlc.profile_space << 6 | ptlc.tier_flag << 5 | ptlc.profile_idc;
+    for (int i = 0; i < 4; i++)
+        p[2 + i] = ptlc.profile_compatibility_flag[i * 8] << 7 |
+                   ptlc.profile_compatibility_flag[i * 8 + 1] << 6 |
+                   ptlc.profile_compatibility_flag[i * 8 + 2] << 5 |
+                   ptlc.profile_compatibility_flag[i * 8 + 3] << 4 |
+                   ptlc.profile_compatibility_flag[i * 8 + 4] << 3 |
+                   ptlc.profile_compatibility_flag[i * 8 + 5] << 2 |
+                   ptlc.profile_compatibility_flag[i * 8 + 6] << 1 |
+                   ptlc.profile_compatibility_flag[i * 8 + 7];
+    p[6] = ptlc.progressive_source_flag << 7 | ptlc.interlaced_source_flag << 6 |
+           ptlc.non_packed_constraint_flag << 5 | ptlc.frame_only_constraint_flag << 4;
+    p[7] = 0;
+    AV_WN32(p + 8, 0);
+    p[12] = ptlc.level_idc;
+    p[13] = 0xf0 | (vui.min_spatial_segmentation_idc >> 4);
+    p[14] = vui.min_spatial_segmentation_idc & 0xff;
+    if (!vui.min_spatial_segmentation_idc)
+        parallelismType = 0;
+    else if (pps->entropy_coding_sync_enabled_flag && pps->tiles_enabled_flag)
+        parallelismType = 0;
+    else if (pps->entropy_coding_sync_enabled_flag)
+        parallelismType = 3;
+    else if (pps->tiles_enabled_flag)
+        parallelismType = 2;
+    else
+        parallelismType = 1;
+    p[15] = 0xfc | parallelismType;
+    p[16] = sps->chroma_format_idc | 0xfc;
+    p[17] = (sps->bit_depth - 8) | 0xf8;
+    p[18] = (sps->bit_depth_chroma - 8) | 0xf8;
+    AV_WB16(p + 19, 0);
+    p[21] = sps->max_sub_layers << 3 | sps->temporal_id_nesting << 2 | 3;
+    p[22] = 3;
+    p += 23;
+
+#define APPEND_PS(T, t) \
+    p[0] = 1 << 7 | (HEVC_NAL_##T##PS & 0x3f); \
+    AV_WB16(p + 1, num_##t##ps); \
+    p += 3; \
+    for (int i = 0; i < HEVC_MAX_##T##PS_COUNT; i++) { \
+        if (h->ps.t##ps_list[i]) { \
+            const HEVC##T##PS *lps = h->ps.t##ps_list[i]; \
+            int n = escape_ps(p + 2, lps->data, lps->data_size); \
+            AV_WB16(p, n); \
+            p += 2 + n; \
+        } \
+    }
+    APPEND_PS(V, v)
+    APPEND_PS(S, s)
+    APPEND_PS(P, p)
+
+    *out_size = size;
+    return buf;
+}
+#endif
+
+
+
+/* ---- the session ---- */
+
+static uint32_t henge_codec(enum AVCodecID id)
+{
+    switch (id) {
+    case AV_CODEC_ID_H264: return HV_VC_H264;
+    case AV_CODEC_ID_HEVC: return HV_VC_HEVC;
+    case AV_CODEC_ID_AV1:  return HV_VC_AV1;
+    case AV_CODEC_ID_VP9:  return HV_VC_VP9;
+    default:               return 0;
+    }
+}
+
+int ff_henge_uninit(AVCodecContext *avctx)
+{
+    HengeDecContext *ctx = avctx->internal->hwaccel_priv_data;
+    if (!ctx)
+        return 0;
+    if (ctx->open && ctx->client) {
+        HvVcSession m = { ctx->session, 0 };
+        hv_call(ctx->client, HV_VC_DEC_CLOSE, &m, sizeof(m), NULL, 0, NULL);
+    }
+    ctx->open = 0;
+    hv_reply_free(&ctx->reply);
+    av_freep(&ctx->bitstream);
+    ctx->allocated_size = ctx->bitstream_size = 0;
+    av_buffer_unref(&ctx->frames_ref);
+    return 0;
+}
+
+int ff_henge_init(AVCodecContext *avctx)
+{
+    HengeDecContext *ctx = avctx->internal->hwaccel_priv_data;
+    AVHWFramesContext *frames;
+    AVHengeDeviceContext *dev;
+    const HvVcDecoderInfo *info;
+    uint32_t codec = henge_codec(avctx->codec_id);
+    uint8_t *extra = NULL;
+    int extra_size = 0, st, err;
+    HvVcDecOpen o;
+    HvVcOpenReply r;
+    char cc[5];
+
+    if (!avctx->hw_frames_ctx && !avctx->hw_device_ctx) {
+        av_log(avctx, AV_LOG_ERROR, "Either hw_frames_ctx or hw_device_ctx must be set.\n");
+        return AVERROR(EINVAL);
+    }
+    if (!avctx->hw_frames_ctx) {
+        avctx->hw_frames_ctx = av_hwframe_ctx_alloc(avctx->hw_device_ctx);
+        if (!avctx->hw_frames_ctx)
+            return AVERROR(ENOMEM);
+        ff_henge_frame_params(avctx, avctx->hw_frames_ctx);
+        err = av_hwframe_ctx_init(avctx->hw_frames_ctx);
+        if (err < 0) {
+            av_buffer_unref(&avctx->hw_frames_ctx);
+            return err;
+        }
+    }
+    frames = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+    if (frames->device_ctx->type != AV_HWDEVICE_TYPE_HENGE || frames->format != AV_PIX_FMT_HENGE)
+        return AVERROR(EINVAL);
+    ctx->frames_ref = av_buffer_ref(avctx->hw_frames_ctx);
+    if (!ctx->frames_ref)
+        return AVERROR(ENOMEM);
+    dev = frames->device_ctx->hwctx;
+    ctx->client = dev->client;
+
+    hv_fourcc_str(codec, cc);
+    info = codec ? hv_query_decoder(dev->query, codec) : NULL;
+    if (!info) {
+        av_log(avctx, AV_LOG_WARNING, "The device has no %s decoder: decoding in software.\n", cc);
+        ff_henge_uninit(avctx);
+        return AVERROR(ENOSYS);
+    }
+
+    switch (avctx->codec_id) {
+#if CONFIG_H264_HENGE_HWACCEL
+    case AV_CODEC_ID_H264: extra = avcc_create(avctx, &extra_size); break;
+#endif
+#if CONFIG_HEVC_HENGE_HWACCEL
+    case AV_CODEC_ID_HEVC: extra = hvcc_create(avctx, &extra_size); break;
+#endif
+#if CONFIG_AV1_HENGE_HWACCEL
+    case AV_CODEC_ID_AV1:  extra = ff_henge_av1c_create(avctx, &extra_size); break;
+#endif
+#if CONFIG_VP9_HENGE_HWACCEL
+    case AV_CODEC_ID_VP9:  extra = ff_henge_vpcc_create(avctx, &extra_size); break;
+#endif
+    default: break;
+    }
+    if (!extra || extra_size > HV_VC_MAX_EXTRADATA) {
+        av_free(extra);
+        av_log(avctx, AV_LOG_WARNING, "No %s parameter sets for the device: decoding in software.\n", cc);
+        ff_henge_uninit(avctx);
+        return AVERROR(ENOSYS);
+    }
+
+    memset(&o, 0, sizeof(o));
+    o.codec         = codec;
+    o.width         = avctx->width;
+    o.height        = avctx->height;
+    o.format        = av_henge_format_from_pix_fmt(frames->sw_format);
+    o.range         = avctx->color_range == AVCOL_RANGE_JPEG ? HV_VC_RANGE_FULL : HV_VC_RANGE_VIDEO;
+    o.extradata_len = extra_size;
+    st = hv_call(ctx->client, HV_VC_DEC_OPEN, &o, sizeof(o), extra, extra_size, &ctx->reply);
+    av_free(extra);
+    if (st || ctx->reply.len < sizeof(r)) {
+        av_log(avctx, AV_LOG_WARNING, "The device refused this %s stream (%s): decoding in software.\n",
+               cc, st ? ctx->reply.err : "short reply");
+        ff_henge_uninit(avctx);
+        return st == HV_CLIENT_E_IO ? AVERROR(EIO) : AVERROR(ENOSYS);
+    }
+    memcpy(&r, ctx->reply.data, sizeof(r));
+    ctx->session = r.session;
+    ctx->open = 1;
+    ctx->bitstream_size = 0;
+    av_log(avctx, AV_LOG_VERBOSE, "Henge %s decoder %ux%u %s (%s)\n", cc, o.width, o.height,
+           av_get_pix_fmt_name(frames->sw_format), r.flags & HV_VC_DEC_HW ? "hardware" : "software");
+    return 0;
+}
+
+int ff_henge_end_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    HengeDecContext *ctx = avctx->internal->hwaccel_priv_data;
+    AVHengeFrame *hf;
+    HvVcDecFrame d;
+    HvVcFrameReply fr;
+    int st;
+
+    if (!ctx->open || !ctx->bitstream_size || !frame || !frame->buf[0] || frame->buf[0]->size != sizeof(AVHengeFrame))
+        return AVERROR_INVALIDDATA;
+    hf = (AVHengeFrame *)frame->buf[0]->data;
+    /* the host matches each picture to its request by this number */
+    d.session  = ctx->session;
+    d.flags    = 0;
+    d.pts      = ctx->counter++;
+    d.duration = 0;
+    st = hv_call(ctx->client, HV_VC_DEC_FRAME, &d, sizeof(d), ctx->bitstream, ctx->bitstream_size, &ctx->reply);
+    ctx->bitstream_size = 0;
+    if (st) {
+        av_log(avctx, AV_LOG_ERROR, "DEC_FRAME: %s%s\n", ctx->reply.err,
+               st == HV_VC_E_LIMIT ? " (too many frames are live on the device; fewer decoder threads, -threads 1, keep fewer)" : "");
+        return st == HV_CLIENT_E_IO ? AVERROR(EIO) : AVERROR_EXTERNAL;
+    }
+    if (ctx->reply.len < sizeof(fr))
+        return AVERROR_EXTERNAL;
+    memcpy(&fr, ctx->reply.data, sizeof(fr));
+    if (!fr.handle)
+        return 0; /* no picture: postproc refuses the frame if it is ever shown */
+    if (hf->handle) /* a second field */
+        hv_frame_free(ctx->client, hf->handle);
+    hf->handle = fr.handle;
+    hf->width  = fr.width;
+    hf->height = fr.height;
+    return 0;
+}
+
+/* NAL units with 4-byte lengths, as the avcC and hvcC above declare. */
+static int henge_nal_decode_slice(AVCodecContext *avctx, const uint8_t *buf, uint32_t size)
+{
+    return ff_henge_bitstream_append(avctx->internal->hwaccel_priv_data, buf, size, 1);
+}
+
+static int henge_nal_decode_params(AVCodecContext *avctx, int type, const uint8_t *buf, uint32_t size)
+{
+    return ff_henge_bitstream_append(avctx->internal->hwaccel_priv_data, buf, size, 1);
+}
+
+int ff_henge_start_frame_noop(AVCodecContext *avctx, const AVBufferRef *buf_ref,
+                                  const uint8_t *buf, uint32_t size)
+{
+    return 0;
+}
+
+#if CONFIG_H264_HENGE_HWACCEL
+static int henge_h264_end_frame(AVCodecContext *avctx)
+{
+    H264Context *h = avctx->priv_data;
+    return ff_henge_end_frame(avctx, h->cur_pic_ptr->f);
+}
+
+const FFHWAccel ff_h264_henge_hwaccel = {
+    .p.name         = "h264_henge",
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_H264,
+    .p.pix_fmt      = AV_PIX_FMT_HENGE,
+    .alloc_frame    = ff_henge_alloc_frame,
+    .start_frame    = ff_henge_start_frame_noop,
+    .decode_slice   = henge_nal_decode_slice,
+    .decode_params  = henge_nal_decode_params,
+    .end_frame      = henge_h264_end_frame,
+    .frame_params   = ff_henge_frame_params,
+    .init           = ff_henge_init,
+    .uninit         = ff_henge_uninit,
+    .priv_data_size = sizeof(HengeDecContext),
+};
+#endif
+
+#if CONFIG_HEVC_HENGE_HWACCEL
+static int henge_hevc_end_frame(AVCodecContext *avctx)
+{
+    HEVCContext *h = avctx->priv_data;
+    return ff_henge_end_frame(avctx, h->cur_frame->f);
+}
+
+const FFHWAccel ff_hevc_henge_hwaccel = {
+    .p.name         = "hevc_henge",
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_HEVC,
+    .p.pix_fmt      = AV_PIX_FMT_HENGE,
+    .alloc_frame    = ff_henge_alloc_frame,
+    .start_frame    = ff_henge_start_frame_noop,
+    .decode_slice   = henge_nal_decode_slice,
+    .decode_params  = henge_nal_decode_params,
+    .end_frame      = henge_hevc_end_frame,
+    .frame_params   = ff_henge_frame_params,
+    .init           = ff_henge_init,
+    .uninit         = ff_henge_uninit,
+    .priv_data_size = sizeof(HengeDecContext),
+};
+#endif
+
