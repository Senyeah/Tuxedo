+#ifndef AVCODEC_HENGE_H
+#define AVCODEC_HENGE_H
+
+#include <hvcodec.h>
+
+#include "avcodec.h"
+
+typedef struct HengeDecContext {
+    AVBufferRef *frames_ref;
+    HvClient *client;
+    uint32_t session;
+    int open;
+    uint8_t *bitstream;
+    unsigned bitstream_size, allocated_size;
+    int64_t counter;
+    HvReply reply;
+} HengeDecContext;
+
+int ff_henge_bitstream_append(HengeDecContext *ctx, const uint8_t *buf, uint32_t size, int length_prefix);
+int ff_henge_frame_params(AVCodecContext *avctx, AVBufferRef *hw_frames_ctx);
+int ff_henge_alloc_frame(AVCodecContext *avctx, AVFrame *frame);
+int ff_henge_init(AVCodecContext *avctx);
+int ff_henge_uninit(AVCodecContext *avctx);
