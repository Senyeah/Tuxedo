+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "av1dec.h"
+#include "libavutil/hwcontext_henge.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "libavutil/pixdesc.h"
+
+#include "hwaccel_internal.h"
+#include "internal.h"
+#include "henge.h"
+
+uint8_t *ff_henge_av1c_create(AVCodecContext *avctx, int *size)
+{
+    AV1DecContext *s = avctx->priv_data;
+    uint8_t *buf;
+    if (!s->raw_seq || !s->seq_data_ref)
+        return NULL;
+    *size = s->seq_data_ref->size + 4;
+    buf = av_malloc(*size);
+    if (!buf)
+        return NULL;
+    buf[0] = 0x81;
+    buf[1] = s->raw_seq->seq_profile << 5 | s->raw_seq->seq_level_idx[0];
+    buf[2] = s->raw_seq->seq_tier[0] << 7 |
+             s->raw_seq->color_config.high_bitdepth << 6 |
+             s->raw_seq->color_config.twelve_bit << 5 |
+             s->raw_seq->color_config.mono_chrome << 4 |
+             s->raw_seq->color_config.subsampling_x << 3 |
+             s->raw_seq->color_config.subsampling_y << 2 |
+             s->raw_seq->color_config.chroma_sample_position;
+    buf[3] = s->raw_seq->initial_display_delay_present_flag ?
+             1 << 4 | s->raw_seq->initial_display_delay_minus_1[0] : 0;
+    memcpy(buf + 4, s->seq_data_ref->data, s->seq_data_ref->size);
+    return buf;
+}
+
+static int henge_av1_decode_slice(AVCodecContext *avctx, const uint8_t *buf, uint32_t size)
+{
+    return 0;
+}
+
+static int henge_av1_end_frame(AVCodecContext *avctx)
+{
+    const AV1DecContext *s = avctx->priv_data;
+    HengeDecContext *ctx = avctx->internal->hwaccel_priv_data;
+    int ret;
+    ctx->bitstream_size = 0;
+    for (int i = s->start_unit; i < s->nb_unit; i++) {
+        ret = ff_henge_bitstream_append(ctx, s->current_obu.units[i].data, s->current_obu.units[i].data_size, 0);
+        if (ret < 0)
+            return ret;
+    }
+    return ff_henge_end_frame(avctx, s->cur_frame.f);
+}
+
+const FFHWAccel ff_av1_henge_hwaccel = {
+    .p.name         = "av1_henge",
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_AV1,
+    .p.pix_fmt      = AV_PIX_FMT_HENGE,
+    .alloc_frame    = ff_henge_alloc_frame,
+    .start_frame    = ff_henge_start_frame_noop,
+    .decode_slice   = henge_av1_decode_slice,
+    .end_frame      = henge_av1_end_frame,
+    .frame_params   = ff_henge_frame_params,
+    .init           = ff_henge_init,
+    .uninit         = ff_henge_uninit,
+    .priv_data_size = sizeof(HengeDecContext),
+};
