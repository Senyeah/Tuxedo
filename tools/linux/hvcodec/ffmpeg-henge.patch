+#ifndef AVUTIL_HWCONTEXT_HENGE_H
+#define AVUTIL_HWCONTEXT_HENGE_H
+
+/**
+ * @file
+ * An API-specific header for AV_HWDEVICE_TYPE_HENGE: the video codecs of the
+ * device that runs a Henge virtual machine, reached through libhvcodec.
+ *
+ * Frames of AV_PIX_FMT_HENGE stay on the device. data[3] holds the frame's
+ * handle (a uint32_t cast to a pointer); buf[0] holds an AVHengeFrame and
+ * frees the handle when the last reference goes. A handle is good only on
+ * the connection of the device context that made it.
+ *
+ * The device string is "unix:PATH", "HOST:PORT" or "HOST"; an empty one
+ * takes $HENGE_VCODEC, then 10.0.2.4:8470.
+ */
+
+#include <stdint.h>
+
+#include "buffer.h"
+#include "frame.h"
+#include "pixfmt.h"
+
+struct HvClient;
+struct HvQuery;
+
+typedef struct AVHengeDeviceContext {
+    /** The connection. All calls on it are thread-safe. */
+    struct HvClient *client;
+    /** The device's codec table, read when the device was made. */
+    const struct HvQuery *query;
+} AVHengeDeviceContext;
+
+/** AVHWFramesContext.hwctx: the range of frames that are uploaded. */
+typedef struct AVHengeFramesContext {
+    enum AVColorRange color_range;
+} AVHengeFramesContext;
+
+/** The data of a henge frame's buf[0]. */
+typedef struct AVHengeFrame {
+    uint32_t handle;   ///< 0 until a decoder fills it
+    uint32_t width, height;
+    AVBufferRef *device_ref;
+    AVBufferRef *hw_frames_ref; ///< optional; a decoder keeps its frames context here
+} AVHengeFrame;
+
+/**
+ * A buffer that holds an AVHengeFrame with no handle yet, and frees the
+ * handle when the last reference goes.
+ */
+AVBufferRef *av_henge_frame_ref_alloc(AVBufferRef *device_ref);
+
+/**
+ * Makes frame a henge frame of hw_frames_ref for an existing handle. On
+ * failure the handle is freed.
+ */
+int av_henge_frame_wrap(AVBufferRef *hw_frames_ref, uint32_t handle,
+                        uint32_t width, uint32_t height, AVFrame *frame);
+
+static inline uint32_t av_henge_frame_handle(const AVFrame *frame)
+{
+    return (uint32_t)(uintptr_t)frame->data[3];
+}
+
+/** The libhvcodec format for a software pixel format, or 0. */
+uint32_t av_henge_format_from_pix_fmt(enum AVPixelFormat fmt);
+enum AVPixelFormat av_henge_format_to_pix_fmt(uint32_t fmt);
+
+#endif /* AVUTIL_HWCONTEXT_HENGE_H */
