+    { "main",      "Main Profile",                0, AV_OPT_TYPE_CONST, { .i64 = AV_PROFILE_HEVC_MAIN },    INT_MIN, INT_MAX, VE, .unit = "profile" },
+    { "main10",    "Main10 Profile",              0, AV_OPT_TYPE_CONST, { .i64 = AV_PROFILE_HEVC_MAIN_10 }, INT_MIN, INT_MAX, VE, .unit = "profile" },
+    { "mainstill", "Main Still Picture Profile",  0, AV_OPT_TYPE_CONST, { .i64 = AV_PROFILE_HEVC_MAIN_STILL_PICTURE }, INT_MIN, INT_MAX, VE, .unit = "profile" },
+    { "main42210", "Main 4:2:2 10 Profile (or 4:4:4 from 4:4:4 input)", 0, AV_OPT_TYPE_CONST, { .i64 = AV_PROFILE_HEVC_REXT }, INT_MIN, INT_MAX, VE, .unit = "profile" },
+    { "rext",      "Range extensions: 4:2:2 or 4:4:4 from the input", 0, AV_OPT_TYPE_CONST, { .i64 = AV_PROFILE_HEVC_REXT }, INT_MIN, INT_MAX, VE, .unit = "profile" },
+    { "alpha_quality", "Compression quality for the alpha channel (bgra input)", OFFSET(alpha_quality), AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, 1.0, VE },
+    { "constant_bit_rate", "Require a constant bit rate", OFFSET(constant_bit_rate), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, VE },
+    COMMON_OPTIONS
+    { NULL },
+};
+
+static const AVOption plain_options[] = {
+    COMMON_OPTIONS
+    { NULL },
+};
+
+#define HENGE_ENCODER(short_name, long_name, codec_id, opts) \
+    static const AVClass short_name##_henge_class = { \
+        .class_name = #short_name "_henge", \
+        .item_name  = av_default_item_name, \
+        .option     = opts, \
+        .version    = LIBAVUTIL_VERSION_INT, \
+    }; \
+    const FFCodec ff_##short_name##_henge_encoder = { \
+        .p.name         = #short_name "_henge", \
+        CODEC_LONG_NAME(long_name), \
+        .p.type         = AVMEDIA_TYPE_VIDEO, \
+        .p.id           = codec_id, \
+        .p.capabilities = AV_CODEC_CAP_DELAY | AV_CODEC_CAP_HARDWARE | AV_CODEC_CAP_DR1, \
+        .priv_data_size = sizeof(HengeEncContext), \
+        CODEC_PIXFMTS_ARRAY(henge_pix_fmts), \
+        .color_ranges   = AVCOL_RANGE_MPEG | AVCOL_RANGE_JPEG, \
+        .defaults       = henge_defaults, \
+        .init           = henge_enc_init, \
+        FF_CODEC_RECEIVE_PACKET_CB(henge_receive_packet), \
+        .close          = henge_enc_close, \
+        .p.priv_class   = &short_name##_henge_class, \
+        .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP, \
+        .p.wrapper_name = "henge", \
+        .hw_configs     = henge_hw_configs, \
+    };
+
+#if CONFIG_H264_HENGE_ENCODER
+HENGE_ENCODER(h264, "Henge H.264 (the device's hardware encoder)", AV_CODEC_ID_H264, h264_options)
+#endif
+#if CONFIG_HEVC_HENGE_ENCODER
+HENGE_ENCODER(hevc, "Henge HEVC (the device's hardware encoder)", AV_CODEC_ID_HEVC, hevc_options)
+#endif
+#if CONFIG_AV1_HENGE_ENCODER
+HENGE_ENCODER(av1, "Henge AV1 (the device's hardware encoder, where it has one)", AV_CODEC_ID_AV1, plain_options)
+#endif
+#if CONFIG_MJPEG_HENGE_ENCODER
+HENGE_ENCODER(mjpeg, "Henge JPEG (the device's hardware encoder)", AV_CODEC_ID_MJPEG, plain_options)
+#endif
