+#include "vp9shared.h"
+#include "libavutil/hwcontext_henge.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "libavutil/pixdesc.h"
+
+#include "hwaccel_internal.h"
+#include "internal.h"
+#include "henge.h"
+
+uint8_t *ff_henge_vpcc_create(AVCodecContext *avctx, int *size)
+{
+    const VP9SharedContext *h = avctx->priv_data;
+    int cw, ch, sub;
+    uint8_t *buf, *p;
+    if (av_pix_fmt_get_chroma_sub_sample(avctx->sw_pix_fmt, &cw, &ch) < 0)
+        return NULL;
+    if (cw == 1 && ch == 1)
+        sub = avctx->chroma_sample_location == AVCHROMA_LOC_LEFT ? 0 : 1;
+    else if (cw == 1 && ch == 0)
+        sub = 2;
+    else if (cw == 0 && ch == 0)
+        sub = 3;
+    else
+        return NULL;
+    *size = 12;
+    buf = av_malloc(*size);
+    if (!buf)
+        return NULL;
+    p = buf;
+    *p++ = 1;
+    AV_WB24(p, 0);
+    p += 3;
+    *p++ = h->h.profile;
+    *p++ = avctx->level;
+    *p++ = (h->h.bpp << 4) | (sub << 1) | (avctx->color_range == AVCOL_RANGE_JPEG);
+    *p++ = avctx->color_primaries;
+    *p++ = avctx->color_trc;
+    *p++ = avctx->colorspace;
+    AV_WB16(p, 0);
+    return buf;
+}
+
+static int henge_vp9_decode_slice(AVCodecContext *avctx, const uint8_t *buf, uint32_t size)
+{
+    HengeDecContext *ctx = avctx->internal->hwaccel_priv_data;
+    ctx->bitstream_size = 0;
+    return ff_henge_bitstream_append(ctx, buf, size, 0);
+}
+
+static int henge_vp9_end_frame(AVCodecContext *avctx)
+{
+    const VP9SharedContext *h = avctx->priv_data;
+    return ff_henge_end_frame(avctx, h->frames[CUR_FRAME].tf.f);
+}
+
+const FFHWAccel ff_vp9_henge_hwaccel = {
+    .p.name         = "vp9_henge",
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_VP9,
+    .p.pix_fmt      = AV_PIX_FMT_HENGE,
+    .alloc_frame    = ff_henge_alloc_frame,
+    .start_frame    = ff_henge_start_frame_noop,
+    .decode_slice   = henge_vp9_decode_slice,
+    .end_frame      = henge_vp9_end_frame,
+    .frame_params   = ff_henge_frame_params,
+    .init           = ff_henge_init,
+    .uninit         = ff_henge_uninit,
+    .priv_data_size = sizeof(HengeDecContext),
+};
diff --git a/libavcodec/hengeenc.c b/libavcodec/hengeenc.c
new file mode 100644
index 00000000..6447c878
--- /dev/null
+++ b/libavcodec/hengeenc.c
@@ -0,0 +1,923 @@
+/*
+ * Henge hardware encoders: h264_henge, hevc_henge, av1_henge, mjpeg_henge
+ *
+ * The device under the Henge virtual machine encodes host frames: henge
+ * frames from -hwaccel henge or scale_henge stay on the device, and software
+ * frames are uploaded first. The option names follow videotoolboxenc.c.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config_components.h"
+
+#include <hvcodec.h>
+
+#include "libavutil/avstring.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_henge.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mastering_display_metadata.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+#include "libavutil/time.h"
+
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "encode.h"
+#include "hwconfig.h"
+#include "packet_internal.h"
+
+/* frames in the device's encoder before a wait for a packet: bounds the frames it holds */
+#define MAX_PENDING 8
+/* a deep lookahead can need more: the bound doubles up to this after STALL_MS at it with no packet */
+#define MAX_PENDING_HARD 32
+#define STALL_MS 1000
+/* one ENC_PACKET wait: the other threads on the connection wait behind it */
+#define WAIT_SLICE_MS 20
+/* no packet and no frame taken for this long: the device is stuck */
+#define GIVE_UP_MS 20000
+
+enum { PROFILE_AUTO = -99 };
+
+typedef struct HengeEncContext {
+    const AVClass *class;
+    AVBufferRef *device_ref;
+    AVBufferRef *upload_ref; /* frames context for software input */
+    HvClient *client;
+    const HvVcEncoderInfo *info;
+    uint32_t codec, format, session, timescale;
+    int open, eof_sent, annexb, length_size, oversize;
+    uint32_t ready;
+    int32_t pending, max_pending;
+    int held;            /* s->frame is taken from the queue but not yet in the device */
+    int at_limit;        /* the host refused s->frame at a limit: wait, then give it again */
+    int64_t idle_since;  /* no packet and no frame given since then; 0 after progress */
+    char limit_err[256];
+    AVFrame *frame;
+    HvReply reply;
+    uint8_t *ps;      /* Annex B parameter sets, for key frames when there is no global header */
+    int ps_size;
+    HvVcEncOpen o;
+
+    int profile, level, allow_sw, realtime, prio_speed, constant_bit_rate;
+    double alpha_quality;
+} HengeEncContext;
+
+static int status_err(int st)
+{
+    switch (st) {
+    case HV_VC_E_INVAL:   return AVERROR(EINVAL);
+    case HV_VC_E_NOSUP:   return AVERROR(ENOSYS);
+    case HV_VC_E_LIMIT:   return AVERROR(ENOBUFS);
+    case HV_VC_E_NOMEM:   return AVERROR(ENOMEM);
+    case HV_CLIENT_E_IO:  return AVERROR(EIO);
+    default:              return AVERROR_EXTERNAL;
+    }
+}
+
+/* ---- profiles ---- */
+
+static const char *h264_profile_name(int profile)
+{
+    switch (profile) {
+    case AV_PROFILE_H264_BASELINE:             return "Baseline";
+    case AV_PROFILE_H264_CONSTRAINED_BASELINE: return "ConstrainedBaseline";
+    case AV_PROFILE_H264_MAIN:                 return "Main";
+    case AV_PROFILE_H264_HIGH:                 return "High";
+    case AV_PROFILE_H264_HIGH | AV_PROFILE_H264_CONSTRAINED: return "ConstrainedHigh";
+    case AV_PROFILE_H264_HIGH_10:              return "High10";
+    case AV_PROFILE_H264_HIGH_422:             return "High422";
+    case AV_PROFILE_H264_HIGH_444_PREDICTIVE:  return "High444Predictive";
+    default:                                   return NULL;
+    }
+}
+
+/* The profile when -profile is not set, from the input format (vcodec-check.py PROFILE_RULE tests it).
+   HEVC has no 8-bit 4:2:2 profile, so nv16 gets Main 4:2:2 10. H.264 10-bit 4:2:0 is High 10 where the
+   device lists it; else High, and the output is 8 bit. bgra is the encoder's own conversion to 4:2:0. */
+static const struct {
+    enum AVPixelFormat fmt;
+    const char *h264, *h264_alt, *hevc;
+} auto_profiles[] = {
+    { AV_PIX_FMT_NV12,   "High",              NULL,   "HEVC_Main_AutoLevel" },
+    { AV_PIX_FMT_P010LE, "High10",            "High", "HEVC_Main10_AutoLevel" },
+    { AV_PIX_FMT_NV16,   "High422",           NULL,   "HEVC_Main42210_AutoLevel" },
+    { AV_PIX_FMT_P210LE, "High422",           NULL,   "HEVC_Main42210_AutoLevel" },
+    { AV_PIX_FMT_NV24,   "High444Predictive", NULL,   "HEVC_Main444_AutoLevel" },
+    { AV_PIX_FMT_P410LE, "High444Predictive", NULL,   "HEVC_Main44410_AutoLevel" },
+    { AV_PIX_FMT_BGRA,   "High",              NULL,   "HEVC_Main_AutoLevel" },
+};
+
+static int has_profile(const HvVcEncoderInfo *e, const char *name)
+{
+    for (uint32_t i = 0; i < e->n_profiles; i++)
+        if (!strcmp(e->profiles[i].name, name))
+            return 1;
+    return 0;
+}
+
+static void h264_name(char *buf, size_t size, const char *base, int level)
+{
+    if (level > 0)
+        snprintf(buf, size, "H264_%s_%d_%d", base, level / 10, level % 10);
+    else
+        snprintf(buf, size, "H264_%s_AutoLevel", base);
+}
+
+/* The device's profile name for the options, or "" for the encoder's own choice. */
+static int pick_profile(AVCodecContext *avctx, HengeEncContext *s, enum AVPixelFormat sw, char out[56])
+{
+    const HvVcEncoderInfo *e = s->info;
+    const AVPixFmtDescriptor *d = av_pix_fmt_desc_get(sw);
+    int ten = d && d->comp[0].depth > 8;
+    int c444 = d && d->log2_chroma_w == 0 && !(d->flags & AV_PIX_FMT_FLAG_RGB);
+    int profile = s->profile != PROFILE_AUTO ? s->profile : avctx->profile;
+    int automatic = profile == AV_PROFILE_UNKNOWN || profile == PROFILE_AUTO;
+    const char *name = NULL;
+    char buf[56];
+    int i;
+
+    out[0] = 0;
+    for (i = 0; i < FF_ARRAY_ELEMS(auto_profiles) && auto_profiles[i].fmt != sw; i++)
+        ;
+    if (i == FF_ARRAY_ELEMS(auto_profiles))
+        return AVERROR(EINVAL);
+    if (s->codec == HV_VC_H264) {
+        const char *base = automatic ? auto_profiles[i].h264 : h264_profile_name(profile);
+        if (!base) {
+            av_log(avctx, AV_LOG_ERROR, "The device has no such H.264 profile.\n");
+            return AVERROR(EINVAL);
+        }
+        h264_name(buf, sizeof(buf), base, s->level);
+        if (automatic && !has_profile(e, buf) && auto_profiles[i].h264_alt) {
+            av_log(avctx, AV_LOG_WARNING, "The device has no H.264 profile %s for %s input: High, with 8-bit output.\n",
+                   buf, av_get_pix_fmt_name(sw));
+            h264_name(buf, sizeof(buf), auto_profiles[i].h264_alt, s->level);
+        }
+        name = buf;
+    } else if (s->codec == HV_VC_HEVC) {
+        if (automatic)
+            name = auto_profiles[i].hevc;
+        else if (profile == AV_PROFILE_HEVC_REXT)
+            name = c444 ? (ten ? "HEVC_Main44410_AutoLevel" : "HEVC_Main444_AutoLevel") : "HEVC_Main42210_AutoLevel";
+        else if (profile == AV_PROFILE_HEVC_MAIN)
+            name = "HEVC_Main_AutoLevel";
+        else if (profile == AV_PROFILE_HEVC_MAIN_10)
+            name = "HEVC_Main10_AutoLevel";
+        else if (profile == AV_PROFILE_HEVC_MAIN_STILL_PICTURE)
+            name = "HEVC_MainStill_AutoLevel";
+        if (!name) {
+            av_log(avctx, AV_LOG_ERROR, "The device has no such HEVC profile.\n");
+            return AVERROR(EINVAL);
+        }
+    } else {
+        av_log(avctx, AV_LOG_VERBOSE, "The profile is the device's choice for this codec.\n");
+        return 0;
+    }
+    if (!has_profile(e, name)) {
+        if (automatic) {
+            av_log(avctx, AV_LOG_WARNING, "The device's encoder has no profile %s for %s input: it picks one, and can "
+                   "convert the input. henge-codec-info lists its profiles.\n", name, av_get_pix_fmt_name(sw));
+            return 0;
+        }
+        av_log(avctx, AV_LOG_ERROR, "The device's encoder has no profile %s. henge-codec-info lists its profiles.\n", name);
+        return AVERROR(ENOSYS);
+    }
+    av_strlcpy(out, name, 56);
+    return 0;
+}
+
+/* ---- HDR10 ---- */
+
+static void put16(uint8_t *p, double v)
+{
+    uint32_t x = v < 0 ? 0 : v > 65535 ? 65535 : (uint32_t)(v + 0.5);
+    AV_WB16(p, x);
+}
+
+static void put32(uint8_t *p, double v)
+{
+    uint32_t x = v < 0 ? 0 : v > 4294967295.0 ? 0xffffffffu : (uint32_t)(v + 0.5);
+    AV_WB32(p, x);
+}
+
+static void hdr10(AVCodecContext *avctx, HvVcEncOpen *o)
+{
+    const AVFrameSideData *sd = av_frame_side_data_get(avctx->decoded_side_data, avctx->nb_decoded_side_data,
+                                                       AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+    if (sd && sd->size >= sizeof(AVMasteringDisplayMetadata)) {
+        const AVMasteringDisplayMetadata *m = (const void *)sd->data;
+        if (m->has_primaries && m->has_luminance) {
+            static const int order[3] = { 1, 2, 0 }; /* the SEI is G, B, R */
+            for (int i = 0; i < 3; i++) {
+                put16(o->mastering + i * 4,     av_q2d(m->display_primaries[order[i]][0]) * 50000);
+                put16(o->mastering + i * 4 + 2, av_q2d(m->display_primaries[order[i]][1]) * 50000);
+            }
+            put16(o->mastering + 12, av_q2d(m->white_point[0]) * 50000);
+            put16(o->mastering + 14, av_q2d(m->white_point[1]) * 50000);
+            put32(o->mastering + 16, av_q2d(m->max_luminance) * 10000);
+            put32(o->mastering + 20, av_q2d(m->min_luminance) * 10000);
+            o->hdr_flags |= 1;
+        }
+    }
+    sd = av_frame_side_data_get(avctx->decoded_side_data, avctx->nb_decoded_side_data,
+                                AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
+    if (sd && sd->size >= sizeof(AVContentLightMetadata)) {
+        const AVContentLightMetadata *l = (const void *)sd->data;
+        put16(o->light, l->MaxCLL);
+        put16(o->light + 2, l->MaxFALL);
+        o->hdr_flags |= 2;
+    }
+}
+
+/* ---- parameter sets: avcC or hvcC from the host, to Annex B ---- */
+
+static int ps_append(uint8_t **buf, int *size, const uint8_t *nal, int len)
+{
+    uint8_t *n = av_realloc(*buf, *size + 4 + len + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!n)
+        return AVERROR(ENOMEM);
+    AV_WB32(n + *size, 1);
+    memcpy(n + *size + 4, nal, len);
+    memset(n + *size + 4 + len, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    *buf = n;
+    *size += 4 + len;
+    return 0;
+}
+
+static int config_to_annexb(uint32_t codec, const uint8_t *p, int len, uint8_t **out, int *out_size, int *length_size)
+{
+    const uint8_t *end = p + len;
+    int ret;
+    *out = NULL;
+    *out_size = 0;
+    if (codec == HV_VC_H264) {
+        int n;
+        if (len < 7 || p[0] != 1)
+            return AVERROR_INVALIDDATA;
+        *length_size = (p[4] & 3) + 1;
+        n = p[5] & 0x1f;
+        p += 6;
+        for (int list = 0; list < 2; list++) {
+            for (int i = 0; i < n; i++) {
+                int l;
+                if (end - p < 2)
+                    return AVERROR_INVALIDDATA;
+                l = AV_RB16(p);
+                p += 2;
+                if (end - p < l)
+                    return AVERROR_INVALIDDATA;
+                if ((ret = ps_append(out, out_size, p, l)) < 0)
+                    return ret;
+                p += l;
+            }
+            if (list == 0) {
+                if (end - p < 1)
+                    return AVERROR_INVALIDDATA;
+                n = *p++;
+            }
+        }
+        return 0;
+    }
+    if (codec == HV_VC_HEVC || codec == HV_VC_HEVC_ALPHA) {
+        int arrays;
+        if (len < 23)
+            return AVERROR_INVALIDDATA;
+        *length_size = (p[21] & 3) + 1;
+        arrays = p[22];
+        p += 23;
+        for (int a = 0; a < arrays; a++) {
+            int n;
+            if (end - p < 3)
+                return AVERROR_INVALIDDATA;
+            n = AV_RB16(p + 1);
+            p += 3;
+            for (int i = 0; i < n; i++) {
+                int l;
+                if (end - p < 2)
+                    return AVERROR_INVALIDDATA;
+                l = AV_RB16(p);
+                p += 2;
+                if (end - p < l)
+                    return AVERROR_INVALIDDATA;
+                if ((ret = ps_append(out, out_size, p, l)) < 0)
+                    return ret;
+                p += l;
+            }
+        }
+        return 0;
+    }
+    return AVERROR(ENOSYS);
+}
+
+/* Length-prefixed NAL units to Annex B, with the parameter sets before a key frame's. */
+static int packet_to_annexb(AVCodecContext *avctx, HengeEncContext *s, const uint8_t *src, size_t len, int key, AVPacket *pkt)
+{
+    const uint8_t *p = src, *end = src + len;
+    size_t out = key && s->ps_size ? s->ps_size : 0;
+    uint8_t *dst;
+    int ret;
+    /* first pass: the size */
+    while (end - p >= s->length_size) {
+        uint32_t l = 0;
+        for (int i = 0; i < s->length_size; i++)
+            l = l << 8 | p[i];
+        p += s->length_size;
+        if (l > (size_t)(end - p))
+            return AVERROR_INVALIDDATA;
+        out += 4 + l;
+        p += l;
+    }
+    if (p != end || out > INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE)
+        return AVERROR_INVALIDDATA;
+    if ((ret = ff_get_encode_buffer(avctx, pkt, out, 0)) < 0)
+        return ret;
+    dst = pkt->data;
+    if (key && s->ps_size) {
+        memcpy(dst, s->ps, s->ps_size);
+        dst += s->ps_size;
+    }
+    for (p = src; p < end;) {
+        uint32_t l = 0;
+        for (int i = 0; i < s->length_size; i++)
+            l = l << 8 | p[i];
+        p += s->length_size;
+        AV_WB32(dst, 1);
+        memcpy(dst + 4, p, l);
+        dst += 4 + l;
+        p += l;
+    }
+    return 0;
+}
+
+/* ---- the session ---- */
+
+static int session_open(AVCodecContext *avctx, HengeEncContext *s)
+{
+    HvVcOpenReply r;
+    int st = hv_call(s->client, HV_VC_ENC_OPEN, &s->o, sizeof(s->o), NULL, 0, &s->reply);
+    if (st || s->reply.len < sizeof(r)) {
+        av_log(avctx, AV_LOG_ERROR, "The device refused the encoder: %s\n", st ? s->reply.err : "short reply");
+        if (st && s->oversize)
+            av_log(avctx, AV_LOG_ERROR, "The likely cause is the size: %dx%d is larger than the %ux%u the device lists.\n",
+                   avctx->width, avctx->height, s->info->max_width, s->info->max_height);
+        return st ? status_err(st) : AVERROR_EXTERNAL;
+    }
+    memcpy(&r, s->reply.data, sizeof(r));
+    s->session = r.session;
+    s->open = 1;
+    s->ready = 0;
+    s->pending = 0;
+    s->max_pending = MAX_PENDING;
+    s->at_limit = 0;
+    s->idle_since = 0;
+    if (!(r.flags & HV_VC_ENC_HW))
+        av_log(avctx, AV_LOG_WARNING, "The device encodes this stream in software.\n");
+    return 0;
+}
+
+static void session_close(HengeEncContext *s)
+{
+    if (s->open) {
+        HvVcSession m = { s->session, 0 };
+        hv_call(s->client, HV_VC_ENC_CLOSE, &m, sizeof(m), NULL, 0, NULL);
+    }
+    s->open = 0;
+}
+
+/* The packet in s->reply: its config to extradata or the parameter sets, its data to pkt (if pkt). */
+static int take_packet(AVCodecContext *avctx, HengeEncContext *s, AVPacket *pkt)
+{
+    HvVcPacket hp;
+    const uint8_t *extra, *data;
+    size_t len;
+    int ret, key;
+    AVRational tb = { 1, s->timescale };
+
+    if (s->reply.len < sizeof(hp))
+        return AVERROR_EXTERNAL;
+    memcpy(&hp, s->reply.data, sizeof(hp));
+    if (hp.extradata_len > s->reply.len - sizeof(hp))
+        return AVERROR_EXTERNAL;
+    extra = s->reply.data + sizeof(hp);
+    data = extra + hp.extradata_len;
+    len = s->reply.len - sizeof(hp) - hp.extradata_len;
+    key = !!(hp.flags & HV_VC_PACKET_KEY);
+
+    if (hp.extradata_len) {
+        if (s->annexb) {
+            av_freep(&s->ps);
+            ret = config_to_annexb(s->codec, extra, hp.extradata_len, &s->ps, &s->ps_size, &s->length_size);
+            if (ret < 0) {
+                av_log(avctx, AV_LOG_ERROR, "The device's parameter sets do not parse.\n");
+                return ret;
+            }
+        } else if (s->codec == HV_VC_AV1 && !s->ps) {
+            s->ps = av_mallocz(hp.extradata_len + AV_INPUT_BUFFER_PADDING_SIZE);
+            if (!s->ps)
+                return AVERROR(ENOMEM);
+            memcpy(s->ps, extra, hp.extradata_len);
+            s->ps_size = hp.extradata_len;
+        }
+    }
+    if (!pkt)
+        return 0;
+
+    if (s->annexb)
+        ret = packet_to_annexb(avctx, s, data, len, key && !(avctx->flags & AV_CODEC_FLAG_GLOBAL_HEADER), pkt);
+    else if ((ret = ff_get_encode_buffer(avctx, pkt, len, 0)) >= 0)
+        memcpy(pkt->data, data, len);
+    if (ret < 0)
+        return ret;
+    pkt->pts      = av_rescale_q(hp.pts, tb, avctx->time_base);
+    pkt->dts      = av_rescale_q(hp.dts, tb, avctx->time_base);
+    pkt->duration = av_rescale_q(hp.duration, tb, avctx->time_base);
+    if (key)
+        pkt->flags |= AV_PKT_FLAG_KEY;
+    return 0;
+}
+
+/* A global header: encode one blank frame in a session of its own, as videotoolboxenc does. */
+static int fetch_extradata(AVCodecContext *avctx, HengeEncContext *s)
+{
+    HvVcFrameAlloc a = { .width = s->o.width, .height = s->o.height, .format = s->o.format, .range = s->o.range };
+    HvVcFrameReply fr;
+    HvVcEncFrame f;
+    HvVcEncPacketReq q;
+    int64_t start;
+    int st, ret;
+
+    if ((ret = session_open(avctx, s)) < 0)
+        return ret;
+    st = hv_call(s->client, HV_VC_FRAME_ALLOC, &a, sizeof(a), NULL, 0, &s->reply);
+    if (st || s->reply.len < sizeof(fr)) {
+        av_log(avctx, AV_LOG_ERROR, "FRAME_ALLOC: %s\n", st ? s->reply.err : "short reply");
+        session_close(s);
+        return st ? status_err(st) : AVERROR_EXTERNAL;
+    }
+    memcpy(&fr, s->reply.data, sizeof(fr));
+    f = (HvVcEncFrame){ s->session, fr.handle, 0, 1, HV_VC_ENC_FRAME_FREE, 0 };
+    st = hv_call(s->client, HV_VC_ENC_FRAME, &f, sizeof(f), NULL, 0, &s->reply);
+    if (st) {
+        hv_frame_free(s->client, fr.handle);
+    } else {
+        f = (HvVcEncFrame){ s->session, 0, 0, 0, HV_VC_ENC_FRAME_EOS, 0 };
+        st = hv_call(s->client, HV_VC_ENC_FRAME, &f, sizeof(f), NULL, 0, &s->reply);
+    }
+    q = (HvVcEncPacketReq){ s->session, HV_VC_PACKET_WAIT, WAIT_SLICE_MS, 0 };
+    start = av_gettime_relative();
+    while (!st) {
+        st = hv_call(s->client, HV_VC_ENC_PACKET, &q, sizeof(q), NULL, 0, &s->reply);
+        if (st != HV_VC_E_TIMEOUT && st != HV_VC_E_AGAIN)
+            break;
+        if (av_gettime_relative() - start > GIVE_UP_MS * 1000LL) {
+            av_log(avctx, AV_LOG_ERROR, "No parameter sets from the device in %d s: its encoder gave no packet for a blank frame.\n",
+                   GIVE_UP_MS / 1000);
+            session_close(s);
+            return AVERROR_EXTERNAL;
+        }
+        if (st == HV_VC_E_AGAIN)
+            av_usleep(WAIT_SLICE_MS * 1000);
+        st = 0;
+    }
+    if (st) {
+        av_log(avctx, AV_LOG_ERROR, "No parameter sets from the device: %s\n", s->reply.err);
+        session_close(s);
+        return status_err(st);
+    }
+    ret = take_packet(avctx, s, NULL);
+    session_close(s);
+    if (ret < 0)
+        return ret;
+    if (!s->ps_size) {
+        av_log(avctx, AV_LOG_ERROR, "The device gave no parameter sets.\n");
+        return AVERROR_EXTERNAL;
+    }
+    avctx->extradata = av_mallocz(s->ps_size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!avctx->extradata)
+        return AVERROR(ENOMEM);
+    memcpy(avctx->extradata, s->ps, s->ps_size);
+    avctx->extradata_size = s->ps_size;
+    return 0;
+}
+
+static uint32_t enc_codec(AVCodecContext *avctx, HengeEncContext *s, enum AVPixelFormat sw)
+{
+    switch (avctx->codec_id) {
+    case AV_CODEC_ID_H264:  return HV_VC_H264;
+    case AV_CODEC_ID_HEVC:  return sw == AV_PIX_FMT_BGRA && s->alpha_quality > 0 ? HV_VC_HEVC_ALPHA : HV_VC_HEVC;
+    case AV_CODEC_ID_AV1:   return HV_VC_AV1;
+    case AV_CODEC_ID_MJPEG: return HV_VC_JPEG;
+    default:                return 0;
+    }
+}
+
+static av_cold int henge_enc_init(AVCodecContext *avctx)
+{
+    HengeEncContext *s = avctx->priv_data;
+    AVHWFramesContext *frames = NULL;
+    AVHengeDeviceContext *dev;
+    enum AVPixelFormat sw;
+    HvVcEncOpen *o = &s->o;
+    char cc[5];
+    int ret;
+
+    if (avctx->pix_fmt == AV_PIX_FMT_HENGE) {
+        if (!avctx->hw_frames_ctx) {
+            av_log(avctx, AV_LOG_ERROR, "henge frames need a hw_frames_ctx.\n");
+            return AVERROR(EINVAL);
+        }
+        frames = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+        if (frames->device_ctx->type != AV_HWDEVICE_TYPE_HENGE)
+            return AVERROR(EINVAL);
+        s->device_ref = av_buffer_ref(frames->device_ref);
+        sw = frames->sw_format;
+    } else {
+        sw = avctx->pix_fmt;
+        if (avctx->hw_device_ctx && ((AVHWDeviceContext *)avctx->hw_device_ctx->data)->type == AV_HWDEVICE_TYPE_HENGE)
+            s->device_ref = av_buffer_ref(avctx->hw_device_ctx);
+        else if ((ret = av_hwdevice_ctx_create(&s->device_ref, AV_HWDEVICE_TYPE_HENGE, NULL, NULL, 0)) < 0)
+            return ret;
+    }
+    if (!s->device_ref)
+        return AVERROR(ENOMEM);
+    dev = ((AVHWDeviceContext *)s->device_ref->data)->hwctx;
+    s->client = dev->client;
+    s->format = av_henge_format_from_pix_fmt(sw);
+    if (!s->format) {
+        av_log(avctx, AV_LOG_ERROR, "The device takes no %s frames.\n", av_get_pix_fmt_name(sw));
+        return AVERROR(EINVAL);
+    }
+
+    s->codec = enc_codec(avctx, s, sw);
+    hv_fourcc_str(s->codec, cc);
+    s->info = hv_query_encoder(dev->query, s->codec);
+    if (!s->info || (!(s->info->flags & HV_VC_ENC_HW) && !s->allow_sw)) {
+        av_log(avctx, AV_LOG_ERROR, "This device has no %s hardware encoder (%s). henge-codec-info lists what it has.\n",
+               avcodec_get_name(avctx->codec_id), cc);
+        return AVERROR(ENOSYS);
+    }
+    /* The listed size is the largest of three test sizes that answered, not a true limit (the Mac's H.264 encoder
+       takes 4096x4096 and lists 3840x2160), so a larger size is no error here: ENC_OPEN decides. */
+    s->oversize = s->info->max_width && s->info->max_height &&
+                  (avctx->width > (int)s->info->max_width || avctx->height > (int)s->info->max_height);
+    if (s->oversize)
+        av_log(avctx, AV_LOG_VERBOSE, "%dx%d is larger than the %ux%u the device lists for this encoder: the device decides.\n",
+               avctx->width, avctx->height, s->info->max_width, s->info->max_height);
+    s->annexb = s->codec == HV_VC_H264 || s->codec == HV_VC_HEVC || s->codec == HV_VC_HEVC_ALPHA;
+    s->length_size = 4;
+
+    if (!avctx->time_base.num || !avctx->time_base.den)
+        return AVERROR(EINVAL);
+    s->timescale = avctx->time_base.den <= 1000000000 ? avctx->time_base.den : 1000000;
+
+    memset(o, 0, sizeof(*o));
+    o->codec     = s->codec;
+    o->width     = avctx->width;
+    o->height    = avctx->height;
+    o->format    = s->format;
+    o->range     = avctx->color_range == AVCOL_RANGE_JPEG ? HV_VC_RANGE_FULL : HV_VC_RANGE_VIDEO;
+    o->timescale = s->timescale;
+    if (avctx->framerate.num > 0 && avctx->framerate.den > 0 && av_q2d(avctx->framerate) <= 1000) {
+        o->fps_num = avctx->framerate.num;
+        o->fps_den = avctx->framerate.den;
+    }
+    if (s->codec != HV_VC_JPEG && avctx->max_b_frames != 0 && (s->info->flags & HV_VC_ENC_REORDER))
+        o->flags |= HV_VC_ENC_F_BFRAMES;
+    if (s->realtime > 0)
+        o->flags |= HV_VC_ENC_F_REALTIME;
+    if (s->prio_speed > 0)
+        o->flags |= HV_VC_ENC_F_SPEED;
+    if (s->allow_sw)
+        o->flags |= HV_VC_ENC_F_SOFTWARE_OK;
+    if (avctx->flags & AV_CODEC_FLAG_QSCALE) {
+        int q = avctx->global_quality / FF_QP2LAMBDA;
+        o->quality = av_clip(q, 1, 100);
+    } else if (avctx->bit_rate > 0) {
+        o->bitrate = FFMIN(avctx->bit_rate, 2000000000);
+        if (s->constant_bit_rate)
+            o->flags |= HV_VC_ENC_F_CBR;
+    }
+    if (avctx->rc_max_rate > 0 && !(o->flags & HV_VC_ENC_F_CBR)) {
+        o->max_bytes     = FFMIN(avctx->rc_max_rate / 8, (int64_t)1 << 32);
+        o->max_window_ms = 1000;
+    }
+    if (avctx->gop_size > 0)
+        o->keyint = FFMIN(avctx->gop_size, 100000);
+    else if (s->codec != HV_VC_JPEG)
+        o->keyint_ms = 2000;
+    if (avctx->color_primaries != AVCOL_PRI_UNSPECIFIED && avctx->color_primaries <= 255)
+        o->primaries = avctx->color_primaries;
+    if (avctx->color_trc != AVCOL_TRC_UNSPECIFIED && avctx->color_trc <= 255)
+        o->transfer = avctx->color_trc;
+    if (avctx->colorspace != AVCOL_SPC_UNSPECIFIED && avctx->colorspace != AVCOL_SPC_RGB && avctx->colorspace <= 255)
+        o->matrix = avctx->colorspace;
+    if (s->codec == HV_VC_HEVC)
+        hdr10(avctx, o);
+    if ((ret = pick_profile(avctx, s, sw, o->profile)) < 0)
+        return ret;
+
+    if ((s->annexb || s->codec == HV_VC_AV1) && (avctx->flags & AV_CODEC_FLAG_GLOBAL_HEADER) &&
+        (ret = fetch_extradata(avctx, s)) < 0)
+        return ret;
+    if ((ret = session_open(avctx, s)) < 0)
+        return ret;
+
+    if (avctx->pix_fmt != AV_PIX_FMT_HENGE) {
+        AVHWFramesContext *up;
+        s->upload_ref = av_hwframe_ctx_alloc(s->device_ref);
+        if (!s->upload_ref)
+            return AVERROR(ENOMEM);
+        up = (AVHWFramesContext *)s->upload_ref->data;
+        up->format    = AV_PIX_FMT_HENGE;
+        up->sw_format = sw;
+        up->width     = avctx->width;
+        up->height    = avctx->height;
+        ((AVHengeFramesContext *)up->hwctx)->color_range = avctx->color_range;
+        if ((ret = av_hwframe_ctx_init(s->upload_ref)) < 0)
+            return ret;
+    }
+    s->frame = av_frame_alloc();
+    if (!s->frame)
+        return AVERROR(ENOMEM);
+    avctx->has_b_frames = (o->flags & HV_VC_ENC_F_BFRAMES) ? 2 : 0;
+    av_log(avctx, AV_LOG_VERBOSE, "Henge %s encoder %ux%u from %s, profile %s, %s\n", cc, o->width, o->height,
+           av_get_pix_fmt_name(sw), o->profile[0] ? o->profile : "default", s->info->encoder_id);
+    return 0;
+}
+
+/* 0: the frame is in the device. 1: the host is at a limit (s->limit_err says which) and the caller keeps the frame
+   to give it again. Or an error. */
+static int submit(AVCodecContext *avctx, HengeEncContext *s, AVFrame *frame)
+{
+    AVFrame *hw = frame;
+    HvVcEncFrame f;
+    HvVcEncFrameReply r = { 0, 0 };
+    int64_t pts;
+    int ret, st;
+
+    if (frame->format != AV_PIX_FMT_HENGE) {
+        hw = av_frame_alloc();
+        if (!hw)
+            return AVERROR(ENOMEM);
+        if ((ret = av_hwframe_get_buffer(s->upload_ref, hw, 0)) < 0 ||
+            (ret = av_hwframe_transfer_data(hw, frame, 0)) < 0) {
+            av_frame_free(&hw);
+            if (ret == AVERROR(ENOBUFS)) {
+                av_strlcpy(s->limit_err, "no room on the device to upload a frame (live frames or message memory)",
+                           sizeof(s->limit_err));
+                return 1;
+            }
+            return ret;
+        }
+    }
+    pts = frame->pts != AV_NOPTS_VALUE ? av_rescale_q(frame->pts, avctx->time_base, (AVRational){ 1, s->timescale }) : 0;
+    f.session  = s->session;
+    f.handle   = av_henge_frame_handle(hw);
+    f.pts      = pts;
+    f.duration = frame->duration > 0 ? av_rescale_q(frame->duration, avctx->time_base, (AVRational){ 1, s->timescale }) : 0;
+    f.flags    = frame->pict_type == AV_PICTURE_TYPE_I ? HV_VC_ENC_FRAME_KEY : 0;
+    f.reserved = 0;
+    st = hv_call(s->client, HV_VC_ENC_FRAME, &f, sizeof(f), NULL, 0, &s->reply);
+    if (hw != frame)
+        av_frame_free(&hw);
+    if (st == HV_VC_E_LIMIT) {
+        av_strlcpy(s->limit_err, s->reply.err, sizeof(s->limit_err));
+        return 1;
+    }
+    if (st) {
+        av_log(avctx, AV_LOG_ERROR, "ENC_FRAME: %s\n", s->reply.err);
+        return status_err(st);
+    }
+    if (s->reply.len >= sizeof(r))
+        memcpy(&r, s->reply.data, sizeof(r));
+    s->ready = r.ready;
+    s->pending = r.pending;
+    return 0;
+}
+
+/* An error once nothing has moved for GIVE_UP_MS. */
+static int check_stall(AVCodecContext *avctx, HengeEncContext *s, int64_t now)
+{
+    if (!s->idle_since)
+        s->idle_since = now;
+    if (now - s->idle_since <= GIVE_UP_MS * 1000LL)
+        return 0;
+    if (s->at_limit)
+        av_log(avctx, AV_LOG_ERROR, "The device stayed at a limit for %d s: %s\n", GIVE_UP_MS / 1000, s->limit_err);
+    else
+        av_log(avctx, AV_LOG_ERROR, "No packet from the device's encoder in %d s, with %d frames in it.\n",
+               GIVE_UP_MS / 1000, s->pending);
+    return AVERROR_EXTERNAL;
+}
+
+static int henge_receive_packet(AVCodecContext *avctx, AVPacket *pkt)
+{
+    HengeEncContext *s = avctx->priv_data;
+    int ret, st;
+
+    for (;;) {
+        int must_wait = s->eof_sent || s->at_limit || s->pending >= s->max_pending;
+        if (s->ready || must_wait) {
+            HvVcEncPacketReq q = { s->session, s->ready ? 0 : HV_VC_PACKET_WAIT, WAIT_SLICE_MS, 0 };
+            int64_t now;
+            st = hv_call(s->client, HV_VC_ENC_PACKET, &q, sizeof(q), NULL, 0, &s->reply);
+            if (!st) {
+                if (s->ready)
+                    s->ready--;
+                if (s->pending > 0)
+                    s->pending--;
+                s->at_limit = 0; /* a packet out can make room: give the frame again */
+                s->idle_since = 0;
+                return take_packet(avctx, s, pkt);
+            }
+            if (st == HV_VC_E_EOF)
+                return AVERROR_EOF;
+            if (st != HV_VC_E_AGAIN && st != HV_VC_E_TIMEOUT) {
+                av_log(avctx, AV_LOG_ERROR, "ENC_PACKET: %s\n", s->reply.err);
+                return status_err(st);
+            }
+            s->ready = 0;
+            if (must_wait) {
+                now = av_gettime_relative();
+                if ((ret = check_stall(avctx, s, now)) < 0)
+                    return ret;
+                if (st == HV_VC_E_AGAIN) /* no wait on the host: nothing in its encoder */
+                    av_usleep(WAIT_SLICE_MS * 1000);
+                if (s->at_limit) {
+                    s->at_limit = 0;
+                } else if (!s->eof_sent && now - s->idle_since >= STALL_MS * 1000LL && s->max_pending < MAX_PENDING_HARD) {
+                    s->max_pending = FFMIN(s->max_pending * 2, MAX_PENDING_HARD);
+                    av_log(avctx, AV_LOG_VERBOSE, "No packet with %d frames in the device's encoder: it can now hold %d.\n",
+                           s->pending, s->max_pending);
+                } else {
+                    continue;
+                }
+            }
+        }
+        if (!s->held) {
+            ret = ff_encode_get_frame(avctx, s->frame);
+            if (ret == AVERROR_EOF) {
+                HvVcEncFrame f = { s->session, 0, 0, 0, HV_VC_ENC_FRAME_EOS, 0 };
+                st = hv_call(s->client, HV_VC_ENC_FRAME, &f, sizeof(f), NULL, 0, &s->reply);
+                if (st) {
+                    av_log(avctx, AV_LOG_ERROR, "flush: %s\n", s->reply.err);
+                    return status_err(st);
+                }
+                s->eof_sent = 1;
+                continue;
+            }
+            if (ret < 0)
+                return ret;
+            s->held = 1;
+        }
+        ret = submit(avctx, s, s->frame);
+        if (ret > 0) {
+            if (!s->idle_since)
+                av_log(avctx, AV_LOG_VERBOSE, "The device is at a limit, so the frame waits: %s\n", s->limit_err);
+            s->at_limit = 1;
+            continue;
+        }
+        av_frame_unref(s->frame);
+        s->held = 0;
+        if (ret < 0)
+            return ret;
+        s->idle_since = 0;
+    }
+}
+
+static av_cold int henge_enc_close(AVCodecContext *avctx)
+{
+    HengeEncContext *s = avctx->priv_data;
+    if (s->client)
+        session_close(s);
+    av_frame_free(&s->frame);
+    hv_reply_free(&s->reply);
+    av_freep(&s->ps);
+    av_buffer_unref(&s->upload_ref);
+    av_buffer_unref(&s->device_ref);
+    return 0;
+}
