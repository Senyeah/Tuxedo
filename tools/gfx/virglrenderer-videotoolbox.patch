+/* The planes are CPU pointers (VideoToolbox): upload them into the plane textures */
+static int sync_cpu_planes_to_video_buffer(struct vrend_video_buffer *buf,
+                                           const struct virgl_video_dma_buf *dmabuf)
+{
+    GLint align, row_length, unpack_buf;
+
+    glGetIntegerv(GL_UNPACK_ALIGNMENT, &align);
+    glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+    glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buf);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+
+    for (unsigned i = 0; i < dmabuf->num_planes && i < buf->num_planes; i++) {
+        const struct virgl_video_dma_buf_plane *p = &dmabuf->planes[i];
+        struct vrend_resource *res;
+        const struct vrend_format_table *tf;
+        unsigned bpp;
+
+        res = vrend_renderer_ctx_res_lookup(buf->ctx->ctx, buf->planes[i].res_handle);
+        if (!res) {
+            virgl_error("%s: res %d not found\n", __func__, buf->planes[i].res_handle);
+            continue;
+        }
+        tf = vrend_get_format_table_entry(res->base.format);
+        bpp = util_format_get_blocksize(res->base.format);
+        if (!p->data || !tf || !bpp || p->pitch % bpp)
+            continue;
+
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, p->pitch / bpp);
+        glBindTexture(res->target, res->gl_id);
+        glTexSubImage2D(res->target, 0, 0, 0, MIN2(res->base.width0, p->width),
+                        MIN2(res->base.height0, p->height), tf->glformat, tf->gltype, p->data);
+        glBindTexture(res->target, 0);
+    }
+
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, row_length);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, align);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack_buf);
+
+    return 0;
+}
