+/*
+ * The virgl_video.h back end on VideoToolbox: H.264, VP9 and AV1 decode.
+ *
+ * The guest's VA-API driver is stateless: it sends slices and parsed fields.
+ * VideoToolbox is stateful: it wants the stream with its parameter sets. So
+ * this file writes an SPS and a PPS from the fields, collects the slices of
+ * one picture between begin_frame and end_frame, and decodes them as one
+ * sample at end_frame. VideoToolbox keeps its own reference frames, so the
+ * guest's reference surfaces are not used. The output goes to the target's
+ * plane textures through decode_completed, as an IOSurface.
+ *
+ * VP9 needs no rewriting: virgl carries the whole frame, so only the vpcC
+ * atom comes from the fields. AV1 needs its headers written: see below.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <CoreMedia/CoreMedia.h>
+#include <CoreVideo/CoreVideo.h>
+#include <IOSurface/IOSurfaceRef.h>
+#include <TargetConditionals.h>
+#include <VideoToolbox/VideoToolbox.h>
+
+/* vrend_renderer.c always pulls this file in: the .a names its frameworks, so an app's link line need not */
+__asm__(".linker_option \"-framework\", \"VideoToolbox\"\n"
+        ".linker_option \"-framework\", \"CoreMedia\"\n"
+        ".linker_option \"-framework\", \"CoreVideo\"\n"
+        ".linker_option \"-framework\", \"IOSurface\"\n"
+        ".linker_option \"-framework\", \"CoreFoundation\"");
+
+#include "util/u_formats.h"
+#include "virgl_hw.h"
+#include "virgl_video_hw.h"
+#include "virgl_util.h"
+#include "virgl_video.h"
+
+#define VT_VIRGL_FORMAT_NV12 VIRGL_FORMAT_Y8_U8V8_420_UNORM
+#define VT_VIRGL_FORMAT_P010 VIRGL_FORMAT_X6Y10_X6U10X6V10_420_UNORM
+#define VT_MAX_PPS 256
+#define VT_PS_MAX 2048 /* 8 scaling lists of 64 values fit with room */
+#define VT_AU_MAX (16u << 20) /* the slices of one picture */
+#define VT_AU_KEEP (4u << 20) /* a larger access unit buffer is freed after its frame */
+
+struct virgl_video_buffer {
+    enum pipe_format format;
+    uint32_t width;
+    uint32_t height;
+    uint32_t id;
+    void *opaque;
+};
+
+struct vt_pps {
+    uint8_t *nal;
+    size_t len;
+    /* VA-API has no PPS default ref counts: learn them from slices that do not override them */
+    uint8_t l0, l1;
+};
+
+/* The last slice that one decode_bitstream call gave: the descriptor's active ref counts are its own */
+struct vt_slice {
+    bool valid, override;
+    unsigned pps_id, type;
+};
+
+enum vt_kind { VT_H264, VT_VP9, VT_AV1 };
+
+struct av1_slot {
+    uint32_t surf;  /* the guest's buffer id; 0 is empty */
+    uint8_t order_hint;
+    int32_t gm[7][6];
+    bool seg_enabled;
+    uint8_t seg_mask[8];
+    int16_t seg_data[8][8];
+};
+
+struct virgl_video_codec {
+    enum vt_kind kind;
+    enum pipe_video_profile profile;
+    enum pipe_video_entrypoint entrypoint;
+    uint32_t level;
+    uint32_t width;
+    uint32_t height;
+    void *opaque;
+
+    struct virgl_video_buffer *target;
+    uint8_t *au; /* H.264: AVCC, with 4-byte big-endian lengths; VP9: the frame */
+    size_t au_len, au_cap;
+    bool have_desc;
+    struct virgl_h264_picture_desc desc;
+    int pps_id;
+    bool pps_mixed;   /* the picture's slices name more than one PPS */
+    bool pic_idr;     /* an IDR slice in the picture; VP9: a key frame */
+    bool pic_intra;   /* every slice of the picture is I or SI; VP9: intra_only */
+    bool pic_shown;   /* VP9: show_frame; a hidden frame gives no output */
+    unsigned pic_slices;
+    struct vt_slice last;
+
+    uint8_t sps[VT_PS_MAX];
+    size_t sps_len;
+    struct vt_pps pps[VT_MAX_PPS];
+
+    /* VP9: what the vpcC atom came from */
+    unsigned vp9_profile, vp9_depth, vp9_w, vp9_h, fmt_w, fmt_h;
+
+    /* AV1: VideoToolbox's reference slots, the picture's descriptor, the sequence header OBU in the format */
+    struct av1_slot av1_slots[8];
+    struct virgl_av1_picture_desc *av1;
+    uint8_t av1_seq[128];
+    size_t av1_seq_len;
+    /* a frame decoded without a refresh, until the next frame shows whether it is a reference */
+    struct virgl_av1_picture_desc *av1_pend;
+    uint8_t *pend_au;
+    size_t pend_len, pend_cap;
+    uint32_t pend_surf;
+    uint8_t pend_idx[7];
+    unsigned redecodes;
+    uint8_t *sample;
+    size_t sample_cap;
+    bool no_emit;
+
+    CMVideoFormatDescriptionRef fmt;
+    VTDecompressionSessionRef vt;
+    CVPixelBufferRef out;
+    OSStatus out_status;
+    OSType pixfmt; /* the session's output: NV12, or planar for IYUV and YV12 targets */
+    uint32_t pool; /* a new session or frame size: the old surfaces are not given again */
+    /* after a failed picture VideoToolbox's references are wrong: skip to the next IDR or intra picture */
+    bool need_intra;
+    unsigned frames, failed, skipped, sessions, ps_updates, max_slices_per_call;
+    bool warned_field, warned_poc1, warned_pps;
+};
+
+static struct virgl_video_callbacks *callbacks;
+static uint32_t next_buffer_id = 1;
+
+static bool is_h264(enum pipe_video_profile p)
+{
+    switch (p) {
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool is_vp9(enum pipe_video_profile p)
+{
+    return p == PIPE_VIDEO_PROFILE_VP9_PROFILE0 || p == PIPE_VIDEO_PROFILE_VP9_PROFILE2;
+}
+
+static bool is_av1(enum pipe_video_profile p)
+{
+    return p == PIPE_VIDEO_PROFILE_AV1_MAIN;
+}
+
+static const char *vt_name(const struct virgl_video_codec *c)
+{
+    return c->kind == VT_AV1 ? "AV1" : c->kind == VT_VP9 ? "VP9" : "H.264";
+}
+
+static unsigned h264_profile_idc(enum pipe_video_profile p)
+{
+    switch (p) {
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE:
+        return 66;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN:
+        return 77;
+    default:
+        return 100;
+    }
+}
+
+/* ---- bit reader over a NAL's RBSP (skips emulation prevention bytes) ---- */
+
+struct br {
+    const uint8_t *p;
+    size_t len, pos;
+    unsigned cur, left, zeros;
+    bool err;
+    bool raw; /* no emulation prevention bytes (VP9, AV1) */
+};
+
+static unsigned br_bit(struct br *b)
+{
+    if (!b->left) {
+        if (!b->raw && b->pos < b->len && b->zeros >= 2 && b->p[b->pos] == 3) {
+            b->pos++;
+            b->zeros = 0;
+        }
+        if (b->pos >= b->len) {
+            b->err = true;
+            return 0;
+        }
+        b->cur = b->p[b->pos++];
+        b->zeros = b->cur ? 0 : b->zeros + 1;
+        b->left = 8;
+    }
+    b->left--;
+    return (b->cur >> b->left) & 1;
+}
+
+static unsigned br_u(struct br *b, unsigned n)
+{
+    unsigned v = 0;
+    while (n--)
+        v = v << 1 | br_bit(b);
+    return v;
+}
+
+static unsigned br_ue(struct br *b)
+{
+    unsigned lz = 0;
+    while (!br_bit(b) && !b->err)
+        if (++lz > 31) {
+            b->err = true;
+            return 0;
+        }
+    return ((1u << lz) - 1) + br_u(b, lz);
+}
+
+static void br_se(struct br *b)
+{
+    br_ue(b);
+}
+
+/* ---- bit writer, then NAL escaping ---- */
+
+struct bw {
+    uint8_t rbsp[VT_PS_MAX];
+    size_t n;
+    unsigned acc, nb;
+    bool err;
+};
+
+static void bw_u(struct bw *b, uint32_t v, unsigned n)
+{
+    while (n--) {
+        b->acc = b->acc << 1 | ((v >> n) & 1);
+        if (++b->nb == 8) {
+            if (b->n < sizeof(b->rbsp))
+                b->rbsp[b->n++] = (uint8_t)b->acc;
+            else
+                b->err = true;
+            b->acc = b->nb = 0;
+        }
+    }
+}
+
+static void bw_ue(struct bw *b, uint32_t v)
+{
+    uint64_t x = (uint64_t)v + 1;
+    unsigned m = 0;
+    while ((x >> m) > 1)
+        m++;
+    bw_u(b, 0, m);
+    bw_u(b, (uint32_t)x, m + 1);
+}
+
+static void bw_se(struct bw *b, int32_t v)
+{
+    bw_ue(b, v > 0 ? 2u * (uint32_t)v - 1 : 2u * (uint32_t)-v);
+}
+
+/* rbsp_trailing_bits, then the NAL header and emulation prevention. Returns the NAL's length. */
+static size_t bw_nal(struct bw *b, uint8_t header, uint8_t *out, size_t cap)
+{
+    size_t o = 0;
+    unsigned zeros = 0;
+    bw_u(b, 1, 1);
+    while (b->nb)
+        bw_u(b, 0, 1);
+    if (b->err || cap < 1)
+        return 0;
+    out[o++] = header;
+    for (size_t i = 0; i < b->n; i++) {
+        if (zeros >= 2 && b->rbsp[i] <= 3) {
+            if (o >= cap)
+                return 0;
+            out[o++] = 3;
+            zeros = 0;
+        }
+        if (o >= cap)
+            return 0;
+        out[o++] = b->rbsp[i];
+        zeros = b->rbsp[i] ? 0 : zeros + 1;
+    }
+    return o;
+}
+
+/* ---- H.264 parameter sets from the parsed fields ---- */
+
+static size_t h264_write_sps(const struct virgl_video_codec *c, const struct virgl_h264_picture_desc *d, uint8_t *out)
+{
+    const struct virgl_h264_sps *s = &d->pps.sps;
+    struct bw b = {0};
+    unsigned profile = h264_profile_idc(c->profile);
+    unsigned w_mbs = (c->width + 15) / 16;
+    unsigned map_unit = s->frame_mbs_only_flag ? 16 : 32;
+    unsigned h_units = (c->height + map_unit - 1) / map_unit;
+    unsigned crop_r = (w_mbs * 16 - c->width) / 2;
+    unsigned crop_b = (h_units * map_unit - c->height) / (s->frame_mbs_only_flag ? 2 : 4);
+    /* Mesa sends no level_idc; 5.1 lets the DPB hold max_num_ref_frames at any size we accept */
+    unsigned level = s->level_idc > 51 ? s->level_idc : 51;
+
+    bw_u(&b, profile, 8);
+    bw_u(&b, profile == 66 ? 0x40 : 0, 8); /* constraint_set1 for constrained baseline */
+    bw_u(&b, level, 8);
+    bw_ue(&b, 0); /* seq_parameter_set_id */
+    if (profile >= 100) {
+        bw_ue(&b, s->chroma_format_idc);
+        if (s->chroma_format_idc == 3)
+            bw_u(&b, s->separate_colour_plane_flag, 1);
+        bw_ue(&b, s->bit_depth_luma_minus8);
+        bw_ue(&b, s->bit_depth_chroma_minus8);
+        bw_u(&b, 0, 1); /* qpprime_y_zero_transform_bypass_flag */
+        bw_u(&b, 0, 1); /* seq_scaling_matrix_present_flag: the PPS carries the effective lists */
+    }
+    bw_ue(&b, s->log2_max_frame_num_minus4);
+    bw_ue(&b, s->pic_order_cnt_type);
+    if (s->pic_order_cnt_type == 0) {
+        bw_ue(&b, s->log2_max_pic_order_cnt_lsb_minus4);
+    } else if (s->pic_order_cnt_type == 1) {
+        /* VA-API does not carry these offsets: Mesa sends zeros */
+        bw_u(&b, s->delta_pic_order_always_zero_flag, 1);
+        bw_se(&b, s->offset_for_non_ref_pic);
+        bw_se(&b, s->offset_for_top_to_bottom_field);
+        bw_ue(&b, s->num_ref_frames_in_pic_order_cnt_cycle);
+        for (unsigned i = 0; i < s->num_ref_frames_in_pic_order_cnt_cycle; i++)
+            bw_se(&b, s->offset_for_ref_frame[i]);
+    }
+    bw_ue(&b, d->num_ref_frames); /* max_num_ref_frames: VA-API's num_ref_frames */
+    bw_u(&b, 0, 1);               /* gaps_in_frame_num_value_allowed_flag: not carried */
+    bw_ue(&b, w_mbs - 1);
+    bw_ue(&b, h_units - 1);
+    bw_u(&b, s->frame_mbs_only_flag, 1);
+    if (!s->frame_mbs_only_flag)
+        bw_u(&b, s->mb_adaptive_frame_field_flag, 1);
+    bw_u(&b, s->direct_8x8_inference_flag, 1);
+    bw_u(&b, crop_r || crop_b, 1);
+    if (crop_r || crop_b) {
+        bw_ue(&b, 0);
+        bw_ue(&b, crop_r);
+        bw_ue(&b, 0);
+        bw_ue(&b, crop_b);
+    }
+    bw_u(&b, 0, 1); /* vui_parameters_present_flag */
+    return bw_nal(&b, 0x67, out, VT_PS_MAX);
+}
+
+static bool list_flat(const uint8_t *l, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++)
+        if (l[i] != 16)
+            return false;
+    return true;
+}
+
+/* VA-API's lists are in zigzag order, as the bitstream codes them */
+static void bw_scaling_list(struct bw *b, const uint8_t *l, unsigned n)
+{
+    int last = 8;
+    for (unsigned j = 0; j < n; j++) {
+        int d = l[j] - last;
+        if (d > 127)
+            d -= 256;
+        if (d < -128)
+            d += 256;
+        bw_se(b, d);
+        last = l[j];
+    }
+}
+
+static size_t h264_write_pps(const struct virgl_video_codec *c, const struct virgl_h264_picture_desc *d,
+                             unsigned pps_id, uint8_t *out)
+{
+    const struct virgl_h264_pps *p = &d->pps;
+    const struct vt_pps *st = &c->pps[pps_id];
+    struct bw b = {0};
+    bool t8 = p->transform_8x8_mode_flag;
+    bool flat = list_flat(&p->ScalingList4x4[0][0], 6 * 16) && (!t8 || list_flat(&p->ScalingList8x8[0][0], 2 * 64));
+
+    bw_ue(&b, pps_id);
+    bw_ue(&b, 0);
+    bw_u(&b, p->entropy_coding_mode_flag, 1);
+    bw_u(&b, p->bottom_field_pic_order_in_frame_present_flag, 1);
+    bw_ue(&b, 0); /* num_slice_groups_minus1 */
+    bw_ue(&b, st->l0);
+    bw_ue(&b, st->l1);
+    bw_u(&b, p->weighted_pred_flag, 1);
+    bw_u(&b, p->weighted_bipred_idc, 2);
+    bw_se(&b, p->pic_init_qp_minus26);
+    bw_se(&b, p->pic_init_qs_minus26);
+    bw_se(&b, p->chroma_qp_index_offset);
+    bw_u(&b, p->deblocking_filter_control_present_flag, 1);
+    bw_u(&b, p->constrained_intra_pred_flag, 1);
+    bw_u(&b, p->redundant_pic_cnt_present_flag, 1);
+    if (h264_profile_idc(c->profile) >= 100 &&
+        (t8 || !flat || p->second_chroma_qp_index_offset != p->chroma_qp_index_offset)) {
+        bw_u(&b, t8, 1);
+        bw_u(&b, !flat, 1);
+        if (!flat) {
+            for (unsigned i = 0; i < 6; i++) {
+                bw_u(&b, 1, 1);
+                bw_scaling_list(&b, p->ScalingList4x4[i], 16);
+            }
+            for (unsigned i = 0; t8 && i < 2; i++) {
+                bw_u(&b, 1, 1);
+                bw_scaling_list(&b, p->ScalingList8x8[i], 64);
+            }
+        }
+        bw_se(&b, p->second_chroma_qp_index_offset);
+    }
+    return bw_nal(&b, 0x68, out, VT_PS_MAX);
+}
+
+/* The slice header up to num_ref_idx_active_override_flag. False if it does not parse. */
+static bool h264_parse_slice(const struct virgl_h264_picture_desc *d, const uint8_t *nal, size_t len,
+                             unsigned *pps_id, unsigned *slice_type, bool *override)
+{
+    const struct virgl_h264_sps *s = &d->pps.sps;
+    struct br b = {.p = nal + 1, .len = len - 1};
+    bool field = false;
+
+    br_ue(&b); /* first_mb_in_slice */
+    *slice_type = br_ue(&b) % 5;
+    *pps_id = br_ue(&b);
+    if (s->separate_colour_plane_flag)
+        br_u(&b, 2);
+    br_u(&b, s->log2_max_frame_num_minus4 + 4);
+    if (!s->frame_mbs_only_flag) {
+        field = br_bit(&b);
+        if (field)
+            br_bit(&b);
+    }
+    if ((nal[0] & 0x1f) == 5)
+        br_ue(&b);
+    if (s->pic_order_cnt_type == 0) {
+        br_u(&b, s->log2_max_pic_order_cnt_lsb_minus4 + 4);
+        if (d->pps.bottom_field_pic_order_in_frame_present_flag && !field)
+            br_se(&b);
+    }
+    if (s->pic_order_cnt_type == 1 && !s->delta_pic_order_always_zero_flag) {
+        br_se(&b);
+        if (d->pps.bottom_field_pic_order_in_frame_present_flag && !field)
+            br_se(&b);
+    }
+    if (d->pps.redundant_pic_cnt_present_flag)
+        br_ue(&b);
+    if (*slice_type == 1)
+        br_bit(&b); /* direct_spatial_mv_pred_flag */
+    *override = false;
+    if (*slice_type == 0 || *slice_type == 1 || *slice_type == 3)
+        *override = br_bit(&b);
+    return !b.err && *pps_id < VT_MAX_PPS;
+}
+
+static bool au_append(struct virgl_video_codec *c, const uint8_t *nal, size_t len)
+{
+    if (len > VT_AU_MAX || c->au_len + 4 + len > VT_AU_MAX) {
+        virgl_error("vt: a picture has more than %u bytes of slices\n", VT_AU_MAX);
+        return false;
+    }
+    if (c->au_len + 4 + len > c->au_cap) {
+        size_t cap = c->au_cap ? c->au_cap : 1 << 16;
+        while (cap < c->au_len + 4 + len)
+            cap *= 2;
+        uint8_t *n = realloc(c->au, cap);
+        if (!n)
+            return false;
+        c->au = n, c->au_cap = cap;
+    }
+    uint8_t *p = c->au + c->au_len;
+    p[0] = (uint8_t)(len >> 24), p[1] = (uint8_t)(len >> 16), p[2] = (uint8_t)(len >> 8), p[3] = (uint8_t)len;
+    memcpy(p + 4, nal, len);
+    c->au_len += 4 + len;
+    return true;
+}
+
+/* One NAL unit from the Annex B data: slices go into the access unit, the rest is dropped. */
+static int h264_take_nal(struct virgl_video_codec *c, const struct virgl_h264_picture_desc *d,
+                         const uint8_t *nal, size_t len)
+{
+    unsigned type, pps_id, st;
+    bool override;
+
+    while (len && !nal[len - 1])
+        len--; /* trailing_zero_8bits */
+    if (!len)
+        return 0;
+    type = nal[0] & 0x1f;
+    if (type != 1 && type != 5)
+        return 0;
+    if (!h264_parse_slice(d, nal, len, &pps_id, &st, &override)) {
+        virgl_warn("vt: a slice header does not parse\n");
+        return -1;
+    }
+    if (c->pps_id < 0)
+        c->pps_id = (int)pps_id;
+    else if ((unsigned)c->pps_id != pps_id)
+        c->pps_mixed = true;
+    if (type == 5)
+        c->pic_idr = true;
+    if (st != 2 && st != 4)
+        c->pic_intra = false;
+    c->pic_slices++;
+    c->last = (struct vt_slice){.valid = true, .override = override, .pps_id = pps_id, .type = st};
+    return au_append(c, nal, len) ? 0 : -1;
+}
+
+static int h264_take_annexb(struct virgl_video_codec *c, const struct virgl_h264_picture_desc *d,
+                            const uint8_t *p, size_t n)
+{
+    size_t i = 0, start = SIZE_MAX;
+    while (i + 3 <= n) {
+        if (p[i] == 0 && p[i + 1] == 0 && p[i + 2] == 1) {
+            if (start != SIZE_MAX && h264_take_nal(c, d, p + start, i - start))
+                return -1;
+            i += 3;
+            start = i;
+        } else {
+            i++;
+        }
+    }
+    if (start != SIZE_MAX && start < n)
+        return h264_take_nal(c, d, p + start, n - start);
+    return 0;
+}
+
+/* ---- VideoToolbox ---- */
+
+static void vt_output(void *ref, void *src, OSStatus status, VTDecodeInfoFlags flags, CVImageBufferRef img,
+                      CMTime pts, CMTime dur)
+{
+    struct virgl_video_codec *c = ref;
+    (void)src, (void)flags, (void)pts, (void)dur;
+    c->out_status = status;
+    if (status == noErr && img) {
+        if (c->out)
+            CVPixelBufferRelease(c->out);
+        c->out = CVPixelBufferRetain(img);
+    }
+}
+
+static void vt_release_session(struct virgl_video_codec *c)
+{
+    if (c->vt) {
+        VTDecompressionSessionWaitForAsynchronousFrames(c->vt);
+        VTDecompressionSessionInvalidate(c->vt);
+        CFRelease(c->vt);
+        c->vt = NULL;
+    }
+}
+
+static void dict_set_i32(CFMutableDictionaryRef d, CFStringRef k, int32_t v)
+{
+    CFNumberRef n = CFNumberCreate(NULL, kCFNumberSInt32Type, &v);
+    CFDictionarySetValue(d, k, n);
+    CFRelease(n);
+}
+
+static OSType vt_pixfmt(enum pipe_format f)
+{
+    if (f == PIPE_FORMAT_P010)
+        return kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange;
+    return f == PIPE_FORMAT_NV12 ? kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange : kCVPixelFormatType_420YpCbCr8Planar;
+}
+
+static int vt_create_session(struct virgl_video_codec *c)
+{
+    CFMutableDictionaryRef spec, attrs, ios;
+    VTDecompressionOutputCallbackRecord cb = {vt_output, c};
+    OSStatus st;
+
+    spec = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+#if TARGET_OS_OSX
+    CFDictionarySetValue(spec, kVTVideoDecoderSpecification_EnableHardwareAcceleratedVideoDecoder, kCFBooleanTrue);
+#endif
+    attrs = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    ios = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    dict_set_i32(attrs, kCVPixelBufferPixelFormatTypeKey, (int32_t)c->pixfmt);
+    CFDictionarySetValue(attrs, kCVPixelBufferIOSurfacePropertiesKey, ios);
+    st = VTDecompressionSessionCreate(NULL, c->fmt, spec, attrs, &cb, &c->vt);
+    CFRelease(ios);
+    CFRelease(attrs);
+    CFRelease(spec);
+    if (st != noErr) {
+        virgl_error("vt: VTDecompressionSessionCreate failed (%d)\n", (int)st);
+        c->vt = NULL;
+        return -1;
+    }
+    c->sessions++;
+    c->pool++;
+    CFBooleanRef hw = NULL;
+    VTSessionCopyProperty(c->vt, kVTDecompressionPropertyKey_UsingHardwareAcceleratedVideoDecoder, NULL, &hw);
+    CMVideoDimensions dim = CMVideoFormatDescriptionGetDimensions(c->fmt);
+    virgl_info("vt: %s session %dx%d, %s decoder\n", vt_name(c), dim.width, dim.height,
+               hw == kCFBooleanTrue ? "hardware" : "software");
+    if (hw)
+        CFRelease(hw);
+    return 0;
+}
+
+static int vt_set_format(struct virgl_video_codec *c, CMVideoFormatDescriptionRef fmt);
+
+/* The format description from the SPS and every PPS seen */
+static int vt_update_format(struct virgl_video_codec *c)
+{
+    const uint8_t *sets[1 + VT_MAX_PPS];
+    size_t sizes[1 + VT_MAX_PPS];
+    size_t n = 0;
+    CMVideoFormatDescriptionRef fmt = NULL;
+    OSStatus st;
+
+    sets[n] = c->sps, sizes[n++] = c->sps_len;
+    for (unsigned i = 0; i < VT_MAX_PPS; i++)
+        if (c->pps[i].len)
+            sets[n] = c->pps[i].nal, sizes[n++] = c->pps[i].len;
+    st = CMVideoFormatDescriptionCreateFromH264ParameterSets(NULL, n, sets, sizes, 4, &fmt);
+    if (st != noErr) {
+        virgl_error("vt: the parameter sets are refused (%d)\n", (int)st);
+        return -1;
+    }
+    return vt_set_format(c, fmt);
+}
+
+/* Takes fmt; a new session only if the old one refuses it */
+static int vt_set_format(struct virgl_video_codec *c, CMVideoFormatDescriptionRef fmt)
+{
+    if (c->fmt) {
+        CMVideoDimensions a = CMVideoFormatDescriptionGetDimensions(c->fmt), b = CMVideoFormatDescriptionGetDimensions(fmt);
+        if (a.width != b.width || a.height != b.height)
+            c->pool++;
+        CFRelease(c->fmt);
+    }
+    c->fmt = fmt;
+    if (c->vt && !VTDecompressionSessionCanAcceptFormatDescription(c->vt, fmt)) {
+        virgl_warn("vt: new parameter sets need a new session\n");
+        vt_release_session(c);
+    }
+    return c->vt ? 0 : vt_create_session(c);
+}
+
+/* The session is lost (the app went to the background, or the decoder failed): a new one at the next intra picture */
+static bool vt_session_lost(OSStatus st)
+{
+    return st == kVTInvalidSessionErr || st == kVTVideoDecoderMalfunctionErr;
+}
+
+/* The frame goes to the target's plane textures as an IOSurface: vrend copies it on the GPU */
+static void vt_emit(struct virgl_video_codec *c, CVPixelBufferRef out)
+{
+    IOSurfaceRef surf = CVPixelBufferGetIOSurface(out);
+    struct virgl_video_dma_buf d;
+    bool bi = CVPixelBufferGetPlaneCount(out) == 2;
+
+    if (!callbacks || !callbacks->decode_completed || !surf)
+        return;
+    memset(&d, 0, sizeof(d));
+    d.buf = c->target;
+    d.flags = VIRGL_VIDEO_DMABUF_READ_ONLY;
+    d.width = (uint32_t)CVPixelBufferGetWidth(out);
+    d.height = (uint32_t)CVPixelBufferGetHeight(out);
+    d.num_planes = (uint32_t)CVPixelBufferGetPlaneCount(out);
+    if (d.num_planes > 3)
+        d.num_planes = 3;
+    d.iosurface = (void *)surf;
+    d.pool = c->pool;
+    for (uint32_t i = 0; i < d.num_planes; i++) {
+        /* VideoToolbox's planar order is Y, Cb, Cr; YV12 is Y, Cr, Cb */
+        size_t src = c->target->format == PIPE_FORMAT_YV12 && i ? 3 - i : i;
+        d.planes[i].fd = -1;
+        d.planes[i].plane = (uint32_t)src;
+        d.planes[i].pitch = (uint32_t)IOSurfaceGetBytesPerRowOfPlane(surf, src);
+        d.planes[i].width = (uint32_t)IOSurfaceGetWidthOfPlane(surf, src);
+        d.planes[i].height = (uint32_t)IOSurfaceGetHeightOfPlane(surf, src);
+        d.planes[i].cpp = (uint32_t)IOSurfaceGetBytesPerElementOfPlane(surf, src);
+        d.planes[i].channels = bi && src == 1 ? 2 : 1;
+    }
+    callbacks->decode_completed(c, &d);
+}
+
+/* One sample, decoded synchronously: no asynchronous decode and no temporal processing, so one frame out, in
+ * decode order. A hidden frame (shown false) may give none. */
+static int vt_decode(struct virgl_video_codec *c, uint8_t *data, size_t len, bool shown)
+{
+    CMBlockBufferRef bb = NULL;
+    CMSampleBufferRef sb = NULL;
+    size_t size = len;
+    OSStatus st = CMBlockBufferCreateWithMemoryBlock(NULL, data, len, kCFAllocatorNull, NULL, 0, len, 0, &bb);
+    if (st == noErr)
+        st = CMSampleBufferCreateReady(NULL, bb, c->fmt, 1, 0, NULL, 1, &size, &sb);
+    if (st != noErr) {
+        virgl_error("vt: no sample buffer (%d)\n", (int)st);
+        if (bb)
+            CFRelease(bb);
+        return -1;
+    }
+    c->out_status = noErr;
+    st = VTDecompressionSessionDecodeFrame(c->vt, sb, 0, NULL, NULL);
+    if (st == noErr)
+        VTDecompressionSessionWaitForAsynchronousFrames(c->vt);
+    CFRelease(sb);
+    CFRelease(bb);
+    if (st != noErr || c->out_status != noErr || (shown && !c->out)) {
+        virgl_error("vt: frame %u not decoded (%d, %d)\n", c->frames, (int)st, (int)c->out_status);
+        if (vt_session_lost(st) || vt_session_lost(c->out_status))
+            vt_release_session(c);
+        return -1;
+    }
+    if (c->out) {
+        CVPixelBufferRef out = c->out;
+        c->out = NULL;
+        if (!c->no_emit)
+            vt_emit(c, out);
+        CVPixelBufferRelease(out);
+    }
+    return 0;
+}
+
+static int h264_decode(struct virgl_video_codec *c)
+{
+    uint8_t ps[VT_PS_MAX];
+    size_t len;
+    bool changed = false;
+    struct vt_pps *pp;
+
+    if (!c->have_desc || c->pps_id < 0 || !c->au_len)
+        return -1;
+    if (c->desc.field_pic_flag) {
+        if (!c->warned_field)
+            virgl_warn("vt: field pictures (PAFF) are not supported\n");
+        c->warned_field = true;
+        return -1;
+    }
+    /* VA-API has one PPS per picture */
+    if (c->pps_mixed) {
+        if (!c->warned_pps)
+            virgl_warn("vt: the slices of one picture name more than one PPS, not supported\n");
+        c->warned_pps = true;
+        return -1;
+    }
+    if (c->desc.pps.sps.pic_order_cnt_type == 1 && !c->warned_poc1) {
+        virgl_warn("vt: pic_order_cnt_type 1: VA-API does not carry the offsets, frames can be wrong\n");
+        c->warned_poc1 = true;
+    }
+
+    len = h264_write_sps(c, &c->desc, ps);
+    if (!len)
+        return -1;
+    if (len != c->sps_len || memcmp(ps, c->sps, len)) {
+        memcpy(c->sps, ps, len);
+        c->sps_len = len;
+        changed = true;
+    }
+    pp = &c->pps[c->pps_id];
+    len = h264_write_pps(c, &c->desc, (unsigned)c->pps_id, ps);
+    if (!len)
+        return -1;
+    if (len != pp->len || memcmp(ps, pp->nal, len)) {
+        uint8_t *n = realloc(pp->nal, len);
+        if (!n)
+            return -1;
+        memcpy(n, ps, len);
+        pp->nal = n, pp->len = len;
+        changed = true;
+    }
+    /* FFmpeg asks for I420 surfaces, mpv for NV12: the target's format picks the output */
+    if (c->vt && c->pixfmt != vt_pixfmt(c->target->format)) {
+        virgl_warn("vt: the target format changed, new session\n");
+        vt_release_session(c);
+    }
+    c->pixfmt = vt_pixfmt(c->target->format);
+    if (changed && c->vt)
+        c->ps_updates++;
+    if ((changed || !c->vt) && vt_update_format(c))
+        return -1;
+
+    return vt_decode(c, c->au, c->au_len, true);
+}
+
+/* ---- VP9 ---- */
+
+/* The guest's buffers as they are, after those of the picture's earlier calls */
+static int au_take_raw(struct virgl_video_codec *c, unsigned num_buffers, const void *const *buffers,
+                       const unsigned *sizes)
+{
+    for (unsigned i = 0; i < num_buffers; i++) {
+        if (!buffers[i] || !sizes[i])
+            continue;
+        if (sizes[i] > VT_AU_MAX || c->au_len + sizes[i] > VT_AU_MAX) {
+            virgl_error("vt: a frame has more than %u bytes\n", VT_AU_MAX);
+            return -1;
+        }
+        if (c->au_len + sizes[i] > c->au_cap) {
+            size_t cap = c->au_cap ? c->au_cap : 1 << 16;
+            while (cap < c->au_len + sizes[i])
+                cap *= 2;
+            uint8_t *n = realloc(c->au, cap);
+            if (!n)
+                return -1;
+            c->au = n, c->au_cap = cap;
+        }
+        memcpy(c->au + c->au_len, buffers[i], sizes[i]);
+        c->au_len += sizes[i];
+    }
+    return 0;
+}
+
+/* color_config(): read only to reach the frame size */
+static void vp9_color_config(struct br *b, unsigned profile)
+{
+    if (profile >= 2)
+        br_bit(b); /* ten_or_twelve_bit */
+    if (br_u(b, 3) != 7) { /* not CS_RGB */
+        br_bit(b);
+        if (profile == 1 || profile == 3)
+            br_u(b, 3);
+    } else if (profile == 1 || profile == 3) {
+        br_bit(b);
+    }
+}
+
+/* The uncompressed header up to the frame size: is it a key, intra-only or hidden frame. VideoToolbox sizes its
+ * output from the stream, so a coded size must be the descriptor's (at most 4096). */
+static bool vp9_parse_header(struct virgl_video_codec *c, const uint8_t *p, size_t n, unsigned w, unsigned h)
+{
+    struct br b = {.p = p, .len = n, .raw = true};
+    unsigned profile;
+
+    if (br_u(&b, 2) != 2)
+        return false;
+    profile = br_bit(&b);
+    profile |= br_bit(&b) << 1;
+    if (profile == 3)
+        br_bit(&b);
+    if (br_bit(&b)) /* show_existing_frame: FFmpeg shows the reference itself */
+        return false;
+    bool key = !br_bit(&b);
+    c->pic_shown = br_bit(&b);
+    bool error_res = br_bit(&b);
+    bool intra_only = false, sized = true;
+    c->pic_idr = key;
+    /* an intra-only frame keeps the other references: only a key frame resumes after a failure */
+    c->pic_intra = false;
+    if (!key) {
+        intra_only = c->pic_shown ? false : br_bit(&b);
+        if (!error_res)
+            br_u(&b, 2);
+    }
+    if ((key || intra_only) && br_u(&b, 24) != 0x498342)
+        return false;
+    if (key || (intra_only && profile > 0))
+        vp9_color_config(&b, profile);
+    if (!key)
+        br_u(&b, 8); /* refresh_frame_flags */
+    if (!key && !intra_only) {
+        br_u(&b, 12); /* ref_frame_idx and sign bias */
+        /* found_ref: a reference's size, checked when it was coded */
+        for (unsigned i = 0; i < 3 && sized; i++)
+            sized = !br_bit(&b);
+    }
+    if (sized) {
+        unsigned cw = br_u(&b, 16) + 1, ch = br_u(&b, 16) + 1;
+        if (!b.err && (cw != w || ch != h)) {
+            virgl_warn("vt: VP9 frame codes %ux%u, its descriptor %ux%u\n", cw, ch, w, h);
+            return false;
+        }
+    }
+    return !b.err && profile == c->vp9_profile;
+}
+
+static int vp9_take(struct virgl_video_codec *c, const struct virgl_vp9_picture_desc *d, unsigned num_buffers,
+                    const void *const *buffers, const unsigned *sizes)
+{
+    unsigned depth = d->picture_parameter.bit_depth;
+
+    if (d->picture_parameter.profile != c->vp9_profile || (depth != 8 && depth != 10) ||
+        (c->vp9_profile == 0) != (depth == 8) || !d->picture_parameter.frame_width ||
+        !d->picture_parameter.frame_height || d->picture_parameter.frame_width > 4096 ||
+        d->picture_parameter.frame_height > 4096) {
+        virgl_warn("vt: VP9 frame refused (profile %u, %u bits, %ux%u)\n", d->picture_parameter.profile, depth,
+                   d->picture_parameter.frame_width, d->picture_parameter.frame_height);
+        return -1;
+    }
+    c->vp9_depth = depth;
+    if (au_take_raw(c, num_buffers, buffers, sizes))
+        return -1;
+    if (!vp9_parse_header(c, c->au, c->au_len, d->picture_parameter.frame_width, d->picture_parameter.frame_height)) {
+        virgl_warn("vt: a VP9 frame header does not parse\n");
+        return -1;
+    }
+    c->vp9_w = d->picture_parameter.frame_width;
+    c->vp9_h = d->picture_parameter.frame_height;
+    c->have_desc = true;
+    c->pic_slices = 1;
+    return 0;
+}
+
+static CMVideoFormatDescriptionRef vp9_format(const struct virgl_video_codec *c)
+{
+    unsigned area = c->vp9_w * c->vp9_h;
+    uint8_t level = area <= 2228224 ? 41 : area <= 8912896 ? 51 : 61;
+    /* vpcC version 1: profile, level, bit depth, 4:2:0 co-located, video range, unspecified colour */
+    const uint8_t vpcc[] = {1, 0, 0, 0, (uint8_t)c->vp9_profile, level, (uint8_t)(c->vp9_depth << 4 | 1 << 1), 2, 2, 2, 0, 0};
+    CFDataRef data = CFDataCreate(NULL, vpcc, sizeof(vpcc));
+    CFMutableDictionaryRef atoms = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                             &kCFTypeDictionaryValueCallBacks);
+    CFMutableDictionaryRef ext = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                           &kCFTypeDictionaryValueCallBacks);
+    CMVideoFormatDescriptionRef fmt = NULL;
+
+    CFDictionarySetValue(atoms, CFSTR("vpcC"), data);
+    CFDictionarySetValue(ext, kCMFormatDescriptionExtension_SampleDescriptionExtensionAtoms, atoms);
+    OSStatus st = CMVideoFormatDescriptionCreate(NULL, kCMVideoCodecType_VP9, (int32_t)c->vp9_w, (int32_t)c->vp9_h,
+                                                 ext, &fmt);
+    CFRelease(ext);
+    CFRelease(atoms);
+    CFRelease(data);
+    if (st != noErr) {
+        virgl_error("vt: no VP9 format description (%d)\n", (int)st);
+        return NULL;
+    }
+    return fmt;
+}
+
+static int vp9_decode(struct virgl_video_codec *c)
+{
+    if (!c->have_desc || !c->au_len)
+        return -1;
+    if (c->vt && c->pixfmt != vt_pixfmt(c->target->format)) {
+        virgl_warn("vt: the target format changed, new session\n");
+        vt_release_session(c);
+    }
+    c->pixfmt = vt_pixfmt(c->target->format);
+    if ((c->vp9_depth == 10) != (c->pixfmt == kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange)) {
+        virgl_warn("vt: VP9 at %u bits into a %s target\n", c->vp9_depth, c->vp9_depth == 10 ? "8-bit" : "P010");
+        return -1;
+    }
+    /* a new size only at a key frame: inter frames may scale their references */
+    if (!c->vt || !c->fmt || (c->pic_idr && (c->fmt_w != c->vp9_w || c->fmt_h != c->vp9_h))) {
+        CMVideoFormatDescriptionRef fmt = vp9_format(c);
+        if (!fmt)
+            return -1;
+        if (c->vt)
+            c->ps_updates++;
+        c->fmt_w = c->vp9_w, c->fmt_h = c->vp9_h;
+        if (vt_set_format(c, fmt))
+            return -1;
+    }
+    return vt_decode(c, c->au, c->au_len, c->pic_shown);
+}
+
+/* ---- AV1 ----
+ *
+ * virgl carries only the tile data and the parsed fields, so this writes a sequence header OBU and a frame header
+ * OBU from the fields, and a tile group OBU around the tiles. VA-API has no refresh_frame_flags, so the back end
+ * keeps its own map of VideoToolbox's 8 reference slots: the guest's ref[] says which surface is in each of its
+ * slots, and ref_frame_idx is rewritten to the slot that holds that surface. A frame goes into a slot whose surface
+ * the guest no longer holds. When all 8 are held, it is decoded without a refresh, and decoded again into a freed
+ * slot when the next frame shows which one the guest freed. Hidden frames are written as shown, so that the guest's
+ * surface gets the pixels (FFmpeg shows them later through show_existing_frame, which the host never sees).
+ */
+
+#define AV1_NONE 7 /* PRIMARY_REF_NONE */
+#define AV1_KEY 0
+#define AV1_INTRA_ONLY 2
+#define AV1_SWITCH 3
+#define AV1_OBU_SEQ 1
+#define AV1_OBU_FH 3
+#define AV1_OBU_TG 4
+#define AV1_HDR_MAX 4096
+#define AV1_TILE_BYTES 4
+
+static const uint8_t av1_seg_bits[8] = {8, 6, 6, 6, 6, 3, 0, 0};
+static const uint8_t av1_seg_signed[8] = {1, 1, 1, 1, 1, 0, 0, 0};
+static const int av1_seg_max[8] = {255, 63, 63, 63, 63, 7, 0, 0};
+
+static unsigned floor_log2(uint32_t n)
+{
+    unsigned s = 0;
+    while (n > 1)
+        n >>= 1, s++;
+    return s;
+}
+
+static unsigned tile_log2(unsigned blk, unsigned target)
+{
+    unsigned k = 0;
+    while ((blk << k) < target)
+        k++;
+    return k;
+}
+
+static void bw_su(struct bw *b, int32_t v, unsigned n)
+{
+    bw_u(b, (uint32_t)v & ((1u << n) - 1), n);
+}
+
+static void bw_ns(struct bw *b, uint32_t n, uint32_t v)
+{
+    unsigned w = floor_log2(n) + 1;
+    uint32_t m = (1u << w) - n;
+    if (v < m) {
+        bw_u(b, v, w - 1);
+    } else {
+        uint32_t t = v + m;
+        bw_u(b, t >> 1, w - 1);
+        bw_u(b, t & 1, 1);
+    }
+}
+
+static void bw_leb128(uint8_t *out, size_t *o, size_t v)
+{
+    do {
+        uint8_t byte = v & 0x7f;
+        v >>= 7;
+        out[(*o)++] = byte | (v ? 0x80 : 0);
+    } while (v);
+}
+
+/* Byte-aligned payload with trailing bits, as one OBU with a size field */
+static size_t av1_obu(struct bw *b, unsigned type, bool trailing, uint8_t *out, size_t cap)
+{
+    size_t o = 0;
+    if (trailing)
+        bw_u(b, 1, 1);
+    while (b->nb)
+        bw_u(b, 0, 1);
+    if (b->err || cap < b->n + 10)
+        return 0;
+    out[o++] = (uint8_t)(type << 3 | 2);
+    bw_leb128(out, &o, b->n);
+    memcpy(out + o, b->rbsp, b->n);
+    return o + b->n;
+}
+
+static unsigned av1_recenter(unsigned r, unsigned v)
+{
+    if (v > 2 * r)
+        return v;
+    return v >= r ? (v - r) << 1 : ((r - v) << 1) - 1;
+}
+
+static void av1_subexp(struct bw *b, unsigned num, unsigned v)
+{
+    unsigned i = 0, mk = 0, k = 3;
+    for (;;) {
+        unsigned b2 = i ? k + i - 1 : k, a = 1u << b2;
+        if (num <= mk + 3 * a) {
+            bw_ns(b, num - mk, v - mk);
+            return;
+        }
+        bool more = v >= mk + a;
+        bw_u(b, more, 1);
+        if (!more) {
+            bw_u(b, v - mk, b2);
+            return;
+        }
+        i++, mk += a;
+    }
+}
+
+/* The inverse of read_global_param */
+static void av1_global_param(struct bw *b, unsigned type, unsigned idx, int32_t value, int32_t prev, bool hp)
+{
+    unsigned abs_bits = 12, prec_bits = 15;
+    if (idx < 2) {
+        abs_bits = type == 1 ? 9 - !hp : 12;
+        prec_bits = type == 1 ? 3 - !hp : 6;
+    }
+    unsigned prec_diff = 16 - prec_bits;
+    int64_t round = idx % 3 == 2 ? 1 << 16 : 0, sub = idx % 3 == 2 ? 1 << prec_bits : 0, mx = 1 << abs_bits;
+    int64_t r = ((int64_t)prev >> prec_diff) - sub, x = ((int64_t)value - round) >> prec_diff;
+    if (x < -mx)
+        x = -mx;
+    if (x > mx)
+        x = mx;
+    if (r < -mx)
+        r = -mx;
+    if (r > mx)
+        r = mx;
+    unsigned n = 2 * mx + 1, ru = (unsigned)(r + mx), vu = (unsigned)(x + mx);
+    av1_subexp(b, n, (ru << 1) <= n ? av1_recenter(ru, vu) : av1_recenter(n - 1 - ru, n - 1 - vu));
+}
+
+static int av1_relative_dist(unsigned bits, unsigned a, unsigned b)
+{
+    int diff = (int)a - (int)b, m = 1 << (bits - 1);
+    return (diff & (m - 1)) - (diff & m);
+}
+
+static void av1_default_gm(int32_t gm[7][6])
+{
+    for (unsigned r = 0; r < 7; r++)
+        for (unsigned i = 0; i < 6; i++)
+            gm[r][i] = i % 3 == 2 ? 1 << 16 : 0;
+}
+
+struct av1_tiles {
+    unsigned cols, rows, cols_log2, rows_log2;
+    bool uniform;
+    uint32_t sb_cols, sb_rows;
+    uint16_t w[64], h[64]; /* in superblocks */
+};
+
+/* The guest's layout, checked against the frame size; uniform when it is one */
+static bool av1_tiles(const struct virgl_av1_picture_desc *d, unsigned width, unsigned height, struct av1_tiles *t)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    bool sb128 = p->seq_info_fields.use_128x128_superblock;
+    unsigned mi_cols = 2 * ((width + 7) >> 3), mi_rows = 2 * ((height + 7) >> 3);
+    unsigned sb_shift = sb128 ? 5 : 4, sb_size = sb_shift + 2;
+    t->sb_cols = sb128 ? (mi_cols + 31) >> 5 : (mi_cols + 15) >> 4;
+    t->sb_rows = sb128 ? (mi_rows + 31) >> 5 : (mi_rows + 15) >> 4;
+    t->cols = p->tile_cols, t->rows = p->tile_rows;
+    if (!t->cols || !t->rows || t->cols > 64 || t->rows > 64 || t->cols * t->rows > 256)
+        return false;
+    /* Mesa's start arrays end with the frame's size; its uniform widths repeat the first one */
+    if (p->tile_col_start_sb[0] || p->tile_row_start_sb[0] || p->tile_col_start_sb[t->cols] != t->sb_cols ||
+        p->tile_row_start_sb[t->rows] != t->sb_rows)
+        return false;
+    for (unsigned i = 0; i < t->cols; i++) {
+        if (p->tile_col_start_sb[i + 1] <= p->tile_col_start_sb[i])
+            return false;
+        t->w[i] = (uint16_t)(p->tile_col_start_sb[i + 1] - p->tile_col_start_sb[i]);
+    }
+    for (unsigned i = 0; i < t->rows; i++) {
+        if (p->tile_row_start_sb[i + 1] <= p->tile_row_start_sb[i])
+            return false;
+        t->h[i] = (uint16_t)(p->tile_row_start_sb[i + 1] - p->tile_row_start_sb[i]);
+    }
+    unsigned max_w_sb = 4096 >> sb_size, max_area_sb = (4096 * 2304) >> (2 * sb_size);
+    unsigned min_cols = tile_log2(max_w_sb, t->sb_cols), max_cols = tile_log2(1, MIN2(t->sb_cols, 64));
+    unsigned max_rows = tile_log2(1, MIN2(t->sb_rows, 64));
+    unsigned min_tiles = MAX2(min_cols, tile_log2(max_area_sb, t->sb_rows * t->sb_cols));
+    t->uniform = false;
+    for (unsigned cl = min_cols; cl <= max_cols && !t->uniform; cl++) {
+        unsigned w = (t->sb_cols + (1u << cl) - 1) >> cl, n = (t->sb_cols + w - 1) / w;
+        bool same = n == t->cols;
+        for (unsigned i = 0; same && i < n; i++)
+            same = p->tile_col_start_sb[i] == i * w;
+        if (!same)
+            continue;
+        for (unsigned rl = min_tiles > cl ? min_tiles - cl : 0; rl <= max_rows && !t->uniform; rl++) {
+            unsigned h = (t->sb_rows + (1u << rl) - 1) >> rl, m = (t->sb_rows + h - 1) / h;
+            bool rs = m == t->rows;
+            for (unsigned i = 0; rs && i < m; i++)
+                rs = p->tile_row_start_sb[i] == i * h;
+            if (rs)
+                t->uniform = true, t->cols_log2 = cl, t->rows_log2 = rl;
+        }
+    }
+    if (!t->uniform) {
+        t->cols_log2 = tile_log2(1, t->cols);
+        t->rows_log2 = tile_log2(1, t->rows);
+    }
+    return true;
+}
+
+static void av1_write_tile_info(struct bw *b, const struct virgl_av1_picture_desc *d, const struct av1_tiles *t)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    bool sb128 = p->seq_info_fields.use_128x128_superblock;
+    unsigned sb_size = sb128 ? 7 : 6;
+    unsigned max_w_sb = 4096 >> sb_size, max_area_sb = (4096 * 2304) >> (2 * sb_size);
+    unsigned min_cols = tile_log2(max_w_sb, t->sb_cols), max_cols = tile_log2(1, MIN2(t->sb_cols, 64));
+    unsigned max_rows = tile_log2(1, MIN2(t->sb_rows, 64));
+    unsigned min_tiles = MAX2(min_cols, tile_log2(max_area_sb, t->sb_rows * t->sb_cols));
+
+    bw_u(b, t->uniform, 1);
+    if (t->uniform) {
+        for (unsigned l = min_cols; l < max_cols; l++) {
+            bw_u(b, l < t->cols_log2, 1);
+            if (l >= t->cols_log2)
+                break;
+        }
+        for (unsigned l = min_tiles > t->cols_log2 ? min_tiles - t->cols_log2 : 0; l < max_rows; l++) {
+            bw_u(b, l < t->rows_log2, 1);
+            if (l >= t->rows_log2)
+                break;
+        }
+    } else {
+        unsigned widest = 0;
+        for (unsigned i = 0, s = 0; i < t->cols; s += t->w[i], i++) {
+            bw_ns(b, MIN2(t->sb_cols - s, max_w_sb), t->w[i] - 1u);
+            widest = MAX2(widest, t->w[i]);
+        }
+        unsigned area = min_tiles ? (t->sb_rows * t->sb_cols) >> (min_tiles + 1) : t->sb_rows * t->sb_cols;
+        unsigned max_h_sb = MAX2(area / widest, 1);
+        for (unsigned i = 0, s = 0; i < t->rows; s += t->h[i], i++)
+            bw_ns(b, MIN2(t->sb_rows - s, max_h_sb), t->h[i] - 1u);
+    }
+    if (t->cols_log2 || t->rows_log2) {
+        bw_u(b, p->context_update_tile_id, t->rows_log2 + t->cols_log2);
+        bw_u(b, AV1_TILE_BYTES - 1, 2);
+    }
+}
+
+/* What the format description and the sequence header come from */
+struct av1_seq {
+    uint8_t profile, depth_idx, order_hint_bits, flags_a, flags_b;
+    uint16_t max_w, max_h;
+};
+
+static size_t av1_write_seq(const struct virgl_av1_picture_desc *d, uint8_t *out, size_t cap, unsigned *level)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    const __typeof__(p->seq_info_fields) *s = &p->seq_info_fields;
+    struct bw b = {0};
+    unsigned wb = MAX2(floor_log2(p->max_width - 1) + 1, 1), hb = MAX2(floor_log2(p->max_height - 1) + 1, 1);
+    unsigned area = (unsigned)p->max_width * p->max_height;
+
+    *level = area <= 2228224 ? 8 : area <= 8912896 ? 12 : 16; /* 4.0, 5.0, 6.0 */
+    bw_u(&b, p->profile, 3);
+    bw_u(&b, 0, 1); /* still_picture */
+    bw_u(&b, 0, 1); /* reduced_still_picture_header */
+    bw_u(&b, 0, 1); /* timing_info_present_flag */
+    bw_u(&b, 0, 1); /* initial_display_delay_present_flag */
+    bw_u(&b, 0, 5); /* operating_points_cnt_minus_1 */
+    bw_u(&b, 0, 12); /* operating_point_idc[0] */
+    bw_u(&b, *level, 5);
+    if (*level > 7)
+        bw_u(&b, 0, 1); /* seq_tier */
+    bw_u(&b, wb - 1, 4);
+    bw_u(&b, hb - 1, 4);
+    bw_u(&b, p->max_width - 1, wb);
+    bw_u(&b, p->max_height - 1, hb);
+    bw_u(&b, 0, 1); /* frame_id_numbers_present_flag: not carried */
+    bw_u(&b, s->use_128x128_superblock, 1);
+    bw_u(&b, s->enable_filter_intra, 1);
+    bw_u(&b, s->enable_intra_edge_filter, 1);
+    bw_u(&b, s->enable_interintra_compound, 1);
+    bw_u(&b, s->enable_masked_compound, 1);
+    bw_u(&b, 1, 1); /* enable_warped_motion: not carried; each frame codes allow_warped_motion */
+    bw_u(&b, s->enable_dual_filter, 1);
+    bw_u(&b, s->enable_order_hint, 1);
+    if (s->enable_order_hint) {
+        bw_u(&b, s->enable_jnt_comp, 1);
+        bw_u(&b, s->ref_frame_mvs, 1);
+    }
+    bw_u(&b, 1, 1); /* seq_choose_screen_content_tools: each frame codes it */
+    bw_u(&b, 1, 1); /* seq_choose_integer_mv */
+    if (s->enable_order_hint)
+        bw_u(&b, p->order_hint_bits_minus_1, 3);
+    bw_u(&b, 1, 1); /* enable_superres: not carried; each frame codes use_superres */
+    bw_u(&b, s->enable_cdef, 1);
+    bw_u(&b, 1, 1); /* enable_restoration: not carried; each frame codes lr_type */
+    /* color_config */
+    bw_u(&b, p->bit_depth_idx > 0, 1);
+    bw_u(&b, s->mono_chrome, 1);
+    bw_u(&b, 0, 1); /* color_description_present_flag */
+    bw_u(&b, 0, 1); /* color_range: decoding does not depend on it */
+    if (!s->mono_chrome) {
+        bw_u(&b, 0, 2); /* chroma_sample_position */
+        bw_u(&b, 1, 1); /* separate_uv_delta_q: each frame then codes the V deltas */
+    }
+    bw_u(&b, s->film_grain_params_present, 1);
+    return av1_obu(&b, AV1_OBU_SEQ, true, out, cap);
+}
+
+static void av1_delta_q(struct bw *b, int v)
+{
+    bw_u(b, v != 0, 1);
+    if (v)
+        bw_su(b, v, 7);
+}
+
+static void av1_write_quant(struct bw *b, const struct virgl_av1_picture_desc *d)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    bool diff = p->u_dc_delta_q != p->v_dc_delta_q || p->u_ac_delta_q != p->v_ac_delta_q;
+
+    bw_u(b, p->base_qindex, 8);
+    av1_delta_q(b, p->y_dc_delta_q);
+    if (!p->seq_info_fields.mono_chrome) {
+        bw_u(b, diff, 1); /* diff_uv_delta: the sequence header has separate_uv_delta_q */
+        av1_delta_q(b, p->u_dc_delta_q);
+        av1_delta_q(b, p->u_ac_delta_q);
+        if (diff) {
+            av1_delta_q(b, p->v_dc_delta_q);
+            av1_delta_q(b, p->v_ac_delta_q);
+        }
+    }
+    bw_u(b, p->qmatrix_fields.using_qmatrix, 1);
+    if (p->qmatrix_fields.using_qmatrix) {
+        bw_u(b, p->qmatrix_fields.qm_y, 4);
+        bw_u(b, p->qmatrix_fields.qm_u, 4);
+        if (!p->seq_info_fields.mono_chrome)
+            bw_u(b, p->qmatrix_fields.qm_v, 4);
+    }
+}
+
+/* The frame header, with the VideoToolbox slots for the references and refresh as the frame's refreshed slots */
+static size_t av1_write_frame_header(struct virgl_video_codec *c, const struct virgl_av1_picture_desc *d,
+                                     const uint8_t vt_idx[7], uint8_t refresh, const struct av1_tiles *t,
+                                     bool lossless, uint8_t *out, size_t cap)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    const __typeof__(p->seq_info_fields) *s = &p->seq_info_fields;
+    const __typeof__(p->pic_info_fields) *f = &p->pic_info_fields;
+    struct bw b = {0};
+    unsigned type = f->frame_type, oh_bits = s->enable_order_hint ? p->order_hint_bits_minus_1 + 1 : 0;
+    bool intra = type == AV1_KEY || type == AV1_INTRA_ONLY;
+    bool show = f->show_frame || type != AV1_KEY; /* hidden non-key frames are written as shown */
+    bool er = (type == AV1_KEY && show) || f->error_resilient_mode;
+    bool sct = f->allow_screen_content_tools, fimv = sct && f->force_integer_mv;
+    unsigned prim = intra || er ? AV1_NONE : p->primary_ref_frame;
+    unsigned wb = MAX2(floor_log2(p->max_width - 1) + 1, 1), hb = MAX2(floor_log2(p->max_height - 1) + 1, 1);
+    unsigned denom = f->use_superres ? p->superres_scale_denominator : 8;
+    unsigned down_w = (p->frame_width * 8 + denom / 2) / denom;
+    bool intrabc = intra && sct && down_w == p->frame_width && f->allow_intrabc;
+    const struct av1_slot *prev = prim != AV1_NONE ? &c->av1_slots[vt_idx[prim]] : NULL;
+    int32_t prev_gm[7][6];
+    unsigned planes = s->mono_chrome ? 1 : 3;
+
+    bw_u(&b, 0, 1); /* show_existing_frame */
+    bw_u(&b, type, 2);
+    bw_u(&b, show, 1);
+    if (!show)
+        bw_u(&b, f->showable_frame, 1);
+    if (!(type == AV1_KEY && show))
+        bw_u(&b, f->error_resilient_mode, 1);
+    bw_u(&b, f->disable_cdf_update, 1);
+    bw_u(&b, sct, 1);
+    if (sct)
+        bw_u(&b, f->force_integer_mv, 1);
+    bw_u(&b, 1, 1); /* frame_size_override_flag: the size is always coded */
+    bw_u(&b, p->order_hint, oh_bits);
+    if (!(intra || er))
+        bw_u(&b, prim, 3);
+    if (!(type == AV1_KEY && show)) {
+        bw_u(&b, refresh, 8);
+        if (er && s->enable_order_hint && (!intra || refresh != 0xff))
+            for (unsigned i = 0; i < 8; i++)
+                bw_u(&b, c->av1_slots[i].order_hint, oh_bits);
+    }
+    if (!intra) {
+        if (s->enable_order_hint)
+            bw_u(&b, 0, 1); /* frame_refs_short_signaling */
+        for (unsigned i = 0; i < 7; i++)
+            bw_u(&b, vt_idx[i], 3);
+        if (!er)
+            for (unsigned i = 0; i < 7; i++)
+                bw_u(&b, 0, 1); /* found_ref */
+    }
+    /* frame_size, superres_params, render_size */
+    bw_u(&b, p->frame_width - 1, wb);
+    bw_u(&b, p->frame_height - 1, hb);
+    bw_u(&b, f->use_superres, 1);
+    if (f->use_superres)
+        bw_u(&b, denom - 9, 3);
+    bw_u(&b, 0, 1);
+    if (intra) {
+        if (sct && down_w == p->frame_width)
+            bw_u(&b, intrabc, 1);
+    } else {
+        if (!fimv)
+            bw_u(&b, f->allow_high_precision_mv, 1);
+        bw_u(&b, p->interp_filter == 4, 1);
+        if (p->interp_filter != 4)
+            bw_u(&b, p->interp_filter, 2);
+        bw_u(&b, f->is_motion_mode_switchable, 1);
+        if (!(er || !s->ref_frame_mvs))
+            bw_u(&b, f->use_ref_frame_mvs, 1);
+    }
+    if (!f->disable_cdf_update)
+        bw_u(&b, f->disable_frame_end_update_cdf, 1);
+    av1_write_tile_info(&b, d, t);
+    av1_write_quant(&b, d);
+    /* segmentation_params */
+    const __typeof__(p->seg_info) *seg = &p->seg_info;
+    bw_u(&b, seg->segment_info_fields.enabled, 1);
+    bool update_data = prim == AV1_NONE || seg->segment_info_fields.update_data;
+    if (seg->segment_info_fields.enabled) {
+        if (prim != AV1_NONE) {
+            bw_u(&b, seg->segment_info_fields.update_map, 1);
+            if (seg->segment_info_fields.update_map)
+                bw_u(&b, seg->segment_info_fields.temporal_update, 1);
+            bw_u(&b, seg->segment_info_fields.update_data, 1);
+        }
+        if (update_data)
+            for (unsigned i = 0; i < 8; i++)
+                for (unsigned j = 0; j < 8; j++) {
+                    bool on = seg->feature_mask[i] >> j & 1;
+                    bw_u(&b, on, 1);
+                    if (on && av1_seg_signed[j])
+                        bw_su(&b, seg->feature_data[i][j], 1 + av1_seg_bits[j]);
+                    else if (on)
+                        bw_u(&b, seg->feature_data[i][j], av1_seg_bits[j]);
+                }
+    }
+    /* delta_q_params, delta_lf_params */
+    const __typeof__(p->mode_control_fields) *mc = &p->mode_control_fields;
+    if (p->base_qindex) {
+        bw_u(&b, mc->delta_q_present_flag, 1);
+        if (mc->delta_q_present_flag) {
+            bw_u(&b, mc->log2_delta_q_res, 2);
+            if (!intrabc)
+                bw_u(&b, mc->delta_lf_present_flag, 1);
+            if (!intrabc && mc->delta_lf_present_flag) {
+                bw_u(&b, mc->log2_delta_lf_res, 2);
+                bw_u(&b, mc->delta_lf_multi, 1);
+            }
+        }
+    }
+    bool all_lossless = lossless && down_w == p->frame_width;
+    /* loop_filter_params */
+    if (!lossless && !intrabc) {
+        bw_u(&b, p->filter_level[0], 6);
+        bw_u(&b, p->filter_level[1], 6);
+        if (planes > 1 && (p->filter_level[0] || p->filter_level[1])) {
+            bw_u(&b, p->filter_level_u, 6);
+            bw_u(&b, p->filter_level_v, 6);
+        }
+        bw_u(&b, p->loop_filter_info_fields.sharpness_level, 3);
+        bw_u(&b, p->loop_filter_info_fields.mode_ref_delta_enabled, 1);
+        if (p->loop_filter_info_fields.mode_ref_delta_enabled) {
+            bw_u(&b, p->loop_filter_info_fields.mode_ref_delta_update, 1);
+            /* the fields are the deltas in effect: write each one */
+            if (p->loop_filter_info_fields.mode_ref_delta_update) {
+                for (unsigned i = 0; i < 8; i++) {
+                    bw_u(&b, 1, 1);
+                    bw_su(&b, p->ref_deltas[i], 7);
+                }
+                for (unsigned i = 0; i < 2; i++) {
+                    bw_u(&b, 1, 1);
+                    bw_su(&b, p->mode_deltas[i], 7);
+                }
+            }
+        }
+    }
+    /* cdef_params */
+    if (!lossless && !intrabc && s->enable_cdef) {
+        bw_u(&b, p->cdef_damping_minus_3, 2);
+        bw_u(&b, p->cdef_bits, 2);
+        for (unsigned i = 0; i < (1u << (p->cdef_bits & 3)); i++) {
+            bw_u(&b, p->cdef_y_strengths[i] >> 2, 4);
+            bw_u(&b, p->cdef_y_strengths[i] & 3, 2);
+            if (planes > 1) {
+                bw_u(&b, p->cdef_uv_strengths[i] >> 2, 4);
+                bw_u(&b, p->cdef_uv_strengths[i] & 3, 2);
+            }
+        }
+    }
+    /* lr_params: VA's types are FrameRestorationType; the bitstream's lr_type is Remap_Lr_Type's inverse */
+    if (!all_lossless && !intrabc) {
+        static const uint8_t lr_code[4] = {0, 2, 3, 1};
+        const __typeof__(p->loop_restoration_fields) *lr = &p->loop_restoration_fields;
+        unsigned types[3] = {lr->yframe_restoration_type, lr->cbframe_restoration_type, lr->crframe_restoration_type};
+        bool uses = false, chroma = false;
+        for (unsigned i = 0; i < planes; i++) {
+            bw_u(&b, lr_code[types[i] & 3], 2);
+            uses |= types[i] != 0;
+            chroma |= i && types[i];
+        }
+        if (uses) {
+            unsigned shift = lr->lr_unit_shift;
+            if (s->use_128x128_superblock) {
+                bw_u(&b, shift > 1, 1);
+            } else {
+                bw_u(&b, shift > 0, 1);
+                if (shift)
+                    bw_u(&b, shift > 1, 1);
+            }
+            if (chroma)
+                bw_u(&b, lr->lr_uv_shift, 1);
+        }
+    }
+    /* read_tx_mode, frame_reference_mode, skip_mode_params */
+    if (!lossless)
+        bw_u(&b, mc->tx_mode == 2, 1);
+    if (!intra) {
+        bw_u(&b, mc->reference_select, 1);
+        bool skip_ok = false;
+        if (mc->reference_select && s->enable_order_hint) {
+            int fwd = -1, bwd = -1, fwd2 = -1;
+            unsigned fh = 0, bh = 0, fh2 = 0;
+            for (unsigned i = 0; i < 7; i++) {
+                unsigned h = c->av1_slots[vt_idx[i]].order_hint;
+                if (av1_relative_dist(oh_bits, h, p->order_hint) < 0) {
+                    if (fwd < 0 || av1_relative_dist(oh_bits, h, fh) > 0)
+                        fwd = (int)i, fh = h;
+                } else if (av1_relative_dist(oh_bits, h, p->order_hint) > 0) {
+                    if (bwd < 0 || av1_relative_dist(oh_bits, h, bh) < 0)
+                        bwd = (int)i, bh = h;
+                }
+            }
+            if (fwd >= 0 && bwd >= 0) {
+                skip_ok = true;
+            } else if (fwd >= 0) {
+                for (unsigned i = 0; i < 7; i++) {
+                    unsigned h = c->av1_slots[vt_idx[i]].order_hint;
+                    if (av1_relative_dist(oh_bits, h, fh) < 0 && (fwd2 < 0 || av1_relative_dist(oh_bits, h, fh2) > 0))
+                        fwd2 = (int)i, fh2 = h;
+                }
+                skip_ok = fwd2 >= 0;
+            }
+        }
+        if (skip_ok)
+            bw_u(&b, mc->skip_mode_present, 1);
+        if (!er)
+            bw_u(&b, f->allow_warped_motion, 1);
+    }
+    bw_u(&b, mc->reduced_tx_set_used, 1);
+    /* global_motion_params, against the primary reference's */
+    if (prev)
+        memcpy(prev_gm, prev->gm, sizeof(prev_gm));
+    else
+        av1_default_gm(prev_gm);
+    if (!intra) {
+        bool hp = !fimv && f->allow_high_precision_mv;
+        for (unsigned r = 0; r < 7; r++) {
+            unsigned gt = p->wm[r].wmtype & 3;
+            const int32_t *m = p->wm[r].wmmat;
+            bw_u(&b, gt != 0, 1);
+            if (gt) {
+                bw_u(&b, gt == 2, 1);
+                if (gt != 2)
+                    bw_u(&b, gt == 1, 1);
+            }
+            if (gt >= 2) {
+                av1_global_param(&b, gt, 2, m[2], prev_gm[r][2], hp);
+                av1_global_param(&b, gt, 3, m[3], prev_gm[r][3], hp);
+                if (gt == 3) {
+                    av1_global_param(&b, gt, 4, m[4], prev_gm[r][4], hp);
+                    av1_global_param(&b, gt, 5, m[5], prev_gm[r][5], hp);
+                }
+            }
+            if (gt >= 1) {
+                av1_global_param(&b, gt, 0, m[0], prev_gm[r][0], hp);
+                av1_global_param(&b, gt, 1, m[1], prev_gm[r][1], hp);
+            }
+        }
+    }
+    /* film_grain_params, always with update_grain */
+    if (s->film_grain_params_present && (show || f->showable_frame)) {
+        const __typeof__(p->film_grain_info) *g = &p->film_grain_info;
+        const __typeof__(g->film_grain_info_fields) *gf = &g->film_grain_info_fields;
+        bw_u(&b, gf->apply_grain, 1);
+        if (gf->apply_grain) {
+            unsigned ny = MIN2(g->num_y_points, 14), ncb = MIN2(g->num_cb_points, 10), ncr = MIN2(g->num_cr_points, 10);
+            bool csfl = !s->mono_chrome && gf->chroma_scaling_from_luma;
+            bw_u(&b, g->grain_seed, 16);
+            if (type == 1)
+                bw_u(&b, 1, 1);
+            bw_u(&b, ny, 4);
+            for (unsigned i = 0; i < ny; i++) {
+                bw_u(&b, g->point_y_value[i], 8);
+                bw_u(&b, g->point_y_scaling[i], 8);
+            }
+            if (!s->mono_chrome)
+                bw_u(&b, csfl, 1);
+            if (s->mono_chrome || csfl || !ny) {
+                ncb = ncr = 0;
+            } else {
+                bw_u(&b, ncb, 4);
+                for (unsigned i = 0; i < ncb; i++) {
+                    bw_u(&b, g->point_cb_value[i], 8);
+                    bw_u(&b, g->point_cb_scaling[i], 8);
+                }
+                bw_u(&b, ncr, 4);
+                for (unsigned i = 0; i < ncr; i++) {
+                    bw_u(&b, g->point_cr_value[i], 8);
+                    bw_u(&b, g->point_cr_scaling[i], 8);
+                }
+            }
+            bw_u(&b, gf->grain_scaling_minus_8, 2);
+            bw_u(&b, gf->ar_coeff_lag, 2);
+            unsigned lag = gf->ar_coeff_lag, pos_y = 2 * lag * (lag + 1), pos_c = pos_y + (ny ? 1 : 0);
+            for (unsigned i = 0; ny && i < pos_y; i++)
+                bw_u(&b, (uint32_t)(g->ar_coeffs_y[i] + 128), 8);
+            for (unsigned i = 0; (csfl || ncb) && i < pos_c; i++)
+                bw_u(&b, (uint32_t)(g->ar_coeffs_cb[i] + 128), 8);
+            for (unsigned i = 0; (csfl || ncr) && i < pos_c; i++)
+                bw_u(&b, (uint32_t)(g->ar_coeffs_cr[i] + 128), 8);
+            bw_u(&b, gf->ar_coeff_shift_minus_6, 2);
+            bw_u(&b, gf->grain_scale_shift, 2);
+            if (ncb) {
+                bw_u(&b, g->cb_mult, 8);
+                bw_u(&b, g->cb_luma_mult, 8);
+                bw_u(&b, g->cb_offset, 9);
+            }
+            if (ncr) {
+                bw_u(&b, g->cr_mult, 8);
+                bw_u(&b, g->cr_luma_mult, 8);
+                bw_u(&b, g->cr_offset, 9);
+            }
+            bw_u(&b, gf->overlap_flag, 1);
+            bw_u(&b, gf->clip_to_restricted_range, 1);
+        }
+    }
+    return av1_obu(&b, AV1_OBU_FH, true, out, cap);
+}
+
+/* The segment features in effect: the frame's, or its primary reference's when it keeps them */
+static void av1_seg(const struct virgl_av1_picture_desc *d, const struct av1_slot *prev, struct av1_slot *out)
+{
+    const __typeof__(d->picture_parameter.seg_info) *seg = &d->picture_parameter.seg_info;
+    out->seg_enabled = seg->segment_info_fields.enabled;
+    if (!out->seg_enabled) {
+        memset(out->seg_mask, 0, sizeof(out->seg_mask));
+        memset(out->seg_data, 0, sizeof(out->seg_data));
+    } else if (!prev || seg->segment_info_fields.update_data) {
+        memcpy(out->seg_mask, seg->feature_mask, sizeof(out->seg_mask));
+        for (unsigned i = 0; i < 8; i++)
+            for (unsigned j = 0; j < 8; j++) {
+                int v = seg->feature_data[i][j], m = av1_seg_max[j];
+                out->seg_data[i][j] = (int16_t)(v < (av1_seg_signed[j] ? -m : 0) ? (av1_seg_signed[j] ? -m : 0) : v > m ? m : v);
+            }
+    } else {
+        memcpy(out->seg_mask, prev->seg_mask, sizeof(out->seg_mask));
+        memcpy(out->seg_data, prev->seg_data, sizeof(out->seg_data));
+    }
+}
+
+static bool av1_coded_lossless(const struct virgl_av1_picture_desc *d, const struct av1_slot *seg)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    if (p->y_dc_delta_q || p->u_dc_delta_q || p->u_ac_delta_q || p->v_dc_delta_q || p->v_ac_delta_q)
+        return false;
+    for (unsigned i = 0; i < 8; i++) {
+        int q = p->base_qindex;
+        if (seg->seg_enabled && (seg->seg_mask[i] & 1))
+            q += seg->seg_data[i][0];
+        if (q > 0)
+            return false;
+    }
+    return true;
+}
+
+static uint8_t *av1_reserve(struct virgl_video_codec *c, size_t need)
+{
+    if (need > c->sample_cap) {
+        uint8_t *n = realloc(c->sample, need);
+        if (!n)
+            return NULL;
+        c->sample = n, c->sample_cap = need;
+    }
+    return c->sample;
+}
+
+/* [sequence header] frame header, tile group: one sample */
+static size_t av1_build(struct virgl_video_codec *c, const struct virgl_av1_picture_desc *d, const uint8_t *data,
+                        size_t len, const uint8_t vt_idx[7], uint8_t refresh, bool with_seq)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    const __typeof__(d->slice_parameter) *sp = &d->slice_parameter;
+    unsigned denom = p->pic_info_fields.use_superres ? p->superres_scale_denominator : 8;
+    unsigned down_w = (p->frame_width * 8 + denom / 2) / denom;
+    bool intra = p->pic_info_fields.frame_type == AV1_KEY || p->pic_info_fields.frame_type == AV1_INTRA_ONLY;
+    unsigned prim = intra || p->pic_info_fields.error_resilient_mode ? AV1_NONE : p->primary_ref_frame;
+    struct av1_tiles t;
+    struct av1_slot seg;
+    int16_t order[256];
+
+    if (!av1_tiles(d, down_w, p->frame_height, &t)) {
+        virgl_warn("vt: AV1 tile layout refused (%ux%u tiles)\n", p->tile_cols, p->tile_rows);
+        return 0;
+    }
+    unsigned num = t.cols * t.rows;
+    if (sp->slice_count != num) {
+        virgl_warn("vt: AV1 frame with %u of %u tiles\n", sp->slice_count, num);
+        return 0;
+    }
+    memset(order, 0xff, sizeof(order));
+    size_t tiles = 0;
+    for (unsigned i = 0; i < num; i++) {
+        unsigned r = sp->slice_data_row[i], col = sp->slice_data_col[i], k = r * t.cols + col;
+        uint64_t end = (uint64_t)sp->slice_data_offset[i] + sp->slice_data_size[i];
+        if (r >= t.rows || col >= t.cols || order[k] >= 0 || !sp->slice_data_size[i] || end > len) {
+            virgl_warn("vt: AV1 tile %u refused\n", i);
+            return 0;
+        }
+        order[k] = (int16_t)i;
+        tiles += sp->slice_data_size[i];
+    }
+    /* overlapping tiles would make the sample up to 256 times the guest's data */
+    if (tiles > len) {
+        virgl_warn("vt: AV1 tiles have %zu bytes in %zu\n", tiles, len);
+        return 0;
+    }
+    av1_seg(d, prim != AV1_NONE ? &c->av1_slots[vt_idx[prim]] : NULL, &seg);
+    bool lossless = av1_coded_lossless(d, &seg);
+
+    size_t need = (with_seq ? c->av1_seq_len : 0) + AV1_HDR_MAX + 16 + tiles + AV1_TILE_BYTES * num;
+    uint8_t *out = av1_reserve(c, need);
+    size_t o = 0, n;
+    if (!out)
+        return 0;
+    if (with_seq) {
+        memcpy(out, c->av1_seq, c->av1_seq_len);
+        o = c->av1_seq_len;
+    }
+    n = av1_write_frame_header(c, d, vt_idx, refresh, &t, lossless, out + o, AV1_HDR_MAX);
+    if (!n) {
+        virgl_warn("vt: no AV1 frame header\n");
+        return 0;
+    }
+    o += n;
+    /* tile_start_and_end_present_flag 0: one group with every tile, then byte_alignment */
+    size_t payload = (num > 1) + tiles + AV1_TILE_BYTES * (num - 1);
+    out[o++] = AV1_OBU_TG << 3 | 2;
+    bw_leb128(out, &o, payload);
+    if (num > 1)
+        out[o++] = 0;
+    for (unsigned k = 0; k < num; k++) {
+        unsigned i = (unsigned)order[k];
+        uint32_t size = sp->slice_data_size[i];
+        if (k != num - 1)
+            for (unsigned b = 0; b < AV1_TILE_BYTES; b++)
+                out[o++] = (uint8_t)((size - 1) >> (8 * b));
+        memcpy(out + o, data + sp->slice_data_offset[i], size);
+        o += size;
+    }
+    return o;
+}
+
+static CMVideoFormatDescriptionRef av1_format(const struct virgl_video_codec *c, const struct virgl_av1_picture_desc *d,
+                                              unsigned level)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    uint8_t av1c[4 + sizeof(c->av1_seq)];
+    av1c[0] = 0x81; /* marker, version 1 */
+    av1c[1] = (uint8_t)(p->profile << 5 | level);
+    av1c[2] = (uint8_t)((p->bit_depth_idx > 0) << 6 | p->seq_info_fields.mono_chrome << 4 | 1 << 3 | 1 << 2);
+    av1c[3] = 0;
+    memcpy(av1c + 4, c->av1_seq, c->av1_seq_len);
+    CFDataRef data = CFDataCreate(NULL, av1c, (CFIndex)(4 + c->av1_seq_len));
+    CFMutableDictionaryRef atoms = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                             &kCFTypeDictionaryValueCallBacks);
+    CFMutableDictionaryRef ext = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                           &kCFTypeDictionaryValueCallBacks);
+    CMVideoFormatDescriptionRef fmt = NULL;
+
+    CFDictionarySetValue(atoms, CFSTR("av1C"), data);
+    CFDictionarySetValue(ext, kCMFormatDescriptionExtension_SampleDescriptionExtensionAtoms, atoms);
+    OSStatus st = CMVideoFormatDescriptionCreate(NULL, kCMVideoCodecType_AV1, p->max_width, p->max_height, ext, &fmt);
+    CFRelease(ext);
+    CFRelease(atoms);
+    CFRelease(data);
+    if (st != noErr) {
+        virgl_error("vt: no AV1 format description (%d)\n", (int)st);
+        return NULL;
+    }
+    return fmt;
+}
+
+static int av1_take(struct virgl_video_codec *c, const struct virgl_av1_picture_desc *d, unsigned num_buffers,
+                    const void *const *buffers, const unsigned *sizes)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    unsigned type = p->pic_info_fields.frame_type;
+
+    if (p->profile != 0 || p->bit_depth_idx > 1 || !p->frame_width || !p->frame_height ||
+        p->frame_width > p->max_width || p->frame_height > p->max_height || p->max_width > 4096 ||
+        p->max_height > 4096 || type == AV1_SWITCH || p->pic_info_fields.large_scale_tile || p->cdef_bits > 3 ||
+        p->order_hint_bits_minus_1 > 7 ||
+        (p->pic_info_fields.use_superres && (p->superres_scale_denominator < 9 || p->superres_scale_denominator > 16)) ||
+        (!(type == AV1_KEY || type == AV1_INTRA_ONLY) && !p->pic_info_fields.error_resilient_mode &&
+         p->primary_ref_frame > AV1_NONE)) {
+        virgl_warn("vt: AV1 frame refused (profile %u, depth %u, %ux%u of %ux%u, type %u)\n", p->profile,
+                   p->bit_depth_idx, p->frame_width, p->frame_height, p->max_width, p->max_height, type);
+        return -1;
+    }
+    /* VA-API puts the grain into film_grain_target, which this back end does not write */
+    if (p->seq_info_fields.film_grain_params_present && p->film_grain_info.film_grain_info_fields.apply_grain) {
+        virgl_warn("vt: AV1 film grain is not supported\n");
+        return -1;
+    }
+    if (au_take_raw(c, num_buffers, buffers, sizes))
+        return -1;
+    memcpy(c->av1, d, sizeof(*d));
+    c->pic_idr = type == AV1_KEY && p->pic_info_fields.show_frame;
+    c->pic_intra = false; /* only a shown key frame resets every reference */
+    c->pic_shown = p->pic_info_fields.show_frame || type != AV1_KEY;
+    c->have_desc = true;
+    c->pic_slices = 1;
+    return 0;
+}
+
+static void av1_store(struct virgl_video_codec *c, const struct virgl_av1_picture_desc *d, const uint8_t vt_idx[7],
+                      uint8_t refresh, uint32_t surf)
+{
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    unsigned type = p->pic_info_fields.frame_type;
+    bool intra = type == AV1_KEY || type == AV1_INTRA_ONLY;
+    unsigned prim = intra || p->pic_info_fields.error_resilient_mode ? AV1_NONE : p->primary_ref_frame;
+    struct av1_slot s;
+
+    memset(&s, 0, sizeof(s));
+    s.surf = surf;
+    s.order_hint = p->order_hint;
+    av1_seg(d, prim != AV1_NONE ? &c->av1_slots[vt_idx[prim]] : NULL, &s);
+    av1_default_gm(s.gm);
+    for (unsigned r = 0; !intra && r < 7; r++) {
+        unsigned gt = p->wm[r].wmtype & 3;
+        const int32_t *m = p->wm[r].wmmat;
+        if (gt)
+            for (unsigned i = 0; i < 6; i++)
+                s.gm[r][i] = m[i];
+        if (gt && gt < 3)
+            s.gm[r][4] = -m[3], s.gm[r][5] = m[2];
+        if (gt == 1)
+            s.gm[r][2] = 1 << 16, s.gm[r][3] = 0, s.gm[r][4] = 0, s.gm[r][5] = 1 << 16;
+    }
+    /* the surface's older content is gone */
+    for (unsigned i = 0; i < 8; i++)
+        if (c->av1_slots[i].surf == surf)
+            c->av1_slots[i].surf = 0;
+    for (unsigned i = 0; i < 8; i++)
+        if (refresh >> i & 1)
+            c->av1_slots[i] = s;
+}
+
+static bool av1_held(const struct virgl_av1_picture_desc *d, uint32_t surf)
+{
+    for (unsigned i = 0; i < 8; i++)
+        if (surf && d->ref[i] == surf)
+            return true;
+    return false;
+}
+
+/* A slot that no later frame can need: empty, a surface the guest no longer holds, or a second copy */
+static int av1_free_slot(const struct virgl_video_codec *c, const struct virgl_av1_picture_desc *d)
+{
+    for (unsigned i = 0; i < 8; i++)
+        if (!c->av1_slots[i].surf || !av1_held(d, c->av1_slots[i].surf))
+            return (int)i;
+    for (unsigned i = 1; i < 8; i++)
+        for (unsigned k = 0; k < i; k++)
+            if (c->av1_slots[k].surf == c->av1_slots[i].surf)
+                return (int)i;
+    return -1;
+}
+
+static int av1_decode(struct virgl_video_codec *c)
+{
+    const struct virgl_av1_picture_desc *d = c->av1;
+    const __typeof__(d->picture_parameter) *p = &d->picture_parameter;
+    unsigned type = p->pic_info_fields.frame_type, level;
+    bool intra = type == AV1_KEY || type == AV1_INTRA_ONLY, key_shown = type == AV1_KEY && p->pic_info_fields.show_frame;
+    uint8_t vt_idx[7] = {0}, refresh, seq[sizeof(c->av1_seq)];
+    uint32_t surf = c->target->id;
+    size_t len;
+
+    if (!c->have_desc || !c->au_len)
+        return -1;
+    if (c->vt && c->pixfmt != vt_pixfmt(c->target->format)) {
+        virgl_warn("vt: the target format changed, new session\n");
+        vt_release_session(c);
+    }
+    c->pixfmt = vt_pixfmt(c->target->format);
+    if ((p->bit_depth_idx == 1) != (c->pixfmt == kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange)) {
+        virgl_warn("vt: AV1 at %u bits into a %s target\n", p->bit_depth_idx ? 10 : 8, p->bit_depth_idx ? "8-bit" : "P010");
+        return -1;
+    }
+
+    /* the frame that had no slot: the guest's slots now show whether it is a reference */
+    if (c->pend_surf && !key_shown && av1_held(d, c->pend_surf)) {
+        int j = av1_free_slot(c, d);
+        size_t n = j < 0 ? 0 : av1_build(c, c->av1_pend, c->pend_au, c->pend_len, c->pend_idx, (uint8_t)(1u << j), false);
+        c->no_emit = true;
+        int rc = n ? vt_decode(c, c->sample, n, false) : -1;
+        c->no_emit = false;
+        if (rc) {
+            virgl_warn("vt: an AV1 reference could not be stored again\n");
+            c->pend_surf = 0;
+            return -1;
+        }
+        av1_store(c, c->av1_pend, c->pend_idx, (uint8_t)(1u << j), c->pend_surf);
+        c->redecodes++;
+    }
+    c->pend_surf = 0;
+
+    len = av1_write_seq(d, seq, sizeof(seq), &level);
+    if (!len)
+        return -1;
+    bool new_seq = len != c->av1_seq_len || memcmp(seq, c->av1_seq, len);
+    if (new_seq || !c->vt || !c->fmt) {
+        memcpy(c->av1_seq, seq, len);
+        c->av1_seq_len = len;
+        CMVideoFormatDescriptionRef fmt = av1_format(c, d, level);
+        if (!fmt)
+            return -1;
+        if (c->vt)
+            c->ps_updates++;
+        if (vt_set_format(c, fmt))
+            return -1;
+        new_seq = true;
+    }
+
+
+    if (!intra)
+        for (unsigned i = 0; i < 7; i++) {
+            uint32_t want = d->ref[p->ref_frame_idx[i] & 7];
+            int j = -1;
+            for (unsigned k = 0; want && k < 8 && j < 0; k++)
+                if (c->av1_slots[k].surf == want)
+                    j = (int)k;
+            if (j < 0) {
+                virgl_warn("vt: an AV1 reference is not in a VideoToolbox slot\n");
+                return -1;
+            }
+            vt_idx[i] = (uint8_t)j;
+        }
+    if (key_shown) {
+        refresh = 0xff;
+    } else {
+        int j = av1_free_slot(c, d);
+        refresh = j < 0 ? 0 : (uint8_t)(1u << j);
+    }
+    len = av1_build(c, d, c->au, c->au_len, vt_idx, refresh, key_shown || new_seq);
+    if (!len || vt_decode(c, c->sample, len, c->pic_shown))
+        return -1;
+    av1_store(c, d, vt_idx, refresh, surf);
+    if (!refresh) {
+        /* every slot is held: keep the frame until the next one shows which slot the guest freed */
+        uint8_t *a = c->pend_au;
+        size_t cap = c->pend_cap;
+        c->pend_au = c->au, c->pend_cap = c->au_cap, c->pend_len = c->au_len;
+        c->au = a, c->au_cap = cap, c->au_len = 0;
+        memcpy(c->av1_pend, d, sizeof(*d));
+        memcpy(c->pend_idx, vt_idx, sizeof(vt_idx));
+        c->pend_surf = surf;
+    }
+    return 0;
+}
+
+/* The guest sees no decode error: on one, the target keeps its old pixels until the next intra picture */
+static int vt_end_frame(struct virgl_video_codec *c)
+{
+    int rc;
+
+    if (c->need_intra && !c->pic_idr && !(c->pic_slices && c->pic_intra)) {
+        c->skipped++;
+        return -1;
+    }
+    if (c->need_intra)
+        virgl_info("vt: decoding again at frame %u, %u skipped so far\n", c->frames, c->skipped);
+    c->need_intra = false;
+    rc = c->kind == VT_AV1 ? av1_decode(c) : c->kind == VT_VP9 ? vp9_decode(c) : h264_decode(c);
+    if (rc)
+        c->pend_surf = 0;
+    if (rc) {
+        c->failed++;
+        c->need_intra = true;
+        virgl_warn("vt: a picture failed, skipping to the next intra picture\n");
+    } else {
+        c->frames++;
+    }
+    if (c->au_cap > VT_AU_KEEP) {
+        free(c->au);
+        c->au = NULL;
+        c->au_cap = 0;
+    }
+    if (c->sample_cap > VT_AU_KEEP) {
+        free(c->sample);
+        c->sample = NULL;
+        c->sample_cap = 0;
+    }
+    return rc;
+}
+
+/* ---- virgl_video.h ---- */
+
+static bool vp9_present, av1_present;
+
+int virgl_video_init(int drm_fd, struct virgl_video_callbacks *cbs, unsigned int flags)
+{
+    (void)drm_fd, (void)flags;
+    callbacks = cbs;
+    /* VP9 is a supplemental decoder: it needs this opt-in first */
+    if (__builtin_available(macOS 11.0, iOS 26.2, *))
+        VTRegisterSupplementalVideoDecoderIfAvailable(kCMVideoCodecType_VP9);
+    vp9_present = VTIsHardwareDecodeSupported(kCMVideoCodecType_VP9);
+    av1_present = VTIsHardwareDecodeSupported(kCMVideoCodecType_AV1);
+    virgl_info("vt: video decode on VideoToolbox, hardware decoders: H.264 %s, VP9 %s, AV1 %s\n",
+               VTIsHardwareDecodeSupported(kCMVideoCodecType_H264) ? "present" : "absent",
+               vp9_present ? "present" : "absent", av1_present ? "present" : "absent");
+    return 0;
+}
+
+void virgl_video_destroy(void)
+{
+    callbacks = NULL;
+}
+
+static void add_cap(union virgl_caps *caps, enum pipe_video_profile profile, unsigned level, unsigned format)
+{
+    struct virgl_video_caps *v = &caps->v2.video_caps[caps->v2.num_video_caps++];
+    memset(v, 0, sizeof(*v));
+    v->profile = profile;
+    v->entrypoint = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+    v->max_level = level;
+    v->max_width = 4096;
+    v->max_height = 4096;
+    v->prefered_format = format;
+    v->max_macroblocks = 0xffff;
+    v->npot_texture = 1;
+    v->supports_progressive = 1;
+}
+
+int virgl_video_fill_caps(union virgl_caps *caps)
+{
+    if (!caps)
+        return -1;
+    caps->v2.num_video_caps = 0;
+    /* no init: the embedder did not ask for video */
+    if (!callbacks)
+        return 0;
+    if (VTIsHardwareDecodeSupported(kCMVideoCodecType_H264)) {
+        add_cap(caps, PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE, 52, VT_VIRGL_FORMAT_NV12);
+        add_cap(caps, PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN, 52, VT_VIRGL_FORMAT_NV12);
+        add_cap(caps, PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH, 52, VT_VIRGL_FORMAT_NV12);
+    }
+    if (vp9_present) {
+        add_cap(caps, PIPE_VIDEO_PROFILE_VP9_PROFILE0, 62, VT_VIRGL_FORMAT_NV12);
+        add_cap(caps, PIPE_VIDEO_PROFILE_VP9_PROFILE2, 62, VT_VIRGL_FORMAT_P010);
+    }
+    if (av1_present)
+        add_cap(caps, PIPE_VIDEO_PROFILE_AV1_MAIN, 23, VT_VIRGL_FORMAT_NV12);
+    return 0;
+}
+
+struct virgl_video_codec *virgl_video_create_codec(const struct virgl_video_create_codec_args *args)
+{
+    struct virgl_video_codec *c;
+
+    if (!args || args->entrypoint != PIPE_VIDEO_ENTRYPOINT_BITSTREAM || !(is_h264(args->profile) || is_vp9(args->profile) || is_av1(args->profile)) ||
+        !args->width || !args->height || args->width > 4096 || args->height > 4096) {
+        virgl_warn("vt: codec refused (profile %d, entrypoint %d, %ux%u)\n", args ? (int)args->profile : -1,
+                   args ? (int)args->entrypoint : -1, args ? args->width : 0, args ? args->height : 0);
+        return NULL;
+    }
+    if (!callbacks)
+        return NULL;
+    c = calloc(1, sizeof(*c));
+    if (!c)
+        return NULL;
+    c->profile = args->profile;
+    c->entrypoint = args->entrypoint;
+    c->level = args->level;
+    c->width = args->width;
+    c->height = args->height;
+    c->opaque = args->opaque;
+    c->pps_id = -1;
+    c->kind = is_av1(args->profile) ? VT_AV1 : is_vp9(args->profile) ? VT_VP9 : VT_H264;
+    if (c->kind == VT_AV1) {
+        c->av1 = calloc(1, sizeof(*c->av1));
+        c->av1_pend = calloc(1, sizeof(*c->av1_pend));
+        if (!c->av1 || !c->av1_pend) {
+            free(c->av1);
+            free(c->av1_pend);
+            free(c);
+            return NULL;
+        }
+    }
+    c->vp9_profile = args->profile == PIPE_VIDEO_PROFILE_VP9_PROFILE2 ? 2 : 0;
+    return c;
+}
+
+void virgl_video_destroy_codec(struct virgl_video_codec *codec)
+{
+    if (!codec)
+        return;
+    if (codec->frames || codec->failed || codec->skipped)
+        virgl_info("vt: %s codec %ux%u done: %u frames decoded, %u failed, %u skipped, %u sessions, "
+                   "%u parameter set updates, at most %u slices per decode call, %u decoded again\n",
+                   vt_name(codec), codec->width, codec->height, codec->frames, codec->failed, codec->skipped,
+                   codec->sessions, codec->ps_updates, codec->max_slices_per_call, codec->redecodes);
+    vt_release_session(codec);
+    if (codec->out)
+        CVPixelBufferRelease(codec->out);
+    if (codec->fmt)
+        CFRelease(codec->fmt);
+    for (unsigned i = 0; i < VT_MAX_PPS; i++)
+        free(codec->pps[i].nal);
+    free(codec->au);
+    free(codec->pend_au);
+    free(codec->sample);
+    free(codec->av1);
+    free(codec->av1_pend);
+    free(codec);
+}
+
+enum pipe_video_profile virgl_video_codec_profile(const struct virgl_video_codec *codec)
+{
+    return codec ? codec->profile : PIPE_VIDEO_PROFILE_UNKNOWN;
+}
+
+void *virgl_video_codec_opaque_data(struct virgl_video_codec *codec)
+{
+    return codec ? codec->opaque : NULL;
+}
+
+struct virgl_video_buffer *virgl_video_create_buffer(const struct virgl_video_create_buffer_args *args)
+{
+    struct virgl_video_buffer *b;
+
+    /* any format: players probe surface formats, and the guest's video processing draws with GL */
+    if (!args)
+        return NULL;
+    b = calloc(1, sizeof(*b));
+    if (!b)
+        return NULL;
+    b->format = args->format;
+    b->width = args->width;
+    b->height = args->height;
+    b->opaque = args->opaque;
+    b->id = next_buffer_id++;
+    return b;
+}
+
+void virgl_video_destroy_buffer(struct virgl_video_buffer *buffer)
+{
+    free(buffer);
+}
+
+uint32_t virgl_video_buffer_id(const struct virgl_video_buffer *buffer)
+{
+    return buffer ? buffer->id : 0;
+}
+
+void *virgl_video_buffer_opaque_data(struct virgl_video_buffer *buffer)
+{
+    return buffer ? buffer->opaque : NULL;
+}
+
+static void vt_reset_picture(struct virgl_video_codec *c)
+{
+    c->au_len = 0;
+    c->have_desc = false;
+    c->pps_id = -1;
+    c->pps_mixed = false;
+    c->pic_idr = false;
+    c->pic_intra = true;
+    c->pic_slices = 0;
+    c->last.valid = false;
+}
+
+static bool decode_target(enum pipe_format f)
+{
+    return f == PIPE_FORMAT_NV12 || f == PIPE_FORMAT_IYUV || f == PIPE_FORMAT_YV12 || f == PIPE_FORMAT_P010;
+}
+
+int virgl_video_begin_frame(struct virgl_video_codec *codec, struct virgl_video_buffer *target)
+{
+    if (!codec || !target)
+        return -1;
+    if (!decode_target(target->format)) {
+        virgl_warn("vt: decode target format %d refused, only NV12, IYUV, YV12 and P010\n", (int)target->format);
+        codec->target = NULL;
+        return -1;
+    }
+    codec->target = target;
+    vt_reset_picture(codec);
+    return 0;
+}
+
+int virgl_video_decode_bitstream(struct virgl_video_codec *codec, struct virgl_video_buffer *target,
+                                 const union virgl_picture_desc *desc, unsigned num_buffers,
+                                 const void *const *buffers, const unsigned *sizes)
+{
+    if (!codec || !target || !desc || !num_buffers || !buffers || !sizes)
+        return -1;
+    if (desc->base.profile != codec->profile || target != codec->target) {
+        virgl_error("vt: decode does not match the codec or the frame\n");
+        return -1;
+    }
+    if (codec->kind == VT_VP9)
+        return vp9_take(codec, &desc->vp9, num_buffers, buffers, sizes);
+    if (codec->kind == VT_AV1)
+        return av1_take(codec, &desc->av1, num_buffers, buffers, sizes);
+    unsigned before = codec->pic_slices;
+    memcpy(&codec->desc, &desc->h264, sizeof(codec->desc));
+    codec->have_desc = true;
+    codec->last.valid = false;
+    for (unsigned i = 0; i < num_buffers; i++)
+        if (buffers[i] && h264_take_annexb(codec, &codec->desc, buffers[i], sizes[i]))
+            return -1;
+    if (codec->pic_slices - before > codec->max_slices_per_call)
+        codec->max_slices_per_call = codec->pic_slices - before;
+    /* The descriptor's active counts belong to the call's last slice; without an override they are the PPS defaults.
+       Earlier slices of the call may have other counts, so only this one teaches. */
+    struct vt_slice *l = &codec->last;
+    if (l->valid && !l->override && (l->type == 0 || l->type == 1 || l->type == 3))
+        codec->pps[l->pps_id].l0 = codec->desc.num_ref_idx_l0_active_minus1;
+    if (l->valid && !l->override && l->type == 1)
+        codec->pps[l->pps_id].l1 = codec->desc.num_ref_idx_l1_active_minus1;
+    return 0;
+}
+
+int virgl_video_encode_bitstream(struct virgl_video_codec *codec, struct virgl_video_buffer *source,
+                                 const union virgl_picture_desc *desc)
+{
+    (void)codec, (void)source, (void)desc;
+    return -1;
+}
+
+int virgl_video_end_frame(struct virgl_video_codec *codec, struct virgl_video_buffer *target)
+{
+    int rc;
+
+    if (!codec || !target || target != codec->target)
+        return -1;
+    rc = vt_end_frame(codec);
+    vt_reset_picture(codec);
+    return rc;
+}
