+
+static enum virgl_formats vt_plane_format(const struct virgl_video_dma_buf_plane *p)
+{
+    if (p->channels == 1 && p->cpp == 1)
+        return VIRGL_FORMAT_R8_UNORM;
+    if (p->channels == 2 && p->cpp == 2)
+        return VIRGL_FORMAT_R8G8_UNORM;
+    if (p->channels == 1 && p->cpp == 2)
+        return VIRGL_FORMAT_R16_UNORM;
+    if (p->channels == 2 && p->cpp == 4)
+        return VIRGL_FORMAT_R16G16_UNORM;
+    return VIRGL_FORMAT_NONE;
+}
+
+/* The plane resources are the guest's: only a 2D texture of the plane's format takes a copy, inside both sizes */
+static struct vrend_resource *vt_plane_res(struct vrend_video_buffer *buf, unsigned i,
+                                           const struct virgl_video_dma_buf_plane *p, uint32_t *w, uint32_t *h)
+{
+    static bool warned;
+    enum virgl_formats want = vt_plane_format(p);
+    struct vrend_resource *res = vrend_renderer_ctx_res_lookup(buf->ctx->ctx, buf->planes[i].res_handle);
+
+    if (!res) {
+        virgl_error("%s: res %d not found\n", __func__, buf->planes[i].res_handle);
+        return NULL;
+    }
+    if (want == VIRGL_FORMAT_NONE || res->target != GL_TEXTURE_2D || !(res->storage_bits & VREND_STORAGE_GL_TEXTURE) ||
+        !res->gl_id || res->base.format != want || !vrend_get_format_table_entry(res->base.format) ||
+        util_format_get_blocksize(res->base.format) != p->cpp) {
+        if (!warned)
+            virgl_warn("%s: plane %u: resource %d (format %d, target 0x%x) does not fit a %u-byte, %u-channel plane\n",
+                       __func__, i, buf->planes[i].res_handle, res->base.format, res->target, p->cpp, p->channels);
+        warned = true;
+        return NULL;
+    }
+    *w = MIN2(res->base.width0, p->width);
+    *h = MIN2(res->base.height0, p->height);
+    return *w && *h ? res : NULL;
+}
+
+/* Fallback when ANGLE cannot bind the planes */
+static int vt_cpu_copy(struct vrend_video_buffer *buf, const struct virgl_video_dma_buf *d)
+{
+    IOSurfaceRef surf = d->iosurface;
+    GLint align, row_length, unpack_buf, tex2d;
+
+    if (IOSurfaceLock(surf, kIOSurfaceLockReadOnly, NULL))
+        return -1;
+    glGetIntegerv(GL_UNPACK_ALIGNMENT, &align);
+    glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+    glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buf);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &tex2d);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+
+    for (unsigned i = 0; i < d->num_planes && i < buf->num_planes; i++) {
+        const struct virgl_video_dma_buf_plane *p = &d->planes[i];
+        const struct vrend_format_table *tf;
+        struct vrend_resource *res;
+        uint32_t w, h;
+        const void *data;
+
+        res = vt_plane_res(buf, i, p, &w, &h);
+        if (!res || p->plane >= IOSurfaceGetPlaneCount(surf))
+            continue;
+        data = IOSurfaceGetBaseAddressOfPlane(surf, p->plane);
+        tf = vrend_get_format_table_entry(res->base.format);
+        /* GL reads h-1 strides plus one row: both inside the plane */
+        if (!data || p->pitch % p->cpp || p->pitch < w * p->cpp ||
+            p->pitch > IOSurfaceGetBytesPerRowOfPlane(surf, p->plane) || h > IOSurfaceGetHeightOfPlane(surf, p->plane))
+            continue;
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, p->pitch / p->cpp);
+        glBindTexture(GL_TEXTURE_2D, res->gl_id);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h, tf->glformat, tf->gltype, data);
+    }
+
+    glBindTexture(GL_TEXTURE_2D, tex2d);
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, row_length);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, align);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack_buf);
+    IOSurfaceUnlock(surf, kIOSurfaceLockReadOnly, NULL);
+    return 0;
+}
+
+/* True when the surface's last copy is done (or wait_ns passed) */
+static bool vt_surf_retire(struct vrend_video_surf *s, GLuint64 wait_ns)
+{
+    if (!s->fence)
+        return true;
+    GLenum r = glClientWaitSync(s->fence, 0, wait_ns);
+    if (r == GL_TIMEOUT_EXPIRED && !wait_ns)
+        return false;
+    if (r == GL_TIMEOUT_EXPIRED || r == GL_WAIT_FAILED)
+        virgl_warn("vrend video: a GPU plane copy did not finish (0x%x)\n", r);
+    glDeleteSync(s->fence);
+    s->fence = NULL;
+    IOSurfaceDecrementUseCount(s->iosurface);
+    return true;
+}
+
+static void vt_surf_drop(struct vrend_video_surf *s)
+{
+    if (!s->iosurface)
+        return;
+    vt_surf_retire(s, 1000000000ull);
+    for (unsigned i = 0; i < 3; i++)
+        if (s->pb[i] != EGL_NO_SURFACE)
+            eglDestroySurface(s->dpy, s->pb[i]);
+    CFRelease(s->iosurface);
+    memset(s, 0, sizeof(*s));
+}
+
+/* A free slot first, then the least recently used idle one, then the least recently used */
+static int vt_surf_rank(const struct vrend_video_surf *s)
+{
+    return !s->iosurface ? 0 : !s->fence ? 1 : 2;
+}
+
+static struct vrend_video_surf *vt_surf_get(struct vrend_video_codec *cdc, IOSurfaceRef surf, EGLDisplay dpy)
+{
+    struct vrend_video_surf *s, *pick = NULL;
+
+    for (unsigned i = 0; i < VREND_VIDEO_MAX_SURFS; i++) {
+        s = &cdc->surfs[i];
+        if (s->iosurface == surf && s->dpy == dpy) {
+            s->used = ++cdc->clock;
+            return s;
+        }
+        if (s->iosurface)
+            vt_surf_retire(s, 0);
+        if (!pick || vt_surf_rank(s) < vt_surf_rank(pick) ||
+            (vt_surf_rank(s) == vt_surf_rank(pick) && s->used < pick->used))
+            pick = s;
+    }
+    vt_surf_drop(pick);
+    pick->iosurface = (IOSurfaceRef)CFRetain(surf);
+    pick->dpy = dpy;
+    pick->used = ++cdc->clock;
+    cdc->num_surfs++;
+    return pick;
+}
+
+static bool vt_pb_config(EGLDisplay dpy, EGLConfig *cfg, EGLint *bind_target)
+{
+    static EGLDisplay cfg_dpy = EGL_NO_DISPLAY;
+    static EGLConfig cfg_cfg;
+    static EGLint cfg_target;
+    EGLint ca[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT, EGL_SURFACE_TYPE, EGL_PBUFFER_BIT, EGL_RED_SIZE, 8,
+                   EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8, EGL_BIND_TO_TEXTURE_RGBA, EGL_TRUE, EGL_NONE};
+    EGLint n = 0;
+
+    if (dpy == EGL_NO_DISPLAY)
+        return false;
+    if (dpy != cfg_dpy) {
+        if (!eglChooseConfig(dpy, ca, &cfg_cfg, 1, &n) || n < 1)
+            return false;
+        if (!eglGetConfigAttrib(dpy, cfg_cfg, EGL_BIND_TO_TEXTURE_TARGET_ANGLE, &cfg_target) ||
+            cfg_target != EGL_TEXTURE_RECTANGLE_ANGLE)
+            cfg_target = EGL_TEXTURE_2D;
+        cfg_dpy = dpy;
+    }
+    *cfg = cfg_cfg;
+    *bind_target = cfg_target;
+    return true;
+}
+
+/* Each plane of the IOSurface as a pbuffer, bound to a texture, copied on the GPU into the guest's plane texture */
+static int vt_gpu_copy(struct vrend_video_codec *cdc, struct vrend_video_buffer *buf, const struct virgl_video_dma_buf *d)
+{
+    EGLDisplay dpy = eglGetCurrentDisplay();
+    EGLConfig cfg;
+    EGLint bind_target;
+    GLenum target;
+    GLint read_fb, tex2d, texrect = 0;
+    GLuint tex, fb;
+    struct vrend_video_surf *s;
+    int rc = 0;
+
+    if (!vt_pb_config(dpy, &cfg, &bind_target))
+        return -1;
+    target = bind_target == EGL_TEXTURE_RECTANGLE_ANGLE ? GL_TEXTURE_RECTANGLE_ANGLE : GL_TEXTURE_2D;
+    s = vt_surf_get(cdc, d->iosurface, dpy);
+    vt_surf_retire(s, 1000000000ull); /* the pool skips surfaces in use, so this does not wait */
+
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fb);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &tex2d);
+    if (target != GL_TEXTURE_2D)
+        glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE_ANGLE, &texrect);
+    glGenTextures(1, &tex);
+    glGenFramebuffers(1, &fb);
+
+    for (unsigned i = 0; i < d->num_planes && i < buf->num_planes && !rc; i++) {
+        const struct virgl_video_dma_buf_plane *p = &d->planes[i];
+        bool deep = p->cpp == 2 * p->channels;
+        struct vrend_resource *res;
+        uint32_t w, h;
+
+        res = vt_plane_res(buf, i, p, &w, &h);
+        if (!res || p->plane >= 3)
+            continue;
+        if (s->pb[p->plane] == EGL_NO_SURFACE) {
+            EGLint sa[] = {EGL_WIDTH, (EGLint)p->width, EGL_HEIGHT, (EGLint)p->height,
+                           EGL_IOSURFACE_PLANE_ANGLE, (EGLint)p->plane, EGL_TEXTURE_TARGET, bind_target,
+                           EGL_TEXTURE_INTERNAL_FORMAT_ANGLE, p->channels == 2 ? GL_RG : GL_RED,
+                           EGL_TEXTURE_FORMAT, EGL_TEXTURE_RGBA,
+                           EGL_TEXTURE_TYPE_ANGLE, deep ? GL_UNSIGNED_SHORT : GL_UNSIGNED_BYTE, EGL_NONE};
+            s->pb[p->plane] = eglCreatePbufferFromClientBuffer(dpy, EGL_IOSURFACE_ANGLE, (EGLClientBuffer)s->iosurface,
+                                                               cfg, sa);
+            if (s->pb[p->plane] == EGL_NO_SURFACE) {
+                virgl_warn("vrend video: IOSurface plane %u pbuffer failed (0x%x)\n", p->plane, eglGetError());
+                rc = -1;
+                break;
+            }
+        }
+        glBindTexture(target, tex);
+        if (!eglBindTexImage(dpy, s->pb[p->plane], EGL_BACK_BUFFER)) {
+            virgl_warn("vrend video: eglBindTexImage failed (0x%x)\n", eglGetError());
+            rc = -1;
+            break;
+        }
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, fb);
+        glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, target, tex, 0);
+        if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+            glBindTexture(GL_TEXTURE_2D, res->gl_id);
+            glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, w, h);
+        } else {
+            virgl_warn("vrend video: IOSurface plane %u is not a complete framebuffer\n", p->plane);
+            rc = -1;
+        }
+        glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, target, 0, 0);
+        glBindTexture(target, tex);
+        eglReleaseTexImage(dpy, s->pb[p->plane], EGL_BACK_BUFFER);
+    }
+
+    glDeleteFramebuffers(1, &fb);
+    glDeleteTextures(1, &tex);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fb);
