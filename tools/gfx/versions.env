# Pins for tools/gfx/build-deps.sh. Sourced by sh, so keep it plain KEY=value.
# Start point: UTM v5.0.8 (17/10/2026). patches/sources and scripts/build_dependencies.sh in that tag.

# ANGLE. UTM builds the copy inside its WebKit fork (utmapp/WebKit ed78ab6e, Source/ThirdParty/ANGLE).
# That copy is upstream ANGLE 40dfb3a8bd of 15/02/2024 plus patches. We build the same upstream commit
# from Chromium's repo with gn. UTM's extra patches are not applied.
ANGLE_REPO=https://chromium.googlesource.com/angle/angle.git
ANGLE_COMMIT=40dfb3a8bd6514b613ce693962c6d8dcd70ab25a

# depot_tools gives gclient and gn. HEAD of main when this was pinned (12/11/2026).
DEPOT_TOOLS_REPO=https://chromium.googlesource.com/chromium/tools/depot_tools.git
DEPOT_TOOLS_COMMIT=1afcf0756e47f3a6ee82d7736b9fcda2d57b268e

# UTM's forks carry the Apple fixes. Same commits as UTM v5.0.8.
LIBEPOXY_REPO=https://github.com/utmapp/libepoxy.git
LIBEPOXY_COMMIT=bf98587477fe68d07b93319ece7b40a7d0e2eabe
VIRGLRENDERER_REPO=https://github.com/utmapp/virglrenderer.git
VIRGLRENDERER_COMMIT=451505ad0aa449290f2c0672da6877d57ee770e5

# Same as the Makefile: IOS_CC and the macOS CFLAGS. The cross-*.ini files repeat these.
IOS_MIN=17.0
MACOS_MIN=15.2

# Python build tools, installed with uv into $GFX_WORK/venv.
PY_TOOLS="meson==1.12.1 ninja==1.13.2 pyyaml==6.0.3 mako==1.4.3"
