<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- For a paid Apple Developer Program team (development profile, valid one year), selected with
     TUX_ENTITLEMENTS=Tuxedo/Tuxedo.developer.entitlements. A paid team can sign extended virtual
     addressing. It cannot sign dynamic-codesigning, so JIT still needs an attached debugger
     (get-task-allow). Their reasons live in Tuxedo.entitlements. -->
<dict>
	<key>get-task-allow</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
